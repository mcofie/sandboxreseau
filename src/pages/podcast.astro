---
import Layout from '../layouts/Layout.astro';
import PodcastGrid from '../components/PodcastGrid.astro';
import { fetchPodcastEpisodes } from '../lib/podcast';

const episodes = await fetchPodcastEpisodes();
const platforms = [
    { name: 'Spotify', href: 'https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN' },
    { name: 'Apple Podcasts', href: 'https://podcasts.apple.com/gh/podcast/the-reverb/id1884282478' },
    { name: 'Substack', href: 'https://thekompound.substack.com' },
    { name: 'RSS', href: 'https://api.substack.com/feed/podcast/7581260.rss' },
];
---

<Layout
    title="The Reverb Podcast | Sandbox Réseau"
    description="The high-bandwidth audio-log for the African builder. Listen to the latest dispatches from the Sandbox Réseau ecosystem."
>
    <main class="podcast-page">
        <section class="reverb-hero" aria-labelledby="reverb-title">
            <div class="reverb-hero-card">
                <div class="reverb-hero-copy">
                    <span class="reverb-pill"><span class="reverb-dot" aria-hidden="true"></span>Podcast · {episodes.length} episodes</span>
                    <h1 id="reverb-title">The Reverb.</h1>
                    <p>A fast-paced tech podcast capturing real conversations from the Sandbox Réseau community. No fillers. Just what people are building, thinking, and learning right now.</p>
                    <div class="reverb-actions">
                        {episodes.length > 0 && (
                            <button type="button" class="reverb-play" data-play-latest>
                                <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M4.5 3.2v9.6L12.5 8z" /></svg>
                                Play latest episode
                            </button>
                        )}
                        <div class="reverb-platforms">
                            {platforms.map((platform) => (
                                <a href={platform.href} target="_blank" rel="noreferrer">{platform.name}</a>
                            ))}
                        </div>
                    </div>
                </div>
                <div class="reverb-cover">
                    <img src="/assets/img/podcast-logo.webp" alt="The Reverb podcast cover" width="800" height="800" fetchpriority="high" decoding="async" />
                </div>
            </div>
        </section>

        <section class="reverb-archive" aria-labelledby="reverb-archive-title">
            <div class="reverb-archive-head">
                <h2 id="reverb-archive-title">All episodes.</h2>
                <p>Newest first · {episodes.length} episodes</p>
            </div>
            {episodes.length > 0 ? (
                <PodcastGrid episodes={episodes} pageSize={9} />
            ) : (
                <p class="reverb-empty">No episodes available yet. Please check back soon.</p>
            )}
        </section>
    </main>
</Layout>

<script>
    // The newest episode is the first card; reuse its play handling.
    document.addEventListener('click', (event) => {
        if (!(event.target as Element).closest('[data-play-latest]')) return;
        document.querySelector<HTMLElement>('.podcast-card')?.click();
    });
</script>

<style>
    .podcast-page{font-family:Inter,system-ui,sans-serif;color:#0a0a0a}
    .reverb-hero{max-width:1040px;margin:0 auto;padding:120px 32px 0}
    .reverb-hero-card{display:grid;grid-template-columns:1.3fr .7fr;align-items:center;gap:48px;padding:56px;border-radius:28px;background:#f5f5f5}
    .reverb-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid rgba(10,10,10,.1);border-radius:999px;background:#fff;color:#6b6b6b;font-size:13px;font-weight:500}
    .reverb-dot{width:7px;height:7px;border-radius:50%;background:#8fbf24}
    .reverb-hero h1{margin:24px 0 0;font-size:clamp(2.5rem,1.6rem + 3vw,4rem);font-weight:600;line-height:1.02;letter-spacing:-.03em;color:#0a0a0a}
    .reverb-hero-copy>p{max-width:44ch;margin:20px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .reverb-actions{display:flex;flex-wrap:wrap;align-items:center;gap:16px;margin-top:32px}
    .reverb-play{display:inline-flex;align-items:center;gap:10px;height:48px;padding:0 24px;border:0;border-radius:999px;background:#0a0a0a;color:#fff;font:inherit;font-size:16px;font-weight:600;cursor:pointer;transition:background-color .2s,transform .2s}
    .reverb-play:hover{background:rgba(10,10,10,.9)}.reverb-play:active{transform:scale(.99)}
    .reverb-platforms{display:flex;flex-wrap:wrap;gap:8px}
    .reverb-platforms a{padding:4px 10px;border-radius:999px;background:#fff;color:#0a0a0a;font-size:13px;font-weight:500;text-decoration:none;transition:background-color .2s}
    .reverb-platforms a:hover{background:#ececec}
    .reverb-cover{overflow:hidden;aspect-ratio:1;border-radius:24px;background:#ececec;box-shadow:0 20px 40px -20px rgba(0,0,0,.35)}
    .reverb-cover img{width:100%;height:100%;object-fit:cover}
    .reverb-archive{max-width:1040px;margin:0 auto;padding:96px 32px 64px}
    .reverb-archive-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 32px;margin-bottom:48px}
    .reverb-archive-head h2{margin:0;font-size:clamp(1.5rem,1.15rem + 1.5vw,2.25rem);font-weight:600;line-height:1.1;letter-spacing:-.015em;color:#0a0a0a}
    .reverb-archive-head p{margin:0;color:#a1a1a1;font-size:14px}
    .reverb-empty{padding:64px 0;color:#6b6b6b;text-align:center}
    /* Smaller screens: the cover becomes a small tile above the copy instead of a full-width block. */
    @media(max-width:1023px){.reverb-hero-card{grid-template-columns:1fr;gap:24px;padding:48px}.reverb-cover{order:-1;width:120px;border-radius:20px;box-shadow:0 12px 24px -14px rgba(0,0,0,.4)}}
    @media(max-width:639px){.reverb-hero{padding:96px 12px 0}.reverb-hero-card{gap:20px;padding:24px 20px 28px;border-radius:24px}.reverb-cover{width:88px;border-radius:16px}.reverb-hero h1{margin-top:16px;font-size:40px}.reverb-hero-copy>p{margin-top:12px;font-size:16px}.reverb-actions{flex-direction:column;align-items:stretch;gap:12px;margin-top:24px}.reverb-play{justify-content:center;height:52px}.reverb-platforms{flex-wrap:nowrap;margin:0 -20px;padding:0 20px;overflow-x:auto;scrollbar-width:none}.reverb-platforms::-webkit-scrollbar{display:none}.reverb-platforms a{flex-shrink:0;padding:8px 14px;font-size:14px}.reverb-archive{padding:64px 24px 48px}}
</style>
