---
import Layout from '../layouts/Layout.astro';
import editions from '../data/editions.json';
import gallery from '../data/gallery.json';
import { Image } from 'astro:assets';

const nextEdition = editions.find(e => e.status === 'In Preparation') || editions[0];
const galleryPreview = gallery.slice(0, 4);
---

<Layout>
    <section class="relative z-[60] overflow-hidden border-b border-[var(--rule)] bg-[var(--paper)]">
        <div class="absolute inset-0 z-0 pointer-events-none">
            <img src="/assets/img/RNBL3150.jpg" alt="Sandbox Réseau Background" class="w-full h-full object-cover grayscale opacity-60" />
            <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[var(--paper)]"></div>
        </div>
        <div class="relative z-10 mx-auto max-w-[1100px] px-4 py-20 md:py-32 text-center">
            <span class="inline-block w-max border-y border-[var(--rule)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[.2em] text-[var(--muted)] mb-6 animate-enter">
                Front Page
            </span>
            <h1 class="font-serif text-5xl sm:text-7xl md:text-8xl leading-[.85] tracking-tighter mb-8 animate-enter">
                Sandbox Réseau.
            </h1>
            <p class="mx-auto max-w-2xl text-[var(--muted)] text-base md:text-xl leading-relaxed font-serif animate-enter">
                Where Africa’s founders and builders connect, collaborate, and shape the future. Builder demos, mini-talks, and open networking. Signal over noise; progress over polish.
            </p>
            <div class="mt-10 flex flex-wrap items-center justify-center gap-4 animate-enter">
                <a href="https://luma.com/sandbox-reseau" target="_blank" rel="noreferrer"
                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] bg-[var(--ink)] px-6 py-3.5 text-sm font-bold uppercase tracking-widest text-[var(--paper)] hover:bg-[var(--accent)] transition-all">
                    Register on Luma
                </a>
                <a href="#about"
                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-6 py-3.5 text-sm font-bold uppercase tracking-widest hover:bg-[var(--ink)] hover:text-[var(--paper)] transition-all">
                    See the format <span class="text-lg leading-none">↓</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Main: article stream + sticky right rail -->
    <main class="mx-auto max-w-[1100px] px-4 py-16 md:py-24">
        <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1fr_320px]">
            <!-- Article stream -->
            <div class="space-y-16">
                
                <article id="about" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight tracking-[-.005em]">A Space for Founders, Builders & Makers</h3>
                    <p class="text-neutral-600 mb-6">Where sandbox experimentation meets intentional networking.</p>
                    <p><strong>Sandbox Réseau</strong> is a creative-tech meetup designed to bring together builders, thinkers, and makers who are shaping the next wave of innovation in Africa.</p>
                    <p>Born from the spirit of sandbox experimentation and the French word “réseau” — meaning network — this event celebrates connection, collaboration, and creation.</p>
                    <p>It’s a space where developers, designers, founders, and product lovers step out of their silos to share ideas, showcase what they’re building, and find new energy in community.</p>
                </article>

                <article id="purpose" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">The Purpose</h3>
                    <p class="text-neutral-600 mb-6">Nurturing a network of curious minds who build the future.</p>
                    <p>Sandbox Réseau exists to:</p>
                    <ul class="ml-5 list-disc font-sans space-y-2">
                        <li><strong>Connect</strong> creators across disciplines.</li>
                        <li><strong>Inspire</strong> through shared stories, projects, and challenges.</li>
                        <li><strong>Collaborate</strong> on new ideas and ventures born from genuine connection.</li>
                    </ul>
                </article>

                <article id="format" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">The Experience</h3>
                    <p class="text-neutral-600 mb-6">Intimate, thoughtful, and electric — a blend of knowledge and culture.</p>
                    <ul class="ml-5 list-disc font-sans space-y-2">
                        <li><strong>Builder Demos</strong> — real projects, raw prototypes, honest lessons.</li>
                        <li><strong>Featured Talks or Firesides</strong> — short, punchy insights from innovators.</li>
                        <li><strong>Open Network Sessions</strong> — meet, mingle, and connect intentionally.</li>
                        <li><strong>Showcase Wall</strong> — where attendees post what they’re working on or what help they need.</li>
                    </ul>
                </article>

                <article class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Who’s It For?</h3>
                    <p class="text-neutral-600 mb-6">Engineers, designers, founders, data/ML folks, indie makers — and the
                        product-curious.</p>
                    <p>Beginner-friendly by design. Curiosity and a builder’s mindset are enough.</p>
                </article>

                <article id="highlights" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Visual Dispatch</h3>
                    <p class="text-neutral-600 mb-6">A glimpse into the energy and conversations at Sandbox Réseau.</p>
                    <div class="mt-4 aspect-video overflow-hidden rounded border border-[var(--rule)] bg-black hatch">
                        <iframe 
                            width="100%" 
                            height="100%" 
                            src="https://www.youtube.com/embed/qSOznAR_sLs" 
                            title="Sandbox Réseau Highlights" 
                            frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                            allowfullscreen
                            class="grayscale hover:grayscale-0 transition-all duration-700"
                        ></iframe>
                    </div>
                </article>

                <article id="details" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Details & Logistics</h3>
                    <p><strong>When:</strong> Dates announced on Luma. <a class="underline decoration-[var(--rule)] hover:accent-text"
                            href="https://luma.com/sandbox-reseau" target="_blank" rel="noreferrer">Check schedule</a>.
                    </p>
                    <p><strong>Where:</strong> Accra. Venue shared with confirmed guests to keep the room intentional.
                    </p>
                    <p><strong>Capacity:</strong> Kept tight for focused conversations; early RSVP recommended.</p>
                    <p><strong>Demos:</strong> Indicate interest on RSVP; we curate 3–5 per edition.</p>
                    <p><strong>Code of Conduct:</strong> Be kind, be specific, credit work, respect time.</p>
                </article>

                <article class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Previous Editions</h3>
                    <p class="text-neutral-600 mb-6">Snapshots from our last meetup. See the vibe for yourself.</p>

                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                        {gallery.slice(0, 12).map((img, i) => (
                            <div class="group relative aspect-square w-full overflow-hidden rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_90%,var(--ink)_10%)] animate-enter">
                                <img 
                                    src={img.url} 
                                    alt={img.title || `Event photo ${i + 1}`} 
                                    onclick={`openLightbox('${img.url}')`}
                                    loading="lazy" 
                                    decoding="async"
                                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105 cursor-zoom-in grayscale group-hover:grayscale-0" 
                                />
                            </div>
                        ))}
                    </div>
                    <p class="mt-6 text-[14px] text-[var(--muted)]">Want only high-signal connection? Join the next one.</p>
                    <div class="mt-3">
                        <a href="/gallery"
                            class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-widest underline decoration-[var(--rule)] underline-offset-4 hover:accent-text transition-colors">
                            View Full Gallery <span>→</span>
                        </a>
                    </div>
                </article>

                <article id="podcast" class="prose-like">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="font-serif text-[28px] leading-tight m-0">Tune In: The Reverb</h3>
                        <span id="podcast-new-badge" class="hidden text-[10px] uppercase font-bold tracking-widest text-[var(--accent)] bg-[var(--accent)]/5 px-2 py-0.5 rounded border border-[var(--accent)]/10 animate-pulse">New Episode</span>
                    </div>
                    <p class="text-neutral-600 mb-6">The high-bandwidth audio-log for the African builder.</p>
                    
                    <div id="podcast-loader" class="flex flex-col gap-6 sm:flex-row animate-pulse">
                        <div class="w-full sm:w-1/3 aspect-square bg-neutral-200/50 rounded border border-[var(--rule)]/20"></div>
                        <div class="flex-1 space-y-4">
                            <div class="h-3 w-24 bg-neutral-200/50 rounded"></div>
                            <div class="h-6 w-3/4 bg-neutral-200/50 rounded"></div>
                            <div class="h-4 w-full bg-neutral-200/50 rounded"></div>
                            <div class="h-4 w-5/6 bg-neutral-200/50 rounded"></div>
                        </div>
                    </div>

                    <div id="podcast-content" class="hidden flex flex-col gap-6 sm:flex-row">
                        <div class="w-full sm:w-1/3 group relative aspect-square sm:aspect-auto">
                            <img id="podcast-thumb" src="/assets/img/podcast-logo.png" alt="The Reverb Podcast Logo" class="w-full rounded border border-[var(--rule)] shadow-sm grayscale hover:grayscale-0 transition-all duration-700" />
                            <a id="podcast-play-link" href="/podcast" class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 bg-[var(--ink)]/40 transition-opacity rounded">
                                <div class="w-12 h-12 rounded-full border-2 border-[var(--paper)] flex items-center justify-center text-[var(--paper)]">
                                     <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                </div>
                            </a>
                        </div>
                        <div class="flex-1 flex flex-col">
                            <div id="podcast-meta" class="flex items-center gap-2 text-[10px] uppercase font-bold tracking-widest text-[var(--muted)] mb-2">
                            </div>
                            <h4 id="podcast-title" class="font-serif text-xl mb-2 text-[var(--ink)] leading-snug"></h4>
                            <p id="podcast-desc" class="text-[14px] text-neutral-600 mb-4 leading-relaxed"></p>
                            
                            <div class="mt-auto flex flex-wrap gap-2">
                                <a id="podcast-spotify" href="https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN" target="_blank" rel="noreferrer"
                                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-4 py-2 text-[10px] font-bold uppercase tracking-widest hover:bg-[#1DB954] hover:text-white hover:border-[#1DB954] transition-all">
                                    Spotify
                                </a>
                                <a href="/podcast" 
                                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-4 py-2 text-[10px] font-bold uppercase tracking-widest hover:bg-[var(--ink)] hover:text-white transition-all">
                                    Archive
                                </a>
                            </div>
                        </div>
                    </div>
                </article>

                <article id="faq" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">FAQ</h3>
                    <p class="text-neutral-600 mb-6">Common questions.</p>
                    <ul class="ml-5 list-disc font-sans space-y-2">
                        <li><strong>Beginner-friendly?</strong> Yes.</li>
                        <li><strong>Finished product required?</strong> No — prototypes welcome.</li>
                        <li><strong>Pitches?</strong> Keep it useful and grounded; salesy pitches discouraged.</li>
                        <li><strong>Recordings?</strong> We prioritize candour; we’ll publish notes where possible.</li>
                        <li><strong>Cadence?</strong> Recurring — watch the Luma page.</li>
                    </ul>
                </article>

            </div>

            <!-- Sticky right rail -->
            <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
                
                <div class="rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)] p-6 animate-enter">
                    <h4 class="m-0 font-serif text-xl pb-4 border-b border-[var(--rule)]/20">At a Glance</h4>
                    <ul class="mt-4 flex flex-col gap-3 text-[14px] leading-relaxed font-sans text-[var(--muted)]">
                        <li><strong class="text-[var(--ink)]">Overview</strong> — experimentation meets networking.</li>
                        <li><strong class="text-[var(--ink)]">Purpose</strong> — nurture a network of curious minds.</li>
                        <li><strong class="text-[var(--ink)]">Experience</strong> — demos, talks, and connection.</li>
                        <li><strong class="text-[var(--ink)]">Highlights</strong> — watch the visual dispatch.</li>
                        <li><strong class="text-[var(--ink)]">Details</strong> — when, where, how to demo.</li>
                        <li><strong class="text-[var(--ink)]">Podcast</strong> — the high-bandwidth audio-log.</li>
                        <li><strong class="text-[var(--ink)]">FAQ</strong> — beginner-friendly, cadence, notes.</li>
                    </ul>
                </div>

                <div class="rounded border border-[var(--rule)] hatch p-6 relative overflow-hidden group animate-enter bg-[color:color-mix(in_oklab,var(--paper)_90%,var(--ink)_10%)] text-center">
                    <div class="relative z-10">
                        <div class="w-12 h-12 mx-auto rounded-full border-[2px] border-[var(--paper)] bg-[var(--ink)] flex items-center justify-center text-[var(--paper)] mb-4 shadow-lg">
                            <span class="font-serif text-xl leading-none pt-1">S</span>
                        </div>
                        <h4 class="font-serif text-xl mb-2 text-[var(--ink)]">Next Edition</h4>
                        <p class="text-[13px] text-neutral-600 mb-5 leading-relaxed">
                            {nextEdition.date} — {nextEdition.description}
                        </p>
                        <a href="https://luma.com/sandbox-reseau" target="_blank" rel="noreferrer"
                            class="block w-full rounded bg-[var(--ink)] py-3 text-xs font-bold uppercase tracking-widest text-[var(--paper)] hover:opacity-90 transition-opacity">
                            Register on Luma
                        </a>
                        <a href="/editions" class="mt-4 inline-block text-[10px] font-bold uppercase tracking-widest underline decoration-[var(--rule)] hover:accent-text transition-colors">View details →</a>
                    </div>
                </div>

            </aside>
        </div>
    </main>

    <script is:inline define:vars={{ galleryStrings: gallery.map(img => img.url) }}>
        // RSS Fetcher for Live Updates
        async function fetchLatestPodcast() {
            const loader = document.getElementById('podcast-loader');
            const content = document.getElementById('podcast-content');
            const badge = document.getElementById('podcast-new-badge');
            
            if (!loader || !content) return; 

            try {
                const rssUrl = `https://anchor.fm/s/110059518/podcast/rss?t=${Date.now()}`;
                const response = await fetch(rssUrl);
                const text = await response.text();
                const parser = new DOMParser();
                const xml = parser.parseFromString(text, "text/xml");
                const items = xml.querySelectorAll("item");
                
                if (items.length > 0) {
                    const firstItem = items[0];
                    const title = firstItem.querySelector("title")?.textContent || "The Reverb Episode";
                    const pubDate = firstItem.querySelector("pubDate")?.textContent || "";
                    const link = firstItem.querySelector("link")?.textContent || "https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN";
                    const description = firstItem.querySelector("description")?.textContent || "";
                    
                    const itunesNamespace = "http://www.itunes.com/dtds/podcast-1.0.dtd";
                    const imageElement = firstItem.getElementsByTagNameNS(itunesNamespace, "image")[0];
                    const thumb = imageElement ? imageElement.getAttribute("href") : "/assets/img/podcast-logo.png";
                    
                    const dateObj = new Date(pubDate);
                    const formattedDate = dateObj.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
                    
                    const isNew = (Date.now() - dateObj.getTime()) < (7 * 24 * 60 * 60 * 1000);
                    
                    const decoder = document.createElement('div');
                    decoder.innerHTML = description;
                    const decodedDesc = decoder.textContent || decoder.innerText || "";
                    const cleanDesc = decodedDesc.replace(/<[^>]*>?/gm, '').replace(/&quot;/g, '"').trim();
                    const formattedDesc = cleanDesc.replace(/"([A-Z])/g, '" $1');
                    const shortDesc = formattedDesc.substring(0, 150) + (formattedDesc.length > 150 ? '...' : '');

                    const titleEl = document.getElementById('podcast-title');
                    const descEl = document.getElementById('podcast-desc');
                    const metaEl = document.getElementById('podcast-meta');
                    const thumbEl = document.getElementById('podcast-thumb');
                    const spotifyEl = document.getElementById('podcast-spotify');

                    if (titleEl) titleEl.textContent = title;
                    if (descEl) descEl.textContent = shortDesc;
                    if (metaEl) metaEl.innerHTML = `<span>Dispatch: ${formattedDate}</span>`;
                    if (thumbEl) thumbEl.src = thumb;
                    if (spotifyEl) spotifyEl.href = link;
                    
                    if (isNew && badge) badge.classList.remove('hidden');
                    
                    if (loader) loader.classList.add('hidden');
                    if (content) {
                        content.classList.remove('hidden');
                        setTimeout(() => content.classList.add('visible'), 50);
                    }
                }
            } catch (e) {
                console.error("Failed to fetch live podcast:", e);
            }
        }

        document.addEventListener('astro:page-load', fetchLatestPodcast);

        // Set up gallery images for lightbox
        window.GALLERY_IMAGES = galleryStrings;

        (function() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, i) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.classList.add('visible');
                        }, (i % 6) * 80);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.animate-enter').forEach(el => observer.observe(el));
        })();

    </script>
</Layout>
