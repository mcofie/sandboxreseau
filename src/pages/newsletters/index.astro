---
import Layout from '../../layouts/Layout.astro';
import newsletters from '../../data/newsletters.json';

const headerSubtitle = "The Dispatch Archive";
---

<Layout 
    title="Newsletters | Sandbox Réseau" 
    description="Read previous issues of The Sandbox Réseau Dispatch, our weekly update on the Accra tech ecosystem."
    headerSubtitle={headerSubtitle}
>
    <main class="mx-auto max-w-[1100px] px-4 py-12">
        <header class="mb-16 max-w-2xl">
            <span
                class="inline-block w-max border-y border-[var(--rule)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[.2em] text-[var(--muted)] mb-3">
                The Archive
            </span>
            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl leading-tight mb-4 tracking-tight">
                The Gazette Dispatch.
            </h1>
            <p class="text-[var(--muted)] text-sm md:text-lg leading-relaxed font-serif ">
                Deep dives into building, product strategy, and the cultural shifts defining the next wave of African innovation.
            </p>
        </header>

        <div class="grid grid-cols-1 gap-12" id="newsletterList">
            {newsletters.slice().reverse().map((newsletter) => (
                <article class="group relative animate-enter">
                    <div class="flex flex-col md:flex-row gap-8 items-start">
                        <div class="w-full md:w-48 shrink-0 flex flex-col pt-1">
                             <div class="text-[10px] font-bold uppercase tracking-[.2em] text-[var(--muted)] mb-2">Issue {newsletter.issue}</div>
                             <div class="text-[13px] font-serif  text-neutral-500">{newsletter.date}</div>
                             <div class="mt-4 h-px w-12 bg-[var(--rule)]/20 group-hover:w-full transition-all duration-500"></div>
                        </div>

                        <div class="flex-1">
                            <div class="flex flex-col lg:flex-row gap-8">
                                {newsletter.image && (
                                    <div class="w-full lg:w-72 shrink-0 overflow-hidden rounded border border-[var(--rule)] bg-[var(--paper)] hatch group">
                                        <a href={`/newsletters/${newsletter.id}`} class="block overflow-hidden">
                                            <img 
                                                src={newsletter.image} 
                                                alt={newsletter.title}
                                                class="aspect-[16/10] w-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
                                            />
                                        </a>
                                    </div>
                                )}
                                <div class="flex-1">
                                    <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl mb-3 leading-tight group-hover:accent-text transition-colors">
                                        <a href={`/newsletters/${newsletter.id}`}>{newsletter.title}</a>
                                    </h2>
                                    <p class="text-[17px] text-neutral-600 leading-relaxed mb-6 font-serif ">
                                        "{newsletter.excerpt}"
                                    </p>
                                </div>
                            </div>
                            <div class="flex flex-wrap items-center gap-6 text-[11px] font-semibold uppercase tracking-wider text-[var(--muted)]">
                                <span class="flex items-center gap-2">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                    {newsletter.author}
                                </span>
                                <span class="flex items-center gap-2">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    {newsletter.readTime} read
                                </span>
                                <div class="flex items-center gap-2 ml-auto">
                                    {newsletter.tags.map(tag => <span class="px-2 py-0.5 rounded-full border border-[var(--rule)]/20 text-[9px]">{tag}</span>)}
                                </div>
                                <a href={`/newsletters/${newsletter.id}`} class="underline accent-text font-bold uppercase tracking-widest text-[10px] ml-4">
                                    Read Full Dispatch →
                                </a>
                            </div>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </main>

    <script is:inline>
        // Entrance Animation Logic
        (function() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, i) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.classList.add('visible');
                        }, i * 150);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.animate-enter').forEach(el => observer.observe(el));
        })();
    </script>
</Layout>
