---
const { pathname } = Astro.url;
const isHome = pathname === '/';

const mainLinks = [
    { name: 'Gazette', href: '/', icon: 'home' },
    { name: 'Podcast', href: '/podcast', icon: 'mic' },
    { name: 'Gallery', href: '/gallery', icon: 'image' },
    { name: 'Editions', href: '/editions', icon: 'layers' },
    { name: 'Community', href: '/community', icon: 'users' },
    { name: 'Registry', href: '/registry', icon: 'database' },
];

const homeAnchors = [
    { name: 'About', href: '#about' },
    { name: 'Format', href: '#format' },
    { name: 'FAQ', href: '#faq' },
    { name: 'Reports', href: '/reports', highlight: true },
];
---

<div id="floating-nav-container" class="fixed bottom-6 left-1/2 z-[55] -translate-x-1/2 transition-all duration-700 translate-y-20 opacity-0 pointer-events-none group/nav">
    <div class="relative overflow-hidden rounded-full border border-[var(--rule)] bg-[var(--paper)]/85 p-1.5 shadow-[0_20px_50px_-12px_rgba(0,0,0,0.3)] backdrop-blur-2xl transition-all duration-500 hover:shadow-[0_30px_60px_-12px_rgba(0,0,0,0.4)]">
        
        <!-- Subtle Scroll Progress Bar (Top edge) -->
        <div class="absolute top-0 left-0 h-[3px] w-full bg-[var(--ink)]/5">
             <div id="floating-progress" class="h-full bg-[var(--accent)] transition-all duration-200" style="width: 0%"></div>
        </div>

        <nav class="flex items-center gap-1.5">
            <!-- Main Pages (Icons) -->
            <div class="flex items-center gap-1 border-r border-[var(--rule)]/20 pr-1.5 ml-1">
                {mainLinks.map((link) => (
                    <a 
                        href={link.href}
                        class={`group/link relative flex h-10 w-10 items-center justify-center rounded-full transition-all duration-300 hover:scale-110 active:scale-90 ${pathname === link.href ? 'bg-[var(--ink)] text-[var(--paper)]' : 'text-[var(--muted)] hover:bg-[var(--ink)] hover:text-[var(--paper)]'}`}
                        title={link.name}
                    >
                        {link.icon === 'home' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>}
                        {link.icon === 'mic' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>}
                        {link.icon === 'image' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>}
                        {link.icon === 'layers' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m16.02 12 5.48 3.13a1 1 0 0 1 0 1.74L13 21.74a2 2 0 0 1-2 0l-8.5-4.87a1 1 0 0 1 0-1.74L7.98 12"/><path d="m16.02 4.12 5.48 3.13a1 1 0 0 1 0 1.74L13 13.85a2 2 0 0 1-2 0L2.5 8.99a1 1 0 0 1 0-1.74L7.98 4.12a2 2 0 0 1 2.04 0Z"/></svg>}
                        {link.icon === 'users' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
                        {link.icon === 'database' && <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></svg>}
                        <span class="pointer-events-none absolute -top-12 left-1/2 -translate-x-1/2 scale-0 rounded-md bg-[var(--ink)] px-2 py-1 text-[10px] font-bold uppercase tracking-widest text-[var(--paper)] transition-all duration-200 group-hover/link:scale-100 shadow-xl whitespace-nowrap">
                            {link.name}
                        </span>
                    </a>
                ))}
            </div>

            <!-- Contextual Navigation (Anchors or Page Labels) -->
            <div class="flex items-center gap-1 px-2.5">
                {isHome ? (
                    homeAnchors.map((anchor) => (
                        <a 
                            href={anchor.href}
                            class={`whitespace-nowrap px-3 py-2 text-[11px] font-black uppercase tracking-[0.14em] transition-all rounded-full hover:scale-105 active:scale-95 ${anchor.highlight ? 'bg-[var(--ink)] text-[var(--paper)] hover:bg-[var(--accent)]' : 'text-[var(--muted)] hover:text-[var(--ink)] hover:bg-[var(--ink)]/5'}`}
                        >
                            {anchor.name}
                        </a>
                    ))
                ) : (
                    <div class="flex items-center gap-3 pr-2">
                        <div class="flex flex-col">
                             <span class="text-[9px] font-black text-[var(--muted)] uppercase tracking-widest leading-none">In this issue</span>
                             <span class="text-[13px] font-serif text-[var(--ink)] leading-tight capitalize" id="current-page-label">
                                {pathname.split('/').filter(Boolean).pop()?.replace(/-/g, ' ') || 'Gazette'}
                             </span>
                        </div>
                        <div class="h-2 w-2 rounded-full bg-[var(--accent)] shadow-[0_0_8px_var(--accent)] animate-pulse"></div>
                    </div>
                )}
            </div>
        </nav>
    </div>
</div>

<style>
    #floating-nav-container.visible {
        transform: translate(-50%, 0) !important;
        opacity: 1 !important;
        pointer-events: auto !important;
    }

    #floating-nav-container.shifted {
        bottom: 110px !important; /* Shift up to clear player bar */
    }
</style>

<script>
    function initFloatingNav() {
        const nav = document.getElementById('floating-nav-container');
        const progress = document.getElementById('floating-progress');
        const player = document.getElementById('global-player');
        if (!nav) return;

        const handleScroll = () => {
            const scrolled = window.scrollY;
            // Lower threshold for subpages (isHome is injected via define:vars if needed, 
            // but we can just use the path check here too)
            const isHomePath = window.location.pathname === '/';
            const threshold = isHomePath ? (window.innerWidth < 768 ? 80 : 200) : 50;

            if (scrolled > threshold) {
                nav.classList.add('visible');
            } else {
                nav.classList.remove('visible');
            }

            // Progress Logic
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolledPercent = (winScroll / height) * 100;
            if (progress) progress.style.width = scrolledPercent + "%";

            // Player overlap detection
            if (player && player.classList.contains('active')) {
                nav.classList.add('shifted');
            } else {
                nav.classList.remove('shifted');
            }
        };

        window.addEventListener('scroll', handleScroll, { passive: true });
        
        // Observer for player visibility
        if (player) {
            const observer = new MutationObserver(() => {
                 if (player.classList.contains('active')) {
                    nav.classList.add('shifted');
                } else {
                    nav.classList.remove('shifted');
                }
            });
            observer.observe(player, { attributes: true, attributeFilter: ['class'] });
        }

        handleScroll(); // Initial check
        
        // --- ACTIVE SECTION HIGHLIGHTING ---
        const observerOptions = {
            root: null,
            rootMargin: '-30% 0% -50% 0%',
            threshold: 0
        };

        const sectionObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const id = entry.target.getAttribute('id');
                    document.querySelectorAll('#floating-nav-container a[href^="#"]').forEach(a => {
                        const href = a.getAttribute('href');
                        if (href === `#${id}`) {
                            a.style.color = 'var(--accent)';
                        } else {
                            a.style.color = '';
                        }
                    });
                }
            });
        }, observerOptions);

        document.querySelectorAll('article[id]').forEach(section => {
            sectionObserver.observe(section);
        });
    }

    // Initialize
    initFloatingNav();
    document.addEventListener('astro:after-swap', initFloatingNav);
</script>
