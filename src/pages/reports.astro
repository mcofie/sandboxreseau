---
import Layout from '../layouts/Layout.astro';
import reports from '../data/reports.json';
import newsletters from '../data/newsletters.json';

const [featured, ...otherReports] = reports;
const availableCount = reports.filter((report) => report.status === 'available').length;
const upcomingCount = reports.length - availableCount;
const otherAllUpcoming = otherReports.every((report) => report.status !== 'available');
const latestNotes = [...newsletters]
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
    .slice(0, 3)
    .map((note) => ({
        ...note,
        shortDate: new Date(note.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }),
    }));
---

<Layout
    title="Reports | Sandbox Réseau"
    description="Research reports and ecosystem intelligence from Sandbox Réseau. Download PDF publications on the African startup landscape."
    image="/assets/img/state-of-accra-report-bg.jpg"
    imageAlt="The State of Accra’s Startup Ecosystem 2026 report cover"
>
    <main class="reports-page">
        <section class="reports-head" aria-labelledby="reports-title">
            <span class="reports-pill"><span class="reports-dot" aria-hidden="true"></span>Reports · {availableCount} available{upcomingCount > 0 && ` · ${upcomingCount} coming soon`} · Free to download</span>
            <h1 id="reports-title">Reports &amp; research.</h1>
            <p>Ecosystem intelligence and research publications from Sandbox Réseau. Deep, data-driven reports on the builders shaping Africa’s future.</p>
        </section>

        {featured && (
            <section class="report-feature" aria-labelledby="report-feature-title">
                <div class="report-feature-art">
                    {featured.bgImage ? <img src={featured.bgImage} alt="" decoding="async" /> : <span class="report-feature-fallback">{featured.title}</span>}
                    <span class="report-chip report-chip-left">Report</span>
                    {featured.pages && <span class="report-chip report-chip-right">{featured.pages} pages</span>}
                </div>
                <div class="report-feature-copy">
                    <p class="report-meta">{featured.date}{featured.status === 'available' && ' · PDF'}</p>
                    <h2 id="report-feature-title">{featured.title}{featured.subtitle && <span>{featured.subtitle}</span>}</h2>
                    <p class="report-desc">{featured.description}</p>
                    <div class="report-tags">{featured.tags.map((tag) => <span>{tag}</span>)}</div>
                    <div class="report-actions">
                        {featured.status === 'available' ? (
                            <>
                                <button type="button" class="report-primary" data-pdf-open={featured.pdf} data-pdf-title={featured.title}>Read report</button>
                                <a class="report-secondary" href={featured.pdf} download>Download PDF</a>
                            </>
                        ) : (
                            <span class="report-soon">Coming soon</span>
                        )}
                    </div>
                </div>
            </section>
        )}

        {otherReports.length > 0 && (
            <section class="reports-section" aria-labelledby="reports-more-title">
                <h2 id="reports-more-title">{otherAllUpcoming ? 'Coming soon.' : 'More reports.'}</h2>
                {otherAllUpcoming && <p class="reports-more-lede">Playbooks and cheat sheets in the works for builders. Check back soon.</p>}
                <div class="reports-grid">
                    {otherReports.map((report) => (
                        <article class="report-card">
                            <div class="report-card-art">
                                {report.bgImage && <img src={report.bgImage} alt={`${report.title} cover`} loading="lazy" />}
                                {report.status !== 'available' && <span class="report-chip report-chip-left">Coming soon</span>}
                            </div>
                            {(report.date || report.pages) && <p class="report-meta">{[report.date, report.pages && `${report.pages} pages`].filter(Boolean).join(' · ')}</p>}
                            <h3>{report.title}</h3>
                            <p class="report-desc">{report.description}</p>
                            {report.status === 'available' ? (
                                <button type="button" class="report-link" data-pdf-open={report.pdf} data-pdf-title={report.title}>Read report →</button>
                            ) : null}
                        </article>
                    ))}
                </div>
            </section>
        )}

        <section class="reports-section" aria-labelledby="reports-notes-title">
            <div class="reports-section-head">
                <div>
                    <h2 id="reports-notes-title">Notes from the room.</h2>
                    <p>Shorter reads from our newsletter: playbooks and lessons from each edition.</p>
                </div>
                <a href="https://mcofie.substack.com/" target="_blank" rel="noreferrer">Subscribe on Substack →</a>
            </div>
            <div class="notes-grid">
                {latestNotes.map((note) => (
                    <a class="note-card" href={`/newsletters/${note.id}`}>
                        <div class="note-art"><img src={note.image} alt="" loading="lazy" /></div>
                        <div class="note-meta"><span>{note.tags[0]}</span>{note.shortDate} · {note.readTime} read</div>
                        <h3>{note.title}</h3>
                    </a>
                ))}
            </div>
        </section>

        <section class="reports-cta" aria-labelledby="reports-cta-title">
            <div class="reports-cta-card">
                <h2 id="reports-cta-title">Have research to contribute?</h2>
                <p>Our publications are free to download and share. If you have data or research on the ecosystem, reach out to the team on Discord.</p>
                <a class="reports-cta-button" href="https://discord.gg/RMcBDRrV7x" target="_blank" rel="noreferrer">
                    Join the Discord
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
                </a>
            </div>
        </section>
    </main>

    <div class="pdf-viewer" role="dialog" aria-modal="true" aria-labelledby="pdf-viewer-title" hidden data-pdf-viewer>
        <div class="pdf-viewer-backdrop" data-pdf-close></div>
        <div class="pdf-viewer-panel">
            <div class="pdf-viewer-bar">
                <h2 id="pdf-viewer-title" data-pdf-viewer-title></h2>
                <div class="pdf-viewer-actions">
                    <a class="report-secondary" href="#" download data-pdf-download>Download</a>
                    <button type="button" class="pdf-viewer-close" aria-label="Close viewer" data-pdf-close>
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
                    </button>
                </div>
            </div>
            <iframe class="pdf-viewer-frame" title="Report viewer" data-pdf-frame></iframe>
        </div>
    </div>
</Layout>

<script>
    function setViewer(pdf?: string, title?: string) {
        const viewer = document.querySelector<HTMLElement>('[data-pdf-viewer]');
        const frame = document.querySelector<HTMLIFrameElement>('[data-pdf-frame]');
        if (!viewer || !frame) return;
        const open = Boolean(pdf);
        frame.src = pdf ?? 'about:blank';
        viewer.hidden = !open;
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) {
            const titleEl = viewer.querySelector('[data-pdf-viewer-title]');
            const download = viewer.querySelector<HTMLAnchorElement>('[data-pdf-download]');
            if (titleEl) titleEl.textContent = title || 'Report';
            if (download) download.href = pdf!;
            viewer.querySelector<HTMLElement>('.pdf-viewer-close')?.focus();
        }
    }

    // Delegated once on the document, so it survives view transitions without re-binding.
    document.addEventListener('click', (event) => {
        const target = event.target as Element;
        const opener = target.closest<HTMLElement>('[data-pdf-open]');
        if (opener) return setViewer(opener.dataset.pdfOpen, opener.dataset.pdfTitle);
        if (target.closest('[data-pdf-close]')) setViewer();
    });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && document.querySelector<HTMLElement>('[data-pdf-viewer]')?.hidden === false) setViewer();
    });
</script>

<style>
    .reports-page{max-width:1040px;margin:0 auto;padding:152px 32px 64px;font-family:Inter,system-ui,sans-serif;color:#0a0a0a}
    .reports-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid rgba(10,10,10,.1);border-radius:999px;color:#6b6b6b;font-size:13px;font-weight:500}
    .reports-dot{width:7px;height:7px;border-radius:50%;background:#8fbf24}
    .reports-head h1{margin:24px 0 0;font-size:clamp(2.5rem,1.6rem + 3vw,4rem);font-weight:600;line-height:1.02;letter-spacing:-.03em}
    .reports-head>p{max-width:50ch;margin:20px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .report-feature{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:48px;margin-top:64px;padding:24px;border-radius:28px;background:#f5f5f5}
    .report-feature-art{position:relative;aspect-ratio:2/1;overflow:hidden;border-radius:20px;background:#ececec}
    .report-feature-art img{width:100%;height:100%;object-fit:cover}
    .report-feature-fallback{display:grid;place-items:center;height:100%;padding:32px;font-size:22px;font-weight:600;text-align:center}
    .report-chip{position:absolute;bottom:14px;padding:4px 12px;border-radius:999px;background:#fff;box-shadow:0 2px 8px rgba(0,0,0,.12);color:#0a0a0a;font-size:12.5px;font-weight:600}
    .report-chip-left{left:14px}.report-chip-right{right:14px;color:#6b6b6b;font-weight:500}
    .report-feature-copy{padding:16px 24px 16px 0}
    .report-meta{margin:0;color:#a1a1a1;font-size:13px}
    .report-feature h2{margin:12px 0 0;font-size:clamp(1.5rem,1.15rem + 1.2vw,2.125rem);font-weight:600;line-height:1.12;letter-spacing:-.02em}
    .report-feature h2 span{display:block;color:#6b6b6b;font-weight:500}
    .report-desc{margin:16px 0 0;color:#6b6b6b;font-size:16px;line-height:1.55}
    .report-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:20px}
    .report-tags span{padding:3px 10px;border:1px solid rgba(10,10,10,.1);border-radius:999px;background:#fff;color:#6b6b6b;font-size:12px;font-weight:500}
    .report-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}
    .report-primary,.report-secondary{display:inline-flex;align-items:center;height:48px;padding:0 24px;border-radius:999px;font:inherit;font-size:16px;font-weight:600;text-decoration:none;cursor:pointer;transition:background-color .2s,border-color .2s}
    .report-primary{border:0;background:#0a0a0a;color:#fff}
    .report-primary:hover{background:rgba(10,10,10,.9)}
    .report-secondary{border:1px solid rgba(10,10,10,.12);background:#fff;color:#0a0a0a}
    .report-secondary:hover{border-color:rgba(10,10,10,.4)}
    .report-soon{display:inline-flex;align-items:center;height:40px;padding:0 16px;border-radius:999px;background:#fff;color:#6b6b6b;font-size:14px;font-weight:500}
    .reports-section{margin-top:112px}
    .reports-section h2,.reports-cta-card h2{margin:0;font-size:clamp(1.5rem,1.15rem + 1.5vw,2.25rem);font-weight:600;line-height:1.1;letter-spacing:-.015em}
    .reports-section-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px 32px}
    .reports-section-head p{max-width:46ch;margin:16px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .reports-section-head a{color:#6b6b6b;font-size:14px;font-weight:500;text-decoration:none;transition:color .2s}
    .reports-section-head a:hover{color:#0a0a0a}
    .reports-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:40px}
    .report-card{padding:20px;border:1px solid rgba(10,10,10,.1);border-radius:28px}
    .report-card-art{position:relative;aspect-ratio:2/1;overflow:hidden;margin-bottom:20px;border-radius:18px;background:#f5f5f5}
    .report-card-art img{width:100%;height:100%;object-fit:cover}
    .report-card h3{margin:8px 0 0;font-size:19px;font-weight:600}
    .report-card .report-desc{font-size:15px}
    .reports-more-lede{margin:16px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .report-link{margin-top:16px;padding:0;border:0;background:none;color:#0a0a0a;font:inherit;font-size:14px;font-weight:600;cursor:pointer}
    .notes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:40px}
    .note-card{display:block;color:inherit;text-decoration:none}
    .note-art{aspect-ratio:4/3;overflow:hidden;border-radius:24px;background:#f5f5f5}
    .note-art img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.22,1,.36,1)}
    .note-card:hover .note-art img{transform:scale(1.04)}
    .note-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:16px;color:#a1a1a1;font-size:13px}
    .note-meta span{padding:2px 8px;border:1px solid rgba(10,10,10,.1);border-radius:999px;color:#6b6b6b;font-weight:500}
    .note-card h3{margin:10px 0 0;font-size:18px;font-weight:600;line-height:1.3;letter-spacing:-.01em}
    .reports-cta{margin-top:112px}
    .reports-cta-card{display:flex;flex-direction:column;align-items:center;padding:72px 32px;border-radius:28px;background:#f5f5f5;text-align:center}
    .reports-cta-card p{max-width:48ch;margin:16px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .reports-cta-button{display:inline-flex;align-items:center;gap:10px;height:48px;margin-top:32px;padding:0 28px;border-radius:999px;background:#0a0a0a;color:#fff;font-size:16px;font-weight:600;text-decoration:none;transition:background-color .2s}
    .reports-cta-button:hover{background:rgba(10,10,10,.9)}
    .pdf-viewer{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;padding:24px;font-family:Inter,system-ui,sans-serif}
    .pdf-viewer[hidden]{display:none}
    .pdf-viewer-backdrop{position:absolute;inset:0;background:rgba(10,10,10,.6);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
    .pdf-viewer-panel{position:relative;display:flex;flex-direction:column;width:min(1100px,100%);height:min(92vh,1000px);overflow:hidden;border-radius:24px;background:#fff;box-shadow:0 30px 80px -20px rgba(0,0,0,.5)}
    .pdf-viewer-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 12px 12px 24px;border-bottom:1px solid rgba(10,10,10,.1)}
    .pdf-viewer-bar h2{overflow:hidden;margin:0;font-size:16px;font-weight:600;white-space:nowrap;text-overflow:ellipsis}
    .pdf-viewer-actions{display:flex;flex-shrink:0;gap:8px}
    .pdf-viewer-actions .report-secondary{height:40px;padding:0 18px;font-size:14px}
    .pdf-viewer-close{display:grid;place-items:center;width:40px;height:40px;border:1px solid rgba(10,10,10,.12);border-radius:50%;background:#fff;color:#0a0a0a;cursor:pointer;transition:border-color .2s}
    .pdf-viewer-close:hover{border-color:rgba(10,10,10,.4)}
    .pdf-viewer-frame{flex:1;width:100%;border:0;background:#f5f5f5}
    @media(max-width:1023px){.report-feature{grid-template-columns:1fr;gap:24px}.report-feature-copy{padding:0 12px 12px}.notes-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:639px){.reports-page{padding:120px 24px 48px}.report-feature{margin-top:48px;padding:16px}.reports-section,.reports-cta{margin-top:80px}.reports-grid,.notes-grid{grid-template-columns:1fr}.reports-cta-card{padding:56px 24px}.pdf-viewer{padding:0}.pdf-viewer-panel{height:100%;border-radius:0}}
</style>
