---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GlobalPlayer from '../components/GlobalPlayer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
    /** Social share image (path or URL). Defaults to the branded 1200×630 card. */
    image?: string;
    imageAlt?: string;
}

const SITE_NAME = 'Sandbox Réseau';
const {
    title = 'Sandbox Réseau | The Builders’ Gathering in Accra',
    description = 'A gathering in Accra for Africa’s founders, builders, and curious minds. Builder demos, mini-talks, and open networking. Signal over noise; progress over polish.',
    image = '/assets/img/social-preview.jpg',
    imageAlt = 'Sandbox Réseau: where Africa’s founders and builders connect.',
} = Astro.props;

// Social platforms need absolute URLs; `site` comes from astro.config.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const isDefaultImage = image === '/assets/img/social-preview.jpg';
---

<!DOCTYPE html>
<html lang="en" data-theme="white" data-accent="blue">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#0a0a0a" />
		<meta name="generator" content={Astro.generator} />

        <!-- Primary meta -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content={SITE_NAME} />
        <link rel="canonical" href={canonical} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:locale" content="en_GB" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:alt" content={imageAlt} />
        {isDefaultImage && <meta property="og:image:width" content="1200" />}
        {isDefaultImage && <meta property="og:image:height" content="630" />}

        <!-- X / Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <!-- Only the weights in use; loaded without blocking first paint (system fonts show until it arrives). -->
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital@0;1&display=swap" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital@0;1&display=swap" media="print" onload="this.media='all'" />
        <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital@0;1&display=swap" /></noscript>

        <ClientRouter />
	</head>
	<body class="min-h-screen font-sans antialiased">
        <Header />
		<slot />
        <Footer />
        <GlobalPlayer />

        <!-- Main Runtime Scripts -->
        <script>
            // --- PERSISTENT AUDIO SYSTEM ---
            (function() {
                // Initialize Global Audio once
                if (!(window as any).SBR_AUDIO) {
                    (window as any).SBR_AUDIO = new Audio();
                }
                
                const audio = (window as any).SBR_AUDIO;
                let activeId = (window as any).SBR_ACTIVE_EP_ID || null;

                function formatTime(s: number) {
                    const m = Math.floor(s / 60);
                    const sec = Math.floor(s % 60);
                    return `${m}:${sec.toString().padStart(2, '0')}`;
                }

                function updatePlayerUI() {
                    const bar = document.getElementById('global-player');
                    const playIcon = document.getElementById('playIconMain');
                    const pauseIcon = document.getElementById('pauseIconMain');
                    const titleEl = document.getElementById('playerTitle');
                    const metaEl = document.getElementById('playerMeta');
                    const thumbEl = document.getElementById('playerThumbnail') as HTMLImageElement;
                    const progress = document.getElementById('playerProgressBar');
                    const currentEl = document.getElementById('playerCurrentTime');
                    const durEl = document.getElementById('playerDuration');

                    if (!bar) return;

                    if (audio.paused) {
                        playIcon?.classList.remove('hidden');
                        pauseIcon?.classList.add('hidden');
                    } else {
                        playIcon?.classList.add('hidden');
                        pauseIcon?.classList.remove('hidden');
                        bar.classList.add('active'); // Keep bar visible if playing
                    }

                    // Update local cards if they exist
                    document.querySelectorAll('.episode-card').forEach(card => {
                        if (card.getAttribute('data-episode-id') === activeId && !audio.paused) {
                            card.classList.add('is-playing');
                        } else {
                            card.classList.remove('is-playing');
                        }
                    });

                    // Update labels
                    if (currentEl) currentEl.textContent = formatTime(audio.currentTime);
                    if (durEl && audio.duration) durEl.textContent = formatTime(audio.duration);
                    if (progress && audio.duration) {
                        progress.style.width = (audio.currentTime / audio.duration) * 100 + '%';
                    }
                }

                // Global play function accessible from anywhere
                (window as any).playEpisode = (id: string, url: string, title: string, meta: string, thumb: string) => {
                    const bar = document.getElementById('global-player');
                    if (activeId === id) {
                        if (audio.paused) audio.play();
                        else audio.pause();
                    } else {
                        activeId = id;
                        (window as any).SBR_ACTIVE_EP_ID = id;
                        audio.src = url;
                        audio.play();

                        // Sync UI content
                        const titleEl = document.getElementById('playerTitle');
                        const metaEl = document.getElementById('playerMeta');
                        const thumbEl = document.getElementById('playerThumbnail') as HTMLImageElement;
                        if (titleEl) titleEl.textContent = title;
                        if (metaEl) metaEl.textContent = meta;
                        if (thumbEl) thumbEl.src = thumb;
                    }
                    bar?.classList.add('active');
                    updatePlayerUI();
                };

                // Audio Events
                audio.ontimeupdate = updatePlayerUI;
                audio.onplay = updatePlayerUI;
                audio.onpause = updatePlayerUI;
                audio.onloadedmetadata = updatePlayerUI;

                // Sync UI on every page swap
                function syncUI() {
                    const bar = document.getElementById('global-player');
                    const mainToggle = document.getElementById('playerMainToggle');
                    const progContainer = document.getElementById('playerProgressContainer');
                    const speedToggle = document.getElementById('speedToggle');

                    if (activeId) bar?.classList.add('active');
                    
                    mainToggle?.addEventListener('click', () => {
                        if (audio.paused) audio.play();
                        else audio.pause();
                    });

                    progContainer?.addEventListener('click', (e: any) => {
                        const rect = progContainer.getBoundingClientRect();
                        const p = (e.clientX - rect.left) / rect.width;
                        audio.currentTime = p * audio.duration;
                    });

                    // Re-init speed
                    speedToggle?.addEventListener('click', () => document.getElementById('speedDropdown')?.classList.toggle('active'));
                    document.querySelectorAll('.speed-option').forEach(opt => {
                        opt.addEventListener('click', () => {
                            const s = (opt as HTMLElement).dataset.speed;
                            if (s) {
                                audio.playbackRate = parseFloat(s);
                                if (speedToggle) speedToggle.textContent = s + 'x';
                                document.querySelectorAll('.speed-option').forEach(o => o.classList.remove('active'));
                                opt.classList.add('active');
                                document.getElementById('speedDropdown')?.classList.remove('active');
                            }
                        });
                    });

                    updatePlayerUI();
                }

                document.addEventListener('astro:after-swap', syncUI);
                syncUI(); // Init on load
            })();


            // Lightbox Logic (Optimized Global version)
            (function () {
                let currentLightboxIndex = -1;
                let lightbox: HTMLElement | null;
                let lightboxImg: HTMLImageElement | null;
                let lastFocusedElement: HTMLElement | null = null;
                function initLightbox() {
                    if (document.querySelector('.lightbox-overlay')) return;
                    
                    lightbox = document.createElement('div');
                    lightbox.className = 'lightbox-overlay';
                    lightbox.setAttribute('role', 'dialog');
                    lightbox.setAttribute('aria-modal', 'true');
                    lightbox.setAttribute('aria-label', 'Image Lightbox');

                    lightbox.innerHTML = `
                    <button class="lightbox-close" aria-label="Close Lightbox">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                    <button class="lightbox-nav lightbox-prev" aria-label="Previous Image">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                    </button>
                    <div class="lightbox-content">
                        <img class="lightbox-img" src="" alt="Expanded View" referrerpolicy="no-referrer" />
                    </div>
                    <button class="lightbox-nav lightbox-next" aria-label="Next Image">
                         <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </button>
                    `;
                    document.body.appendChild(lightbox);
                    lightboxImg = lightbox.querySelector('.lightbox-img');

                    // Listeners
                    lightbox.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
                    lightbox.querySelector('.lightbox-next')?.addEventListener('click', nextImage);
                    lightbox.querySelector('.lightbox-prev')?.addEventListener('click', prevImage);
                    lightbox.addEventListener('click', (e) => {
                        if (e.target === lightbox) closeLightbox();
                    });
                }

                (window as any).openLightbox = (input: number | string) => {
                    if (!lightbox) initLightbox();
                    lastFocusedElement = document.activeElement as HTMLElement;

                    if (typeof input === 'number') {
                        currentLightboxIndex = input;
                        updateLightbox();
                    } else if (typeof input === 'string') {
                        currentLightboxIndex = -1;
                        if (lightboxImg) lightboxImg.src = input;
                        if (lightbox) {
                            (lightbox.querySelector('.lightbox-next') as HTMLElement).style.display = 'none';
                            (lightbox.querySelector('.lightbox-prev') as HTMLElement).style.display = 'none';
                        }
                    }

                    if (lightbox) {
                        lightbox.classList.add('open');
                        document.body.style.overflow = 'hidden';
                        (lightbox.querySelector('.lightbox-close') as HTMLElement).focus();
                    }
                };

                function closeLightbox() {
                    if (!lightbox) return;
                    lightbox.classList.remove('open');
                    document.body.style.overflow = '';
                    (lightbox.querySelector('.lightbox-next') as HTMLElement).style.display = '';
                    (lightbox.querySelector('.lightbox-prev') as HTMLElement).style.display = '';
                    if (lastFocusedElement) lastFocusedElement.focus();
                    setTimeout(() => {
                        if (lightboxImg) lightboxImg.src = '';
                    }, 300);
                }

                function updateLightbox() {
                    const images = (window as any).GALLERY_IMAGES || [];
                    if (currentLightboxIndex >= 0 && currentLightboxIndex < images.length) {
                        const url = images[currentLightboxIndex];
                        if (lightboxImg) lightboxImg.src = url;
                        if (lightbox) {
                            (lightbox.querySelector('.lightbox-next') as HTMLElement).style.display = images.length > 1 ? '' : 'none';
                            (lightbox.querySelector('.lightbox-prev') as HTMLElement).style.display = images.length > 1 ? '' : 'none';
                        }
                    } else {
                        if (lightbox) {
                            (lightbox.querySelector('.lightbox-next') as HTMLElement).style.display = 'none';
                            (lightbox.querySelector('.lightbox-prev') as HTMLElement).style.display = 'none';
                        }
                    }
                }

                function nextImage(e?: Event) {
                    if (e) e.stopPropagation();
                    const images = (window as any).GALLERY_IMAGES || [];
                    if (images.length === 0 || currentLightboxIndex < 0) return;
                    currentLightboxIndex = (currentLightboxIndex + 1) % images.length;
                    updateLightbox();
                }

                function prevImage(e?: Event) {
                    if (e) e.stopPropagation();
                    const images = (window as any).GALLERY_IMAGES || [];
                    if (images.length === 0 || currentLightboxIndex < 0) return;
                    currentLightboxIndex = (currentLightboxIndex - 1 + images.length) % images.length;
                    updateLightbox();
                }

                document.addEventListener('keydown', (e) => {
                    if (!lightbox || !lightbox.classList.contains('open')) return;
                    if (e.key === 'Escape') closeLightbox();
                    if (e.key === 'ArrowRight') nextImage();
                    if (e.key === 'ArrowLeft') prevImage();
                });
            })();

            // --- GLOBAL ENTRANCE ANIMATIONS ---
            function initEntranceAnimations() {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach((entry, i) => {
                        if (entry.isIntersecting) {
                            setTimeout(() => {
                                entry.target.classList.add('visible');
                            }, (i % 4) * 100);
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 });

                const elements = document.querySelectorAll('.animate-enter');
                elements.forEach(el => observer.observe(el));

                // Fail-safe: Force all to be visible after 2 seconds if still hidden
                setTimeout(() => {
                    elements.forEach(el => el.classList.add('visible'));
                }, 2000);
            }

            document.addEventListener('astro:after-swap', initEntranceAnimations);
            initEntranceAnimations();
        </script>
	</body>
</html>
