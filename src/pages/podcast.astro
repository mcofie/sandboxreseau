---
import Layout from '../layouts/Layout.astro';
import GlobalPlayer from '../components/GlobalPlayer.astro';

const headerSubtitle = "Digital Audio-Log";
---

<Layout 
    title="The Reverb Podcast | Sandbox Réseau" 
    description="The high-bandwidth audio-log for the African builder. Listen to the latest dispatches from the Sandbox Réseau ecosystem."
    headerSubtitle={headerSubtitle}
>
    <!-- Hero Section -->
    <section class="border-b border-[var(--rule)] bg-[var(--paper)]">
        <div class="mx-auto grid max-w-[1100px] grid-cols-1 gap-12 px-4 py-12 md:grid-cols-2">
            <aside class="flex items-center justify-center lg:justify-end order-1 md:order-2">
                <div class="relative group p-4 hatch rounded border border-[var(--rule)]">
                    <img id="podcastCover" src="/assets/img/podcast-logo.png" alt="The Reverb Logo" class="w-64 h-64 sm:w-80 sm:h-80 rounded border border-[var(--rule)] shadow-2xl grayscale group-hover:grayscale-0 transition-all duration-700">
                </div>
            </aside>

            <div class="flex flex-col justify-center order-2 md:order-1">
                <span class="inline-block w-max border-y border-[var(--rule)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[.2em] text-[var(--muted)] mb-5">
                    Audio Dispatch
                </span>
                <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl leading-[.95] tracking-tight mb-6">
                    The Reverb.
                </h2>
                <div class="text-[17px] text-[var(--muted)] leading-relaxed max-w-xl font-sans space-y-4">
                    <p>The Reverb is a fast-paced tech podcast capturing real conversations from the Sandbox Réseau community.</p>
                    <p>Each 5-minute episode distils insights, ideas, and lessons from builders actively creating, stitched together into a tight, signal-rich experience.</p>
                    <p>No fillers. Just what people are building, thinking, and learning right now.</p>
                </div>

                <div class="mt-12 flex flex-wrap items-center gap-4">
                    <a href="https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN" target="_blank" class="flex items-center justify-center rounded-full border border-[var(--rule)] px-6 py-2.5 text-[10px] font-black uppercase tracking-widest hover:bg-[#1DB954] hover:text-white hover:border-[#1DB954] transition-all">
                        Spotify
                    </a>
                    <a href="https://podcasts.apple.com/gh/podcast/the-reverb/id1884282478" target="_blank" class="flex items-center justify-center rounded-full border border-[var(--rule)] px-6 py-2.5 text-[10px] font-black uppercase tracking-widest hover:bg-[#8e3ee5] hover:text-white hover:border-[#8e3ee5] transition-all">
                        Apple
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Episodes Grid -->
    <main class="mx-auto max-w-[1100px] px-4 py-12">
        <div class="mb-12 flex items-center justify-between gap-4">
             <h3 class="font-serif text-2xl tracking-tight">Archive</h3>
             <div class="h-px flex-1 bg-[var(--rule)]/10"></div>
             <div id="podcast-count" class="text-[11px] font-bold uppercase tracking-widest text-[var(--muted)]">Loading Episodes...</div>
        </div>

        <div id="podcast-error" class="hidden text-center py-20 text-neutral-500 font-serif italic"></div>
        
        <div id="podcast-archive" class="space-y-6">
            <!-- Shimmers -->
            <div class="podcast-shimmer space-y-6">
                {[1, 2, 3].map(() => (
                    <div class="flex flex-col sm:flex-row gap-6 p-6 rounded border border-[var(--rule)] bg-[var(--paper)] animate-pulse">
                        <div class="w-full aspect-square sm:w-40 sm:h-40 bg-neutral-200 rounded"></div>
                        <div class="flex-1 space-y-4">
                            <div class="h-3 w-32 bg-neutral-200 rounded"></div>
                            <div class="h-8 w-3/4 bg-neutral-200 rounded"></div>
                            <div class="h-4 w-full bg-neutral-200 rounded"></div>
                        </div>
                    </div>
                ))}
            </div>
        </div>

        <!-- Subscribe CTA -->
        <div class="mt-28 mb-12 relative overflow-hidden rounded border border-[var(--rule)] bg-[var(--paper)] p-12 text-center animate-enter">
            <div class="absolute inset-0 hatch opacity-[0.03] pointer-events-none"></div>
            <div class="relative z-10">
                <div class="mb-8 inline-block rounded border border-[var(--rule)] bg-[var(--paper)] p-2">
                    <img src="/assets/img/podcast-logo.png" alt="Logo" class="w-12 h-12 grayscale">
                </div>
                <h3 class="font-serif text-3xl md:text-4xl mb-4 tracking-tight text-[var(--ink)]">Never miss a pulse.</h3>
                <p class="text-[var(--muted)] mb-10 max-w-lg mx-auto font-serif text-lg leading-relaxed">
                    Subscribe on your preferred platform for weekly dispatches from the Sandbox.
                </p>
                <div class="flex flex-wrap justify-center gap-6">
                    <a href="https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN" target="_blank" class="text-xs font-bold uppercase tracking-widest underline decoration-2 underline-offset-4 hover:accent-text">Spotify</a>
                    <a href="https://podcasts.apple.com/gh/podcast/the-reverb/id1884282478" target="_blank" class="text-xs font-bold uppercase tracking-widest underline decoration-2 underline-offset-4 hover:accent-text">Apple</a>
                    <a href="https://anchor.fm/s/110059518/podcast/rss" target="_blank" class="text-xs font-bold uppercase tracking-widest underline decoration-2 underline-offset-4 hover:accent-text">RSS Feed</a>
                </div>
            </div>
        </div>
    </main>

    <GlobalPlayer />

    <script is:inline>
        async function fetchPodcastArchive() {
            const archive = document.getElementById('podcast-archive');
            const countDisplay = document.getElementById('podcast-count');
            const errorDisplay = document.getElementById('podcast-error');
            
            if (!archive) return; // Not on the podcast page

            try {
                const rssUrl = `https://anchor.fm/s/110059518/podcast/rss?t=${Date.now()}`;
                const response = await fetch(rssUrl);
                const text = await response.text();
                const parser = new DOMParser();
                const xml = parser.parseFromString(text, "text/xml");
                const items = xml.querySelectorAll("item");
                
                if (items.length > 0) {
                    const itunesNamespace = "http://www.itunes.com/dtds/podcast-1.0.dtd";
                    let html = '';
                    
                    items.forEach(item => {
                        const title = item.querySelector("title")?.textContent || "The Reverb Episode";
                        const guid = item.querySelector("guid")?.textContent || "";
                        const pubDate = item.querySelector("pubDate")?.textContent || "";
                        const spotifyUrl = item.querySelector("link")?.textContent || "#";
                        const description = item.querySelector("description")?.textContent || "";
                        const audioUrl = item.querySelector("enclosure")?.getAttribute("url") || "";
                        
                        const durationElement = item.getElementsByTagNameNS(itunesNamespace, "duration")[0];
                        const duration = durationElement ? durationElement.textContent : "5:00";
                        
                        const imageElement = item.getElementsByTagNameNS(itunesNamespace, "image")[0];
                        const thumb = imageElement ? imageElement.getAttribute("href") : "/assets/img/podcast-logo.png";
                        
                        const dateObj = new Date(pubDate);
                        const formattedDate = dateObj.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
                        
                        // Clean and Decode description
                        const decoder = document.createElement('div');
                        decoder.innerHTML = description;
                        const decodedDesc = decoder.textContent || decoder.innerText || "";
                        const cleanDesc = decodedDesc.replace(/<[^>]*>?/gm, '').replace(/&quot;/g, '"').trim();
                        // Ensure space after quotes if needed
                        const formattedDesc = cleanDesc.replace(/"([A-Z])/g, '" $1');
                        const shortDesc = formattedDesc.substring(0, 180) + (formattedDesc.length > 180 ? '...' : '');

                        html += `
                            <div class="episode-card group relative flex flex-col sm:flex-row gap-6 p-6 rounded border border-[var(--rule)] bg-[var(--paper)] hover:border-[var(--ink)] transition-all animate-enter" 
                                 data-episode-id="${guid}" 
                                 data-title="${title}" 
                                 data-meta="${formattedDate} • ${duration}" 
                                 data-thumb="${thumb}"
                                 data-audio-url="${audioUrl}">
                                
                                <div class="w-full aspect-square sm:w-40 sm:h-40 flex-shrink-0 bg-[var(--paper)] rounded border border-[var(--rule)] overflow-hidden relative group/art cursor-pointer" onclick="if(window.openLightbox) openLightbox('${thumb}')">
                                    <img src="${thumb}" alt="${title}" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
                                    
                                    ${audioUrl ? `
                                    <button class="play-btn absolute inset-0 flex items-center justify-center bg-[var(--ink)]/40 opacity-0 group-hover/art:opacity-100 transition-opacity text-[var(--paper)]">
                                        <div class="play-icon w-12 h-12 flex items-center justify-center rounded-full border-2 border-[var(--paper)]">
                                            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                                                <path d="M8 5v14l11-7z"/>
                                            </svg>
                                        </div>
                                    </button>
                                    ` : ''}
                                </div>
                                
                                <div class="flex-1 flex flex-col justify-between">
                                    <div>
                                        <div class="flex items-center gap-3 text-[10px] uppercase font-bold tracking-widest text-[var(--muted)] mb-2 text-neutral-400">
                                             <span>${formattedDate}</span>
                                             <span class="w-1 h-1 rounded-full bg-[var(--rule)]"></span>
                                             <span>${duration}</span>
                                        </div>
                                        <h3 class="font-serif text-xl sm:text-2xl mb-2 text-[var(--ink)] group-hover:accent-text transition-colors">${title}</h3>
                                        <p class="text-[14px] text-[var(--muted)] leading-relaxed mb-4">${shortDesc}</p>
                                    </div>
                                    
                                    <div class="flex flex-wrap items-center justify-between gap-4 mt-auto">
                                        <div class="flex flex-wrap gap-2">
                                            <a href="${spotifyUrl}" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--rule)] text-[10px] font-bold uppercase tracking-widest hover:bg-[#1DB954] hover:text-white hover:border-[#1DB954] transition-all">
                                                Spotify
                                            </a>
                                            <a href="https://podcasts.apple.com/gh/podcast/the-reverb/id1884282478" target="_blank" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--rule)] text-[10px] font-bold uppercase tracking-widest hover:bg-[#8e3ee5] hover:text-white hover:border-[#8e3ee5] transition-all">
                                                Apple
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    
                    if (archive) {
                        archive.innerHTML = html;
                        // Trigger visibility for dynamically added items
                        archive.querySelectorAll('.animate-enter').forEach(el => {
                            setTimeout(() => el.classList.add('visible'), 50);
                        });
                        initPodcastActions();
                    }
                    if (countDisplay) {
                        countDisplay.textContent = `${items.length} Episodes`;
                    }
                }
            } catch (e) {
                console.error("Failed to fetch podcast archive:", e);
                if (errorDisplay) {
                   errorDisplay.textContent = "Failed to load archive. Please try refreshing.";
                   errorDisplay.classList.remove('hidden');
                }
            }
        }

        function initPodcastActions() {
            document.querySelectorAll('.play-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const card = btn.closest('.episode-card');
                    if (card) {
                        const id = card.dataset.episodeId || '';
                        const url = card.dataset.audioUrl || '';
                        const title = card.dataset.title || '';
                        const meta = card.dataset.meta || '';
                        const thumb = card.dataset.thumb || '';
                        if (window.playEpisode) {
                            window.playEpisode(id, url, title, meta, thumb);
                        }
                    }
                });
            });
        }

        // Initialize on both direct load and view transitions
        document.addEventListener('astro:page-load', fetchPodcastArchive);
    </script>
</Layout>
