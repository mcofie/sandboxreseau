---
import Layout from '../layouts/Layout.astro';
import FaqList from '../components/FaqList.astro';

const facts = [
    { value: '6–8', label: 'Founders' },
    { value: '5 min', label: 'Per pitch' },
    { value: '3 min', label: 'Q&A' },
    { value: '1', label: 'Stage' },
];

const timeline = [
    { date: 'Nov 2026', label: 'Applications open', desc: 'Submit your startup for consideration. Open to all builders in the ecosystem.' },
    { date: 'Dec 2026', label: 'Shortlist announced', desc: '6–8 founders are selected to pitch based on traction, team, and market potential.' },
    { date: 'Jan 2027', label: 'Pitch prep', desc: 'Selected founders get mentorship, rehearsals, and feedback from past founders.' },
    { date: 'Feb 2027', label: 'The Pitch, live', desc: 'One stage. Real judges. A live audience. The founders pitch for real.' },
];

const criteria = [
    { title: 'Traction', desc: 'Show us what you’ve built and who’s using it. Users, revenue, or validated demand.' },
    { title: 'Team', desc: 'Who’s building this? We back founders who can ship and iterate.' },
    { title: 'Market', desc: 'Is this a real problem? How big is the opportunity?' },
    { title: 'Clarity', desc: 'Can you explain what you do in 60 seconds? Signal, not fluff.' },
];

const faqs = [
    { question: 'Who can apply?', answer: 'Any early-stage founder building a product, based in Ghana, West Africa, or the diaspora.' },
    { question: 'What stage should my startup be at?', answer: 'Pre-seed to seed. You should have a working product or strong prototype with some validation.' },
    { question: 'Do I need a pitch deck?', answer: 'Not for the application. If selected, you’ll pitch live on stage. Slides optional.' },
    { question: 'What do winners get?', answer: 'Details on prizes, mentorship, and exposure will be announced in November.' },
    { question: 'Is there a fee?', answer: 'No. The Pitch is free to apply and free to attend.' },
];
---

<Layout
    title="The Pitch | Sandbox Réseau"
    description="The Pitch is Sandbox Réseau's pitch competition. 6–8 founders. One stage. Real judges. Coming February 2027."
    image="/assets/img/gallery-v3-8.jpg"
    imageAlt="The main stage at a Sandbox Réseau edition in Accra"
>
    <main class="pitch-page">
        <section class="pitch-hero" data-dark-hero aria-labelledby="pitch-title">
            <div class="pitch-hero-frame">
                <img src="/assets/img/gallery-v3-8.webp" alt="" fetchpriority="high" decoding="async" />
                <div class="pitch-hero-copy">
                    <span class="pitch-pill"><span class="pitch-dot" aria-hidden="true"></span>February 2027 · Accra</span>
                    <h1 id="pitch-title">The Pitch.</h1>
                    <p>6–8 founders. One stage. Real judges. A live audience of builders, investors, and operators. No fluff. Just what you’re building and why it matters.</p>
                    <div class="pitch-hero-actions">
                        <span class="pitch-status">Applications open November 2026</span>
                        <a class="pitch-glass" href="#format">See the format</a>
                    </div>
                </div>
            </div>
        </section>

        <dl class="pitch-facts">
            {facts.map((fact) => (
                <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                </div>
            ))}
        </dl>

        <section class="pitch-split" id="format" aria-labelledby="pitch-format-title">
            <div class="pitch-card pitch-card-copy">
                <h2 id="pitch-format-title">A stage that matches your ambition.</h2>
                <p>The Pitch is Sandbox Réseau’s flagship pitch competition: a live event where early-stage founders present their startups to a panel of judges and a room full of builders, operators, and investors.</p>
                <p>It’s not a demo day. It’s not a panel. It’s a stage. You have 5 minutes to make your case, followed by 3 minutes of real questions from people who’ve been in the trenches.</p>
            </div>
            <div class="pitch-card pitch-card-timeline">
                <h2>The timeline.</h2>
                <ol>
                    {timeline.map((step) => (
                        <li>
                            <span class="pitch-step-date">{step.date}</span>
                            <h3>{step.label}</h3>
                            <p>{step.desc}</p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <section class="pitch-section" aria-labelledby="pitch-criteria-title">
            <h2 id="pitch-criteria-title">What we look for.</h2>
            <p class="pitch-lede">Our evaluation criteria for the shortlist.</p>
            <div class="pitch-criteria">
                {criteria.map((item, index) => (
                    <article>
                        <span class="pitch-number">{String(index + 1).padStart(2, '0')}</span>
                        <h3>{item.title}</h3>
                        <p>{item.desc}</p>
                    </article>
                ))}
            </div>
        </section>

        <section class="pitch-section" aria-labelledby="pitch-faq-title">
            <h2 id="pitch-faq-title">Questions, answered.</h2>
            <div class="pitch-faq"><FaqList items={faqs} idPrefix="pitch-faq" /></div>
        </section>

        <section class="pitch-cta" aria-labelledby="pitch-cta-title">
            <div class="pitch-cta-card cta-doodles">
                <h2 id="pitch-cta-title">Building something worth pitching?</h2>
                <p>Applications open in November 2026. Join the community to hear first and start building in public today.</p>
                <a class="pitch-cta-button" href="https://discord.gg/RMcBDRrV7x" target="_blank" rel="noreferrer">
                    Join the Discord
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
                </a>
            </div>
        </section>
    </main>
</Layout>

<style>
    .pitch-page{font-family:Inter,system-ui,sans-serif;color:#0a0a0a}
    .pitch-hero{padding:16px 16px 0}
    .pitch-hero-frame{position:relative;isolation:isolate;display:flex;align-items:flex-end;min-height:min(78vh,720px);max-width:1920px;margin:0 auto;overflow:hidden;border-radius:28px;background:#111;color:#fff}
    .pitch-hero-frame>img{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover}
    .pitch-hero-frame::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,.45) 0%,rgba(0,0,0,.2) 40%,rgba(0,0,0,.75) 100%)}
    .pitch-hero-copy{width:100%;max-width:1040px;margin:0 auto;padding:160px 32px 56px}
    .pitch-pill{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,.15);color:rgba(255,255,255,.85);font-size:13px;font-weight:500;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
    .pitch-dot{width:7px;height:7px;border-radius:50%;background:#d3fa69}
    .pitch-hero h1{margin:24px 0 0;font-size:clamp(3rem,1.8rem + 5vw,6rem);font-weight:600;line-height:.98;letter-spacing:-.04em}
    .pitch-hero-copy>p{max-width:48ch;margin:20px 0 0;color:rgba(255,255,255,.8);font-size:17px;font-weight:500;line-height:1.5}
    .pitch-hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
    .pitch-status{display:inline-flex;align-items:center;height:40px;padding:0 18px;border-radius:999px;background:#fff;color:#0a0a0a;font-size:14px;font-weight:500}
    .pitch-glass{display:inline-flex;align-items:center;height:40px;padding:0 18px;border:1px solid rgba(255,255,255,.3);border-radius:999px;background:rgba(255,255,255,.1);color:#fff;font-size:14px;font-weight:500;text-decoration:none;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);transition:background-color .2s}
    .pitch-glass:hover{background:rgba(255,255,255,.2)}
    .pitch-facts{display:grid;grid-template-columns:repeat(4,1fr);max-width:976px;margin:16px auto 0;overflow:hidden;border:1px solid rgba(10,10,10,.1);border-radius:20px}
    .pitch-facts div{display:flex;flex-direction:column;padding:24px;border-left:1px solid rgba(10,10,10,.1)}
    .pitch-facts div:first-child{border-left:0}
    .pitch-facts dd{order:-1;margin:0;font-size:clamp(1.5rem,1.2rem + 1vw,2rem);font-weight:600;letter-spacing:-.02em}
    .pitch-facts dt{margin-top:4px;color:#a1a1a1;font-size:14px}
    .pitch-split{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:1040px;margin:0 auto;padding:96px 32px 0;scroll-margin-top:80px}
    .pitch-card{padding:56px;border-radius:28px}
    .pitch-card h2,.pitch-section>h2,.pitch-cta-card h2{margin:0;font-size:clamp(1.5rem,1.15rem + 1.5vw,2.25rem);font-weight:600;line-height:1.1;letter-spacing:-.015em;text-wrap:balance}
    .pitch-card-copy{background:#f5f5f5}
    .pitch-card-copy h2{max-width:16ch}
    .pitch-card-copy p{max-width:40ch;margin:20px 0 0;color:#6b6b6b;font-size:17px;line-height:1.55}
    .pitch-card-timeline{background:#111;color:#fff}
    .pitch-card-timeline ol{margin:32px 0 0;padding:0;list-style:none}
    .pitch-card-timeline li{position:relative;padding:0 0 28px 28px}
    .pitch-card-timeline li:last-child{padding-bottom:0}
    .pitch-card-timeline li::before{content:'';position:absolute;top:6px;left:0;width:9px;height:9px;border-radius:50%;background:#d3fa69}
    .pitch-card-timeline li:not(:last-child)::after{content:'';position:absolute;top:22px;bottom:4px;left:4px;width:1px;background:rgba(255,255,255,.2)}
    .pitch-step-date{color:rgba(255,255,255,.55);font-size:13px;font-weight:500}
    .pitch-card-timeline h3{margin:4px 0 0;font-size:18px;font-weight:600}
    .pitch-card-timeline p{margin:6px 0 0;color:rgba(255,255,255,.7);font-size:15px;line-height:1.5}
    .pitch-section{max-width:1040px;margin:0 auto;padding:112px 32px 0}
    .pitch-lede{margin:16px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .pitch-criteria{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:48px}
    .pitch-criteria article{padding:28px;border:1px solid rgba(10,10,10,.1);border-radius:28px;transition:border-color .3s}
    .pitch-criteria article:hover{border-color:rgba(10,10,10,.25)}
    .pitch-number{display:inline-flex;align-items:center;justify-content:center;height:28px;padding:0 8px;border:1px solid rgba(10,10,10,.1);border-radius:999px;color:#6b6b6b;font-size:13px;font-weight:600;font-variant-numeric:tabular-nums}
    .pitch-criteria h3{margin:20px 0 0;font-size:19px;font-weight:600}
    .pitch-criteria p{margin:8px 0 0;color:#6b6b6b;font-size:15px;line-height:1.5}
    .pitch-faq{margin-top:48px}
    .pitch-cta{max-width:1040px;margin:0 auto;padding:112px 32px 64px}
    .pitch-cta-card{display:flex;flex-direction:column;align-items:center;padding:72px 32px;border-radius:28px;background:#f5f5f5;text-align:center}
    .pitch-cta-card p{max-width:46ch;margin:16px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .pitch-cta-button{display:inline-flex;align-items:center;gap:10px;height:48px;margin-top:32px;padding:0 28px;border-radius:999px;background:#0a0a0a;color:#fff;font-size:16px;font-weight:600;text-decoration:none;transition:background-color .2s,transform .2s}
    .pitch-cta-button:hover{background:rgba(10,10,10,.9)}.pitch-cta-button:active{transform:scale(.99)}
    @media(max-width:1023px){.pitch-facts{margin:16px 32px 0}.pitch-split{grid-template-columns:1fr}.pitch-criteria{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:639px){.pitch-hero{padding:12px 12px 0}.pitch-hero-frame{min-height:84svh}.pitch-hero-copy{padding:140px 24px 40px}.pitch-facts{grid-template-columns:1fr 1fr;margin:12px 24px 0}.pitch-facts div:nth-child(odd){border-left:0}.pitch-facts div:nth-child(n+3){border-top:1px solid rgba(10,10,10,.1)}.pitch-split{padding:64px 24px 0}.pitch-card{padding:32px 24px}.pitch-section{padding:80px 24px 0}.pitch-criteria{grid-template-columns:1fr}.pitch-cta{padding:80px 24px 48px}.pitch-cta-card{padding:56px 24px}}
</style>
