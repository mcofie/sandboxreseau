---
import Layout from '../layouts/Layout.astro';
import editions from '../data/editions.json';
import gallery from '../data/gallery.json';
import { Image } from 'astro:assets';

const nextEdition = editions.find(e => e.status === 'In Preparation') || editions[0];
const galleryPreview = gallery.slice(0, 4);
---

<Layout>
    <section class="border-b border-[var(--rule)]">
        <div class="mx-auto grid max-w-[1100px] grid-cols-1 gap-6 px-4 py-6 md:grid-cols-2">
            <!-- Hero copy -->
            <div class="flex flex-col justify-center">
                <span
                    class="inline-block w-max border-y border-[var(--rule)] px-2 py-1 text-[11px] font-semibold uppercase tracking-[.2em] text-[color:color-mix(in_oklab,var(--ink)_45%,var(--paper)_55%)]">
                    Front Page
                </span>
                <h2 class="mt-3 font-serif text-3xl leading-tight sm:text-4xl">
                    A meetup where ambitious builders learn in public — and ship faster together.
                </h2>
                <p class="mt-2 text-[16px] text-neutral-600">
                    Builder demos, mini-talks, and open networking. Signal over noise; progress over polish.
                </p>

                <div class="mt-4 flex flex-wrap gap-2">
                    <a href="https://luma.com/sandbox-reseau" target="_blank" rel="noreferrer"
                        class="rounded bg-[var(--ink)] px-4 py-2 text-sm text-[var(--paper)] hover:opacity-90">Register
                        on
                        Luma</a>
                    <a href="#format"
                        class="rounded border accent-border px-4 py-2 text-sm accent-text hover:accent-hover">See the
                        format</a>
                </div>
            </div>

            <!-- Hero image -->
            <figure class="relative h-full w-full overflow-hidden rounded border border-[var(--rule)] hatch">
                <img src="/assets/img/RNBL3150.jpg" alt="Sandbox Réseau in Accra." fetchpriority="high" decoding="sync"
                    class="aspect-[16/10] h-full w-full object-cover grayscale" />
                <figcaption class="mt-2 text-[13px] text-[color:color-mix(in_oklab,var(--ink)_65%,var(--paper)_35%)]">
                    <em class="font-serif">Attendees connect during Sandbox Réseau in Accra.</em>
                    <span class="small-caps"> Photograph by Sandbox Team</span>.
                </figcaption>
            </figure>
        </div>
    </section>

    <!-- “In this issue” horizontal strip -->
    <section id="secondaryNav" class="sticky-secondary border-b border-[var(--rule)]">
        <div class="mx-auto max-w-[1100px] px-4 py-3">
            <div
                class="mb-2 text-xs font-semibold uppercase tracking-widest text-[var(--muted)] flex items-center justify-between">
                <span>In this issue</span>
                <span class="font-serif capitalize text-[11px] opacity-0 transition-opacity duration-300"
                    id="readingState">Page 1 / Digest</span>
            </div>
            <div class="flex snap-x snap-mandatory gap-3 overflow-x-auto pb-1 no-scrollbar">
                <a href="#about"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">About
                    Réseau</a>
                <a href="#format"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">Format</a>
                <a href="#details"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">Details</a>
                <a href="#faq"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">FAQ</a>
                <a href="/podcast"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">Podcast</a>
                <a href="/editions"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">Editions</a>
                <a href="/newsletters"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">Newsletters</a>
                <a href="/community"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">Community</a>
                <a href="/registry"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">Registry</a>
                <a href="/handbook"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">Handbook</a>
                <a href="#register"
                    class="snap-start whitespace-nowrap rounded-full border border-[var(--rule)] px-3 py-1 text-xs chip-hover hover:accent-text">Register</a>
            </div>
        </div>
        <div class="scroll-progress-container">
            <div class="scroll-progress-bar" id="progressBar"></div>
        </div>
    </section>

    <!-- Main: article stream + sticky right rail -->
    <main class="mx-auto max-w-[1100px] px-4">
        <div class="grid grid-cols-1 gap-8 py-6 lg:grid-cols-[1fr_320px]">
            <!-- Article stream -->
            <div class="space-y-8">
                <article id="about" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight tracking-[-.005em]">What Is Sandbox Réseau?
                    </h3>
                    <p class="text-neutral-600">A calm, intentional meetup where builders learn in public and find
                        collaborators.</p>
                    <div class="mb-2 text-[13px] text-neutral-500">From the Event Brief</div>
                    <p><strong>Sandbox Réseau</strong> brings together builders, thinkers, and makers shaping the next
                        wave
                        of innovation in Africa. It celebrates connection, collaboration, and creation.</p>
                    <p>Developers, designers, founders, and product lovers share work, showcase prototypes, and learn
                        from
                        practical lessons in the open.</p>
                </article>

                <article id="format" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Format at a Glance</h3>
                    <p class="text-neutral-600">Three simple blocks that keep attention on the work.</p>
                    <ul class="ml-5 list-disc font-sans">
                        <li><strong>Builder Demos</strong> — 5–7 minutes on live projects or prototypes. Decisions,
                            trade-offs, next steps.
                        </li>
                        <li><strong>Mini-Talks</strong> — compact insights from product, design, and engineering.</li>
                        <li><strong>Open Network</strong> — generous time to meet collaborators and swap ideas.</li>
                    </ul>
                </article>

                <article class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Why It Exists</h3>
                    <p class="text-neutral-600">Signal over noise; progress over polish.</p>

                    <blockquote
                        class="my-3 border-l-[3px] accent-border bg-[color:color-mix(in_oklab,var(--paper)_92%,var(--ink)_8%)] px-3.5 py-2 font-serif text-[18px] leading-[1.5]">
                        “No hype. Just signal.”
                    </blockquote>

                    <p>Réseau creates a trusted room to learn in public with feedback, momentum, and a network that
                        actually
                        ships.</p>
                </article>

                <article class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Who’s It For?</h3>
                    <p class="text-neutral-600">Engineers, designers, founders, data/ML folks, indie makers — and the
                        product-curious.</p>
                    <p>Beginner-friendly by design. Curiosity and a builder’s mindset are enough.</p>
                </article>

                <article id="details" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Details & Logistics</h3>
                    <p><strong>When:</strong> Dates announced on Luma. <a class="underline accent-text"
                            href="https://luma.com/sandbox-reseau" target="_blank" rel="noreferrer">Check schedule</a>.
                    </p>
                    <p><strong>Where:</strong> Accra. Venue shared with confirmed guests to keep the room intentional.
                    </p>
                    <p><strong>Capacity:</strong> Kept tight for focused conversations; early RSVP recommended.</p>
                    <p><strong>Demos:</strong> Indicate interest on RSVP; we curate 3–5 per edition.</p>
                    <p><strong>Code of Conduct:</strong> Be kind, be specific, credit work, respect time.</p>
                </article>

                <article class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Previous Editions</h3>
                    <p class="text-neutral-600">Snapshots from our last meetup. See the vibe for yourself.</p>

                    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-2">
                        {galleryPreview.map((img, i) => (
                            <div class="group relative aspect-square w-full overflow-hidden rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_90%,var(--ink)_10%)] animate-enter">
                                <img 
                                    src={`/assets/img/event-${i + 1}.jpg`} 
                                    alt={img.title || `Event photo ${i + 1}`} 
                                    onclick={`openLightbox('/assets/img/event-${i + 1}.jpg')`}
                                    loading="lazy" 
                                    decoding="async"
                                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105 cursor-zoom-in" 
                                />
                            </div>
                        ))}
                    </div>
                    <p class="mt-2 text-[13px] text-neutral-500 ">Want only high-signal connection? Join the next
                        one.</p>
                    <div class="mt-3">
                        <a href="/gallery"
                            class="inline-flex items-center gap-1 text-sm font-semibold underline decoration-[var(--rule)] underline-offset-2 hover:decoration-2">
                            View Full Gallery <span>→</span>
                        </a>
                    </div>
                </article>

                <article id="podcast" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Tune In: The Reverb</h3>
                    <p class="text-neutral-600">The high-bandwidth audio-log for the African builder.</p>
                    
                    <div class="mt-4 flex flex-col gap-6 sm:flex-row">
                        <div class="w-full sm:w-1/3">
                            <img src="/assets/img/podcast-logo.png" alt="The Reverb Podcast Logo" class="w-full rounded border border-[var(--rule)] shadow-sm" />
                        </div>
                        <div class="flex-1">
                            <p>Most tech podcasts are too long—<strong>The Reverb</strong> is built for the fast lane. Every 5-minute episode stitches together unfiltered voices from the Sandbox Réseau ecosystem. Hosted by Maxwell Cofie.</p>
                            <p class="mt-2">No fluff. Just the raw "reverb" of building in the 233. Plug in, sync up, and get back to building.</p>
                            
                            <div class="mt-4 flex flex-wrap gap-3">
                                <a href="https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN" target="_blank" rel="noreferrer"
                                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-3 py-1.5 text-xs font-semibold uppercase tracking-wider hover:bg-[var(--accent)] hover:text-white transition-colors">
                                    Listen on Spotify
                                </a>
                                <a href="https://podcasts.apple.com/gh/podcast/the-reverb/id1884282478" target="_blank" rel="noreferrer"
                                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-3 py-1.5 text-xs font-semibold uppercase tracking-wider hover:bg-[var(--accent)] hover:text-white transition-colors">
                                    Apple Podcasts
                                </a>
                            </div>
                        </div>
                    </div>
                </article>

                <article id="faq" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">FAQ</h3>
                    <ul class="ml-5 list-disc font-sans">
                        <li><strong>Beginner-friendly?</strong> Yes.</li>
                        <li><strong>Finished product required?</strong> No — prototypes welcome.</li>
                        <li><strong>Pitches?</strong> Keep it useful and grounded; salesy pitches discouraged.</li>
                        <li><strong>Recordings?</strong> We prioritize candour; we’ll publish notes where possible.</li>
                        <li><strong>Cadence?</strong> Recurring — watch the Luma page.</li>
                    </ul>
                </article>

                <article id="register" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Register</h3>
                    <p>Reserve your seat on Luma to receive date announcements, venue details, and demo sign-up links.
                    </p>
                    <p><a class="underline accent-text" href="https://luma.com/sandbox-reseau" target="_blank"
                            rel="noreferrer">Register
                            on Luma →</a></p>
                </article>
            </div>

            <!-- Sticky right rail -->
            <aside class="top-6 h-max space-y-4 lg:sticky">
                <div
                    class="rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_92%,var(--ink)_8%)] p-4">
                    <h4 class="m-0 font-serif text-lg">At a Glance</h4>
                    <ul class="mt-2 grid gap-2 text-[15px] leading-6 font-sans">
                        <li><strong>About Réseau</strong> — the origin, purpose, vibe.</li>
                        <li><strong>Format</strong> — demos, mini-talks, network.</li>
                        <li><strong>Details</strong> — when, where, how to demo.</li>
                        <li><strong>Podcast</strong> — the high-bandwidth audio-log.</li>
                        <li><strong>FAQ</strong> — beginner-friendly, cadence, notes.</li>
                    </ul>
                    <a href="https://luma.com/sandbox-reseau" target="_blank" rel="noreferrer"
                        class="mt-3 inline-block rounded accent-bg px-3.5 py-2 text-sm text-white hover:opacity-90">
                        Register on Luma
                    </a>
                </div>

                <div class="rounded border border-[var(--rule)] p-4">
                    <h4 class="m-0 font-serif text-lg">Next Edition: {nextEdition.title}</h4>
                    <p class="mt-2 text-sm text-neutral-600">{nextEdition.date} — {nextEdition.description}</p>
                    <a href="/editions" class="text-sm underline accent-text">View details →</a>
                </div>
            </aside>
        </div>
    </main>

    <script is:inline define:vars={{ galleryStrings: gallery.map(img => img.url) }}>
        // Set up gallery images for lightbox
        window.GALLERY_IMAGES = galleryStrings;

        // Scroll & Sticky Logic
        (function () {
            const secondaryNav = document.getElementById('secondaryNav');
            const progressBar = document.getElementById('progressBar');
            const readingState = document.getElementById('readingState');
            const sections = document.querySelectorAll('article[id]');

            if (!secondaryNav) return;

            const navTop = secondaryNav.offsetTop;

            function handleScroll() {
                const scrolled = window.scrollY;

                // Sticky class
                if (scrolled > navTop) {
                    secondaryNav.classList.add('is-stuck');
                    if (readingState) readingState.style.opacity = '1';
                } else {
                    secondaryNav.classList.remove('is-stuck');
                    if (readingState) readingState.style.opacity = '0';
                }

                // Progress Bar
                const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
                const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                const scrolledPercent = (winScroll / height) * 100;
                if (progressBar) progressBar.style.width = scrolledPercent + "%";

                // Active Section
                let currentSection = "Digest";
                sections.forEach(section => {
                    const sectionTop = section.offsetTop - 100;
                    if (scrolled >= sectionTop) {
                        currentSection = section.getAttribute('id') || "Digest";
                    }
                });

                if (readingState) {
                    readingState.textContent = `Section: ${currentSection.replace('-', ' ')}`;
                }
            }

            window.addEventListener('scroll', handleScroll);
            handleScroll(); // Init
        })();
    </script>
</Layout>
