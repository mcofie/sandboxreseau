---
import Layout from '../layouts/Layout.astro';
import editions from '../data/editions.json';
import gallery from '../data/gallery.json';
import { Image } from 'astro:assets';

const nextEdition = editions.find(e => e.status === 'In Preparation') || editions[0];
const galleryPreview = gallery.slice(0, 4);
---

<Layout>
    <section class="border-b border-[var(--rule)]">
        <div class="mx-auto grid max-w-[1100px] grid-cols-1 gap-6 px-4 py-6 md:grid-cols-2">
            <!-- Hero copy -->
            <div class="flex flex-col justify-center">
                <span
                    class="inline-block w-max border-y border-[var(--rule)] px-2 py-1 text-[11px] font-semibold uppercase tracking-[.2em] text-[color:color-mix(in_oklab,var(--ink)_45%,var(--paper)_55%)]">
                    Front Page
                </span>
                <h2 class="mt-3 font-serif text-3xl leading-tight sm:text-4xl">
                    Where Africa’s founders and builders connect, collaborate, and shape the future.
                </h2>
                <p class="mt-2 text-[16px] text-neutral-600">
                    Builder demos, mini-talks, and open networking. Signal over noise; progress over polish.
                </p>

                <div class="mt-4 flex flex-wrap gap-2">
                    <a href="https://luma.com/sandbox-reseau" target="_blank" rel="noreferrer"
                        class="rounded bg-[var(--ink)] px-4 py-2 text-sm text-[var(--paper)] hover:opacity-90">Register
                        on
                        Luma</a>
                    <a href="#format"
                        class="rounded border accent-border px-4 py-2 text-sm accent-text hover:accent-hover">See the
                        format</a>
                </div>
            </div>

            <!-- Hero image -->
            <figure class="relative h-full w-full overflow-hidden rounded border border-[var(--rule)] hatch">
                <img src="/assets/img/RNBL3150.jpg" alt="Sandbox Réseau in Accra." fetchpriority="high" decoding="sync"
                    class="aspect-[16/10] h-full w-full object-cover grayscale" />
                <figcaption class="mt-2 text-[13px] text-[color:color-mix(in_oklab,var(--ink)_65%,var(--paper)_35%)]">
                    <em class="font-serif">Attendees connect during Sandbox Réseau in Accra.</em>
                    <span class="small-caps"> Photograph by Sandbox Team</span>.
                </figcaption>
            </figure>
        </div>
    </section>



    <!-- Main: article stream + sticky right rail -->
    <main class="mx-auto max-w-[1100px] px-4">
        <div class="grid grid-cols-1 gap-8 py-6 lg:grid-cols-[1fr_320px]">
            <!-- Article stream -->
            <div class="space-y-8">
                <article id="about" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight tracking-[-.005em]">A Space for Founders, Builders & Makers</h3>
                    <p class="text-neutral-600">Where sandbox experimentation meets intentional networking.</p>
                    <div class="mb-2 text-[13px] text-neutral-500">The Brief Overview</div>
                    <p><strong>Sandbox Réseau</strong> is a creative-tech meetup designed to bring together builders, thinkers, and makers who are shaping the next wave of innovation in Africa.</p>
                    <p>Born from the spirit of <em>sandbox experimentation</em> and the French word <em>“réseau”</em> — meaning <em>network</em> — this event celebrates connection, collaboration, and creation.</p>
                    <p>It’s a space where developers, designers, founders, and product lovers step out of their silos to share ideas, showcase what they’re building, and find new energy in community.</p>
                </article>

                <article id="purpose" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">The Purpose</h3>
                    <p class="text-neutral-600">Nurturing a network of curious minds who build the future.</p>
                    <p>Sandbox Réseau exists to:</p>
                    <ul class="ml-5 list-disc font-sans">
                        <li><strong>Connect</strong> creators across disciplines.</li>
                        <li><strong>Inspire</strong> through shared stories, projects, and challenges.</li>
                        <li><strong>Collaborate</strong> on new ideas and ventures born from genuine connection.</li>
                    </ul>
                </article>

                <article id="format" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">The Experience</h3>
                    <p class="text-neutral-600">Intimate, thoughtful, and electric — a blend of knowledge and culture.</p>
                    <ul class="ml-5 list-disc font-sans">
                        <li><strong>Builder Demos</strong> — real projects, raw prototypes, honest lessons.</li>
                        <li><strong>Mini-Talks & Firesides</strong> — short, punchy insights from innovators.</li>
                        <li><strong>Open Network Sessions</strong> — meet, mingle, and connect intentionally.</li>
                        <li><strong>Showcase Wall</strong> — where attendees post what they’re working on or what help they need.</li>
                    </ul>
                </article>

                <article class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Who’s It For?</h3>
                    <p class="text-neutral-600">Engineers, designers, founders, data/ML folks, indie makers — and the
                        product-curious.</p>
                    <p>Beginner-friendly by design. Curiosity and a builder’s mindset are enough.</p>
                </article>

                <article id="highlights" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Visual Dispatch</h3>
                    <p class="text-neutral-600">A glimpse into the energy and conversations at Sandbox Réseau.</p>
                    <div class="mt-4 aspect-video overflow-hidden rounded border border-[var(--rule)] bg-black hatch">
                        <iframe 
                            width="100%" 
                            height="100%" 
                            src="https://www.youtube.com/embed/qSOznAR_sLs" 
                            title="Sandbox Réseau Highlights" 
                            frameborder="0" 
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                            allowfullscreen
                            class="grayscale hover:grayscale-0 transition-all duration-700"
                        ></iframe>
                    </div>
                </article>

                <article id="details" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Details & Logistics</h3>
                    <p><strong>When:</strong> Dates announced on Luma. <a class="underline accent-text"
                            href="https://luma.com/sandbox-reseau" target="_blank" rel="noreferrer">Check schedule</a>.
                    </p>
                    <p><strong>Where:</strong> Accra. Venue shared with confirmed guests to keep the room intentional.
                    </p>
                    <p><strong>Capacity:</strong> Kept tight for focused conversations; early RSVP recommended.</p>
                    <p><strong>Demos:</strong> Indicate interest on RSVP; we curate 3–5 per edition.</p>
                    <p><strong>Code of Conduct:</strong> Be kind, be specific, credit work, respect time.</p>
                </article>

                <article class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Previous Editions</h3>
                    <p class="text-neutral-600">Snapshots from our last meetup. See the vibe for yourself.</p>

                    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                        {gallery.slice(0, 12).map((img, i) => (
                            <div class="group relative aspect-square w-full overflow-hidden rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_90%,var(--ink)_10%)] animate-enter">
                                <img 
                                    src={img.url} 
                                    alt={img.title || `Event photo ${i + 1}`} 
                                    onclick={`openLightbox('${img.url}')`}
                                    loading="lazy" 
                                    decoding="async"
                                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105 cursor-zoom-in" 
                                />
                            </div>
                        ))}
                    </div>
                    <p class="mt-2 text-[13px] text-neutral-500 ">Want only high-signal connection? Join the next
                        one.</p>
                    <div class="mt-3">
                        <a href="/gallery"
                            class="inline-flex items-center gap-1 text-sm font-semibold underline decoration-[var(--rule)] underline-offset-2 hover:decoration-2">
                            View Full Gallery <span>→</span>
                        </a>
                    </div>
                </article>

                <article id="podcast" class="prose-like">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="font-serif text-[28px] leading-tight m-0">Tune In: The Reverb</h3>
                        <span id="podcast-new-badge" class="hidden text-[10px] uppercase font-bold tracking-widest text-[var(--accent)] bg-[var(--accent)]/5 px-2 py-0.5 rounded border border-[var(--accent)]/10 animate-pulse">New Episode</span>
                    </div>
                    <p class="text-neutral-600">The high-bandwidth audio-log for the African builder.</p>
                    
                    <div id="podcast-loader" class="mt-4 flex flex-col gap-6 sm:flex-row animate-pulse">
                        <div class="w-full sm:w-1/3 aspect-square bg-neutral-200 rounded border border-[var(--rule)]"></div>
                        <div class="flex-1 space-y-3">
                            <div class="h-3 w-24 bg-neutral-200 rounded"></div>
                            <div class="h-6 w-3/4 bg-neutral-200 rounded"></div>
                            <div class="h-4 w-full bg-neutral-200 rounded"></div>
                            <div class="h-4 w-5/6 bg-neutral-200 rounded"></div>
                        </div>
                    </div>

                    <div id="podcast-content" class="hidden mt-4 flex flex-col gap-6 sm:flex-row">
                        <div class="w-full sm:w-1/3 group relative aspect-square sm:aspect-auto">
                            <img id="podcast-thumb" src="/assets/img/podcast-logo.png" alt="The Reverb Podcast Logo" class="w-full rounded border border-[var(--rule)] shadow-sm grayscale hover:grayscale-0 transition-all duration-700" />
                            <a id="podcast-play-link" href="/podcast" class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 bg-black/40 transition-opacity rounded">
                                <div class="w-12 h-12 rounded-full border-2 border-white flex items-center justify-center text-white">
                                     <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                </div>
                            </a>
                        </div>
                        <div class="flex-1 flex flex-col">
                            <div id="podcast-meta" class="flex items-center gap-2 text-[10px] uppercase font-bold tracking-widest text-neutral-400 mb-1">
                            </div>
                            <h4 id="podcast-title" class="font-serif text-xl mb-2 text-[var(--ink)] leading-snug"></h4>
                            <p id="podcast-desc" class="text-sm text-neutral-600 mb-4"></p>
                            
                            <div class="mt-auto flex flex-wrap gap-2">
                                <a id="podcast-spotify" href="https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN" target="_blank" rel="noreferrer"
                                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest hover:bg-[#1DB954] hover:text-white hover:border-[#1DB954] transition-all">
                                    Spotify
                                </a>
                                <a href="/podcast" 
                                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest hover:bg-[var(--ink)] hover:text-white transition-all">
                                    Archive
                                </a>
                            </div>
                        </div>
                    </div>
                </article>

                <article id="faq" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">FAQ</h3>
                    <ul class="ml-5 list-disc font-sans">
                        <li><strong>Beginner-friendly?</strong> Yes.</li>
                        <li><strong>Finished product required?</strong> No — prototypes welcome.</li>
                        <li><strong>Pitches?</strong> Keep it useful and grounded; salesy pitches discouraged.</li>
                        <li><strong>Recordings?</strong> We prioritize candour; we’ll publish notes where possible.</li>
                        <li><strong>Cadence?</strong> Recurring — watch the Luma page.</li>
                    </ul>
                </article>

                <article id="register" class="prose-like">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">Register</h3>
                    <p>Reserve your seat on Luma to receive date announcements, venue details, and demo sign-up links.
                    </p>
                    <p><a class="underline accent-text" href="https://luma.com/sandbox-reseau" target="_blank"
                            rel="noreferrer">Register
                            on Luma →</a></p>
                </article>
            </div>

            <!-- Sticky right rail -->
            <aside class="top-6 h-max space-y-4 lg:sticky">
                <div
                    class="rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_92%,var(--ink)_8%)] p-4">
                    <h4 class="m-0 font-serif text-lg">At a Glance</h4>
                    <ul class="mt-2 grid gap-2 text-[15px] leading-6 font-sans">
                        <li><strong>Overview</strong> — experimentation meets networking.</li>
                        <li><strong>Purpose</strong> — nurture a network of curious minds.</li>
                        <li><strong>Experience</strong> — demos, talks, and connection.</li>
                        <li><strong>Highlights</strong> — watch the visual dispatch.</li>
                        <li><strong>Details</strong> — when, where, how to demo.</li>
                        <li><strong>Podcast</strong> — the high-bandwidth audio-log.</li>
                        <li><strong>FAQ</strong> — beginner-friendly, cadence, notes.</li>
                    </ul>
                    <a href="https://luma.com/sandbox-reseau" target="_blank" rel="noreferrer"
                        class="mt-3 inline-block rounded accent-bg px-3.5 py-2 text-sm text-white hover:opacity-90">
                        Register on Luma
                    </a>
                </div>

                <div class="rounded border border-[var(--rule)] p-4">
                    <h4 class="m-0 font-serif text-lg">Next Edition: {nextEdition.title}</h4>
                    <p class="mt-2 text-sm text-neutral-600">{nextEdition.date} — {nextEdition.description}</p>
                    <a href="/editions" class="text-sm underline accent-text">View details →</a>
                </div>
            </aside>
        </div>
    </main>

    <script is:inline define:vars={{ galleryStrings: gallery.map(img => img.url) }}>
        // RSS Fetcher for Live Updates
        async function fetchLatestPodcast() {
            const loader = document.getElementById('podcast-loader');
            const content = document.getElementById('podcast-content');
            const badge = document.getElementById('podcast-new-badge');
            
            if (!loader || !content) return; // Not on a page with podcast section

            try {
                const rssUrl = `https://anchor.fm/s/110059518/podcast/rss?t=${Date.now()}`;
                const response = await fetch(rssUrl);
                const text = await response.text();
                const parser = new DOMParser();
                const xml = parser.parseFromString(text, "text/xml");
                const items = xml.querySelectorAll("item");
                
                if (items.length > 0) {
                    const firstItem = items[0];
                    const title = firstItem.querySelector("title")?.textContent || "The Reverb Episode";
                    const pubDate = firstItem.querySelector("pubDate")?.textContent || "";
                    const link = firstItem.querySelector("link")?.textContent || "https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN";
                    const description = firstItem.querySelector("description")?.textContent || "";
                    
                    // itunes:image
                    const itunesNamespace = "http://www.itunes.com/dtds/podcast-1.0.dtd";
                    const imageElement = firstItem.getElementsByTagNameNS(itunesNamespace, "image")[0];
                    const thumb = imageElement ? imageElement.getAttribute("href") : "/assets/img/podcast-logo.png";
                    
                    // Format date
                    const dateObj = new Date(pubDate);
                    const formattedDate = dateObj.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
                    
                    // Check if "new" (published in the last 7 days)
                    const isNew = (Date.now() - dateObj.getTime()) < (7 * 24 * 60 * 60 * 1000);
                    
                    // Clean and Decode description
                    const decoder = document.createElement('div');
                    decoder.innerHTML = description;
                    const decodedDesc = decoder.textContent || decoder.innerText || "";
                    const cleanDesc = decodedDesc.replace(/<[^>]*>?/gm, '').replace(/&quot;/g, '"').trim();
                    // Ensure space after quotes if needed
                    const formattedDesc = cleanDesc.replace(/"([A-Z])/g, '" $1');
                    const shortDesc = formattedDesc.substring(0, 150) + (formattedDesc.length > 150 ? '...' : '');

                    // Update DOM
                    const titleEl = document.getElementById('podcast-title');
                    const descEl = document.getElementById('podcast-desc');
                    const metaEl = document.getElementById('podcast-meta');
                    const thumbEl = document.getElementById('podcast-thumb');
                    const spotifyEl = document.getElementById('podcast-spotify');

                    if (titleEl) titleEl.textContent = title;
                    if (descEl) descEl.textContent = shortDesc;
                    if (metaEl) metaEl.innerHTML = `<span>Dispatch: ${formattedDate}</span>`;
                    if (thumbEl) thumbEl.src = thumb;
                    if (spotifyEl) spotifyEl.href = link;
                    
                    if (isNew && badge) badge.classList.remove('hidden');
                    
                    if (loader) loader.classList.add('hidden');
                    if (content) {
                        content.classList.remove('hidden');
                        // Trigger visibility logic
                        setTimeout(() => content.classList.add('visible'), 50);
                    }
                }
            } catch (e) {
                console.error("Failed to fetch live podcast:", e);
                // On error, we could show a fallback message or just keep it hidden
            }
        }

        document.addEventListener('astro:page-load', fetchLatestPodcast);

        // Set up gallery images for lightbox
        window.GALLERY_IMAGES = galleryStrings;

        // Scroll & Sticky Logic
        (function () {
            const secondaryNav = document.getElementById('secondaryNav');
            const progressBar = document.getElementById('progressBar');
            const readingState = document.getElementById('readingState');
            const sections = document.querySelectorAll('article[id]');

            if (!secondaryNav) return;

            const navTop = secondaryNav.offsetTop;

            function handleScroll() {
                const scrolled = window.scrollY;

                // Sticky class
                if (scrolled > navTop) {
                    secondaryNav.classList.add('is-stuck');
                    if (readingState) readingState.style.opacity = '1';
                } else {
                    secondaryNav.classList.remove('is-stuck');
                    if (readingState) readingState.style.opacity = '0';
                }

                // Progress Bar
                const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
                const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                const scrolledPercent = (winScroll / height) * 100;
                if (progressBar) progressBar.style.width = scrolledPercent + "%";

                // Active Section
                let currentSection = "Digest";
                sections.forEach(section => {
                    const sectionTop = section.offsetTop - 100;
                    if (scrolled >= sectionTop) {
                        currentSection = section.getAttribute('id') || "Digest";
                    }
                });

                if (readingState) {
                    readingState.textContent = `Section: ${currentSection.replace('-', ' ')}`;
                }
            }

            window.addEventListener('scroll', handleScroll);
            handleScroll(); // Init
        })();
    </script>
</Layout>
