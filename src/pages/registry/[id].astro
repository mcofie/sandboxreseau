---
import Layout from '../../layouts/Layout.astro';
import RegistryCard from '../../components/RegistryCard.astro';
import registry from '../../data/registry.json';

export function getStaticPaths() {
    return registry.map((company) => ({
        params: { id: company.id },
        props: { company },
    }));
}

const { company } = Astro.props;
const logo = company.logo.startsWith('assets/') ? `/${company.logo}` : company.logo;
const about = (company.longDescription || company.description).split('\n\n');

// Only show facts we actually have, rather than guessing defaults.
const facts = [
    { label: 'Industry', value: company.industry },
    { label: 'Founded', value: company.founded },
    { label: 'Team size', value: company.teamSize },
    { label: 'Funding', value: company.funding },
    { label: 'HQ', value: company.location },
].filter((fact) => fact.value);

const links = [
    { label: 'X / Twitter', href: company.socials?.twitter },
    { label: 'LinkedIn', href: company.socials?.linkedin },
].filter((link) => link.href);

// Same industry first, then shared tags.
const similar = registry
    .filter((item) => item.id !== company.id && (item.industry === company.industry || item.tags.some((tag) => company.tags.includes(tag))))
    .sort((a, b) => Number(b.industry === company.industry) - Number(a.industry === company.industry))
    .slice(0, 3);

const initials = (name: string) => name.split(' ').map((part) => part[0]).join('').slice(0, 2);
---

<Layout
    title={`${company.name} | Registry | Sandbox Réseau`}
    description={company.description}
>
    <main class="profile-page">
        <nav class="profile-crumbs" aria-label="Breadcrumb">
            <a href="/registry">Registry</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{company.name}</span>
        </nav>

        <section class="profile-hero" aria-labelledby="profile-name">
            <div class="profile-logo"><img src={logo} alt={`${company.name} logo`} width="112" height="112" decoding="async" /></div>
            <div class="profile-hero-copy">
                <div class="profile-badges">
                    {company.status === 'Live' && <span class="profile-badge"><span class="profile-dot" aria-hidden="true"></span>Live</span>}
                    <span class="profile-badge">{company.industry}</span>
                    <span class="profile-badge">{company.location}</span>
                </div>
                <h1 id="profile-name">{company.name}</h1>
                <p>{company.description}</p>
                <div class="profile-actions">
                    {company.url && (
                        <a class="profile-primary" href={company.url} target="_blank" rel="noopener noreferrer">
                            Visit website
                            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
                        </a>
                    )}
                    {links.map((link) => (
                        <a class="profile-secondary" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                    ))}
                </div>
            </div>
        </section>

        <dl class="profile-facts">
            {facts.map((fact) => (
                <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                </div>
            ))}
        </dl>

        <div class="profile-body">
            <section aria-labelledby="profile-about">
                <h2 id="profile-about">About {company.name}.</h2>
                <div class="profile-about">
                    {about.map((paragraph) => <p>{paragraph}</p>)}
                </div>
                {company.tags.length > 0 && (
                    <div class="profile-tags" aria-label="Tags">
                        {company.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                )}
            </section>

            <section aria-labelledby="profile-founders">
                <h2 id="profile-founders">{company.founders?.length === 1 ? 'Founder.' : 'Founders.'}</h2>
                {company.founders?.length ? (
                    <div class="profile-founders">
                        {company.founders.map((founder) => (
                            <article class="founder-card">
                                <div class="founder-head">
                                    <div class="founder-avatar">
                                        {founder.avatar ? <img src={founder.avatar} alt="" loading="lazy" /> : <span>{initials(founder.name)}</span>}
                                    </div>
                                    <div>
                                        <h3>{founder.name}</h3>
                                        <p>{founder.role}</p>
                                    </div>
                                </div>
                                {founder.bio && <p class="founder-bio">{founder.bio}</p>}
                                {(founder.twitter || founder.linkedin) && (
                                    <div class="founder-links">
                                        {founder.twitter && <a href={founder.twitter} target="_blank" rel="noopener noreferrer" aria-label={`${founder.name} on X`}>X</a>}
                                        {founder.linkedin && <a href={founder.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${founder.name} on LinkedIn`}>LinkedIn</a>}
                                    </div>
                                )}
                            </article>
                        ))}
                    </div>
                ) : (
                    <p class="profile-note">This startup is builder-led by Sandbox Réseau community members. If you’re on the team, drop a message in <strong>#show-your-work</strong> on Discord and we’ll add your profile here.</p>
                )}
            </section>
        </div>

        {similar.length > 0 && (
            <section class="profile-similar" aria-labelledby="profile-similar-title">
                <div class="profile-similar-head">
                    <h2 id="profile-similar-title">More builders like {company.name}.</h2>
                    <a href="/registry">
                        View all
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
                    </a>
                </div>
                <div class="profile-similar-grid">
                    {similar.map((item) => <RegistryCard company={item} />)}
                </div>
            </section>
        )}
    </main>
</Layout>

<style>
    .profile-page{max-width:1040px;margin:0 auto;padding:128px 32px 64px;font-family:Inter,system-ui,sans-serif;color:#0a0a0a}
    .profile-crumbs{display:flex;align-items:center;gap:8px;color:#a1a1a1;font-size:14px}
    .profile-crumbs a{color:#6b6b6b;text-decoration:none;transition:color .2s}
    .profile-crumbs a:hover{color:#0a0a0a}
    .profile-crumbs [aria-current]{color:#0a0a0a}
    .profile-hero{display:grid;grid-template-columns:auto 1fr;align-items:start;gap:40px;margin-top:20px;padding:56px;border-radius:28px;background:#f5f5f5}
    .profile-logo{display:grid;place-items:center;width:112px;height:112px;overflow:hidden;border-radius:28px;background:#fff;box-shadow:0 16px 32px -20px rgba(0,0,0,.35)}
    .profile-logo img{width:100%;height:100%;object-fit:contain}
    .profile-badges{display:flex;flex-wrap:wrap;gap:8px}
    .profile-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:999px;background:#fff;color:#6b6b6b;font-size:13px;font-weight:500}
    .profile-dot{width:7px;height:7px;border-radius:50%;background:#8fbf24}
    .profile-hero h1{margin:20px 0 0;font-size:clamp(2.25rem,1.5rem + 2.6vw,3.5rem);font-weight:600;line-height:1.02;letter-spacing:-.03em}
    .profile-hero-copy>p{max-width:52ch;margin:16px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .profile-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:28px}
    .profile-primary{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 24px;border-radius:999px;background:#0a0a0a;color:#fff;font-size:16px;font-weight:600;text-decoration:none;transition:background-color .2s}
    .profile-primary:hover{background:rgba(10,10,10,.9)}
    .profile-secondary{display:inline-flex;align-items:center;height:48px;padding:0 20px;border-radius:999px;background:#fff;color:#0a0a0a;font-size:15px;font-weight:500;text-decoration:none;transition:background-color .2s}
    .profile-secondary:hover{background:#ececec}
    .profile-facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin:16px 0 0;overflow:hidden;border:1px solid rgba(10,10,10,.1);border-radius:20px}
    .profile-facts div{padding:20px 24px;border-left:1px solid rgba(10,10,10,.1)}
    .profile-facts div:first-child{border-left:0}
    .profile-facts dt{color:#a1a1a1;font-size:13px}
    .profile-facts dd{margin:6px 0 0;font-size:17px;font-weight:600}
    .profile-body{display:grid;grid-template-columns:1.2fr 1fr;gap:64px;margin-top:80px}
    .profile-body h2,.profile-similar-head h2{margin:0;font-size:clamp(1.5rem,1.2rem + 1vw,2rem);font-weight:600;line-height:1.1;letter-spacing:-.015em}
    .profile-about p{margin:20px 0 0;color:#6b6b6b;font-size:17px;line-height:1.6}
    .profile-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
    .profile-tags span{padding:4px 12px;border:1px solid rgba(10,10,10,.1);border-radius:999px;color:#6b6b6b;font-size:13px;font-weight:500}
    .profile-founders{display:grid;gap:12px;margin-top:20px}
    .founder-card{padding:24px;border:1px solid rgba(10,10,10,.1);border-radius:24px}
    .founder-head{display:flex;align-items:center;gap:14px}
    .founder-avatar{display:grid;place-items:center;flex-shrink:0;width:52px;height:52px;overflow:hidden;border-radius:50%;background:#f5f5f5;color:#6b6b6b;font-size:16px;font-weight:600}
    .founder-avatar img{width:100%;height:100%;object-fit:cover}
    .founder-head h3{margin:0;font-size:17px;font-weight:600}
    .founder-head p{margin:2px 0 0;color:#a1a1a1;font-size:14px}
    .founder-bio{margin:16px 0 0;color:#6b6b6b;font-size:15px;line-height:1.55}
    .founder-links{display:flex;gap:8px;margin-top:16px}
    .founder-links a{padding:4px 12px;border-radius:999px;background:#f5f5f5;color:#0a0a0a;font-size:13px;font-weight:500;text-decoration:none;transition:background-color .2s}
    .founder-links a:hover{background:#ececec}
    .profile-note{margin:20px 0 0;padding:24px;border:1px dashed rgba(10,10,10,.15);border-radius:24px;color:#6b6b6b;font-size:15px;line-height:1.55}
    .profile-note strong{color:#0a0a0a;font-weight:600}
    .profile-similar{margin-top:96px}
    .profile-similar-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px 32px}
    .profile-similar-head a{display:inline-flex;align-items:center;gap:6px;color:#6b6b6b;font-size:14px;font-weight:500;text-decoration:none;transition:color .2s}
    .profile-similar-head a:hover{color:#0a0a0a}
    .profile-similar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:32px}
    @media(max-width:1023px){.profile-body{grid-template-columns:1fr;gap:56px}.profile-similar-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:639px){.profile-page{padding:112px 24px 48px}.profile-hero{grid-template-columns:1fr;gap:24px;padding:32px 24px}.profile-logo{width:88px;height:88px;border-radius:22px}.profile-facts{grid-template-columns:1fr 1fr}.profile-facts div{border-left:0;border-top:1px solid rgba(10,10,10,.1)}.profile-facts div:nth-child(-n+2){border-top:0}.profile-facts div:nth-child(even){border-left:1px solid rgba(10,10,10,.1)}.profile-body{margin-top:56px}.profile-similar{margin-top:72px}.profile-similar-grid{grid-template-columns:1fr}}
</style>
