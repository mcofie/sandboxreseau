---
---
<div class="flex items-center gap-2">
    <!-- Theme cycle -->
    <button id="themeToggle"
        class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-2.5 py-1 text-xs font-semibold uppercase tracking-wider hover:opacity-90"
        title="Switch theme (white → black → yellow)">
        <span class="inline-block h-[10px] w-[10px] rounded-full bg-[var(--ink)]"></span>
        Theme
    </button>

    <!-- Accent quick toggle (cycles accents) -->
    <button id="accentToggle"
        class="inline-flex items-center gap-2 rounded border accent-border px-2.5 py-1 text-xs font-semibold uppercase tracking-wider accent-text hover:opacity-90"
        title="Switch accent color">
        <span class="inline-block h-[10px] w-[10px] rounded-full"
            style="background: var(--accent)"></span>
        Color
    </button>
</div>
