---
import Layout from '../layouts/Layout.astro';
import gallery from '../data/gallery.json';

const headerSubtitle = "The Archive";
---

<Layout 
    title="Gallery | Sandbox Réseau" 
    description="Snapshots from previous Sandbox Réseau editions in Accra."
    headerSubtitle={headerSubtitle}
>
    <main class="mx-auto max-w-[1100px] px-4 py-10">
        <header class="mb-12 max-w-2xl">
            <span
                class="inline-block w-max border-y border-[var(--rule)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[.2em] text-[var(--muted)] mb-3">
                Exhibition
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl leading-tight mb-4">
                Captured Moments.
            </h2>
            <p class="text-[var(--muted)] text-sm md:text-base leading-relaxed">
                A visual record of the builders, thinkers, and makers who have shared their work and energy with our ecosystem since Vol. 1.
            </p>
        </header>

        <div class="masonry-grid" id="galleryContainer">
            {gallery.map((img, i) => (
                <div class="masonry-item animate-enter">
                    <figure class="group relative overflow-hidden rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_92%,var(--ink)_8%)] p-2 hatch">
                        <div class="relative overflow-hidden aspect-auto border border-[var(--rule)]">
                            <img 
                                src={img.url} 
                                alt={img.title} 
                                onclick={`openLightbox(${i})`}
                                loading="lazy" 
                                decoding="async"
                                class="w-full h-auto object-cover grayscale transition duration-500 group-hover:grayscale-0 group-hover:scale-105 cursor-zoom-in" 
                            />
                        </div>
                        <figcaption class="mt-3 px-1 flex items-end justify-between gap-3">
                            <div class="min-w-0">
                                <span class="block font-serif text-[15px] leading-tight truncate">{img.title}</span>
                                <span class="block text-[10px] uppercase tracking-widest text-[var(--muted)] font-semibold mt-1">
                                    {img.location || 'Accra, Ghana'} 
                                    {img.edition && `• ${img.edition}`}
                                </span>
                            </div>
                        </figcaption>
                    </figure>
                </div>
            ))}
        </div>
    </main>

    <script is:inline define:vars={{ galleryStrings: gallery.map(img => img.url) }}>
        // Set up gallery images for lightbox
        window.GALLERY_IMAGES = galleryStrings;
    </script>
</Layout>
