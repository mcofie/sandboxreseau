---
import Layout from '../../layouts/Layout.astro';
import SubscribeGate from '../../components/SubscribeGate.astro';
import { BUCKETS, CURRENCIES, STAGES } from '../../lib/metrics';

type Stage = 'mvp' | 'pmf' | 'scaling';
type Field = { key: string; label: string; bucket: string; core: Stage[]; hint?: string; money?: boolean; unit?: string };

// Raw numbers only: the page does the maths. Keys match the Inputs type in src/lib/metrics.ts.
// `core` lists the stages where a field is asked up front; everywhere else it sits under “Add more numbers”.
const FIELDS: Field[] = [
    { key: 'usersNow', label: 'Active users this month', bucket: 'growth', core: ['mvp', 'pmf', 'scaling'] },
    { key: 'usersPrev', label: 'Active users last month', bucket: 'growth', core: ['pmf', 'scaling'] },
    { key: 'signups', label: 'New signups this month', bucket: 'growth', core: ['mvp', 'scaling'] },
    { key: 'activated', label: 'Of those, how many did the key action', bucket: 'growth', core: ['mvp', 'scaling'], hint: 'The moment they “got it”: first payment, first order, first post' },
    { key: 'coreActionUsers', label: 'Users who did the main thing this month', bucket: 'engagement', core: ['mvp', 'scaling'], hint: 'What your product exists for: sent money, completed an order, finished a lesson' },
    { key: 'dau', label: 'Daily active users, on average', bucket: 'engagement', core: ['scaling'] },
    { key: 'mrr', label: 'Monthly recurring revenue', bucket: 'revenue', money: true, core: ['pmf', 'scaling'] },
    { key: 'mrrStart', label: 'MRR last month', bucket: 'revenue', money: true, core: ['pmf', 'scaling'] },
    { key: 'mrrLost', label: 'MRR lost to cancellations or downgrades', bucket: 'revenue', money: true, core: ['scaling'] },
    { key: 'smSpend', label: 'Sales & marketing spend this month', bucket: 'unit', money: true, core: ['scaling'], hint: 'Ads, sales and marketing salaries, tools, events' },
    { key: 'newCustomers', label: 'New paying customers this month', bucket: 'unit', core: ['scaling'] },
    { key: 'cash', label: 'Cash in the bank', bucket: 'runway', money: true, core: ['pmf', 'scaling'] },
    { key: 'expenses', label: 'Monthly spend, everything included', bucket: 'runway', money: true, core: ['pmf', 'scaling'], hint: 'Salaries (yours too), servers, rent, subscriptions' },
    { key: 'invitesPerUser', label: 'Invites each user sends, on average', bucket: 'growth', core: [] },
    { key: 'inviteConversion', label: 'Invites that become signups', bucket: 'growth', unit: '%', core: [] },
    { key: 'usersPrev2', label: 'Active users 2 months ago', bucket: 'growth', core: [] },
    { key: 'usersPrev3', label: 'Active users 3 months ago', bucket: 'growth', core: [], hint: 'With the one above, checks for a 3-month plateau' },
    { key: 'dauPrev', label: 'Daily active users last month', bucket: 'engagement', core: [] },
    { key: 'mrr3Ago', label: 'MRR three months ago', bucket: 'revenue', money: true, core: [] },
    { key: 'churnPrev', label: 'Last month’s revenue churn', bucket: 'revenue', unit: '%', core: [] },
    { key: 'monthsCharging', label: 'Months you’ve been charging', bucket: 'unit', core: [] },
];
// Retention is one row of three: the % of a signup cohort still active on days 1, 7 and 30.
const RETENTION_CORE: Stage[] = ['mvp', 'pmf', 'scaling'];
const RETENTION_AFTER = 'coreActionUsers'; // where the retention row sits in the field order
const DEFAULT_STAGE: Stage = 'pmf';
const pickable = STAGES;
// Line icons for the stage picker: an idea, a first build, something taking root, growth.
const STAGE_ICONS: Record<string, string> = {
    idea: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1 2V16h5.2v-.2c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"/>',
    mvp: '<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>',
    pmf: '<path d="M12 21v-9"/><path d="M12 12c0-4 2.5-6.5 7-7 0 4.5-2.5 7-7 7Z"/><path d="M12 14c0-3-2-5-6-5.5 0 3.5 2 5.5 6 5.5Z"/>',
    scaling: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
};
---

<Layout
    title="Metrics Check | Sandbox Réseau"
    description="Bring your startup’s numbers and get the 16 metrics from the Startup Metrics Cheat Sheet calculated, benchmarked and diagnosed, with a PDF report to keep."
    image="/assets/img/reports/startup-metric-cheat-sheet.jpg"
    imageAlt="Startup Metrics Cheat Sheet cover"
>
    <main class="mx-page" data-metrics-root>
        <section class="mx-head" aria-labelledby="mx-title">
            <span class="mx-pill"><span aria-hidden="true"></span>Free tool · Based on the Startup Metrics Cheat Sheet</span>
            <h1 id="mx-title">Metrics check.</h1>
            <p>Bring your numbers. We’ll calculate the metrics that matter at your stage, benchmark them, and tell you exactly what’s wrong and what to do about it.</p>
            <p class="mx-private">
                <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7V5a4 4 0 0 1 8 0v2M3.5 7h9v6.5h-9z" /></svg>
                Your numbers never leave your browser. Nothing is sent or stored on our side.
            </p>
        </section>

        <form class="mx-form" data-metrics-form novalidate>
            <section class="mx-card mx-setup" aria-labelledby="mx-setup-title">
                <div class="mx-setup-head">
                    <h2 id="mx-setup-title">Start here.</h2>
                    <div class="mx-setup-actions">
                        <button type="button" class="mx-ghost" data-metrics-sample>Try with sample data</button>
                        <button type="button" class="mx-ghost" data-metrics-clear>Clear</button>
                    </div>
                </div>
                <div class="mx-setup-grid">
                    <label class="mx-field">
                        <span>Startup name <em>optional</em></span>
                        <input type="text" name="name" maxlength="60" placeholder="e.g. Osu Ledger" autocomplete="organization" enterkeyhint="next" />
                    </label>
                    <label class="mx-field">
                        <span>Currency</span>
                        <select name="currency">
                            {['Africa', 'Global'].map((region) => (
                                <optgroup label={region}>
                                    {CURRENCIES.filter((c) => c.region === region).map((c) => (
                                        <option value={c.code}>{c.name} ({c.symbol.trim()})</option>
                                    ))}
                                </optgroup>
                            ))}
                        </select>
                    </label>
                </div>
                <fieldset class="mx-stages">
                    <legend>Where are you?</legend>
                    {pickable.map((stage) => (
                        <label class="mx-stage">
                            <input type="radio" name="stage" value={stage.id} checked={stage.id === 'pmf'} />
                            <span>
                                <i class="mx-stage-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={STAGE_ICONS[stage.id]} />
                                </i>
                                <span class="mx-stage-text"><strong>{stage.name}</strong><small>{stage.hint}</small></span>
                            </span>
                        </label>
                    ))}
                </fieldset>
                <p class="mx-stage-current" data-stage-hint></p>
            </section>

            <section class="mx-card mx-idea" data-metrics-idea hidden>
                <h2>Close this page. Seriously.</h2>
                <p>At the idea stage, metrics don’t help you yet. Go and have 30 conversations with potential users, then come back when you have a product people can touch.</p>
                <a class="mx-black" href="/reports">Read the Early Startup Playbook</a>
            </section>

            <section class="mx-card mx-numbers" aria-labelledby="mx-numbers-title" data-metrics-buckets>
                <div class="mx-numbers-head">
                    <h2 id="mx-numbers-title">Your numbers.</h2>
                    <p>Just what matters at your stage. Leave anything you don’t know blank.</p>
                </div>
                <div class="mx-fields" data-core-fields>
                    {FIELDS.map((field, index) => (
                        <>
                        <label class="mx-field" data-field={field.key} data-order={index * 2} data-core={field.core.join(' ')} data-bucket-id={field.bucket} hidden={!field.core.includes(DEFAULT_STAGE)}>
                            <span>{field.label}</span>
                            <span class:list={['mx-input', field.money && 'is-money', field.unit && 'has-unit']}>
                                {field.money && <span class="mx-prefix" data-currency-symbol>GH₵</span>}
                                <input type="text" inputmode="decimal" enterkeyhint="next" name={field.key} autocomplete="off" />
                                {field.unit && <span class="mx-suffix">{field.unit}</span>}
                            </span>
                            {field.hint && <small>{field.hint}</small>}
                        </label>
                        {field.key === RETENTION_AFTER && (
                        <fieldset class="mx-trio" data-field="retention" data-order={index * 2 + 1} data-core={RETENTION_CORE.join(' ')} data-bucket-id="engagement">
                            <legend>Of everyone who signs up, what % are still active after…</legend>
                            <div class="mx-trio-row">
                            {[['d1', '1 day'], ['d7', '7 days'], ['d30', '30 days']].map(([key, label]) => (
                                <label class="mx-field">
                                    <span class="mx-input has-unit">
                                        <input type="text" inputmode="decimal" enterkeyhint="next" name={key} autocomplete="off" aria-label={`Still active after ${label}`} />
                                        <span class="mx-suffix">%</span>
                                    </span>
                                    <small>{label}</small>
                                </label>
                            ))}
                            </div>
                        </fieldset>
                        )}
                        </>
                    ))}
                </div>

                <details class="mx-more" data-more>
                    <summary>
                        <span><strong>Add more numbers</strong><small data-more-count>For a fuller check across all 16 metrics</small></span>
                        <svg class="mx-chevron" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
                    </summary>
                    <div class="mx-more-groups">
                        {BUCKETS.map((bucket) => (
                            <div class="mx-more-group" data-more-group={bucket.id} style={`--bucket:${bucket.colour}`}>
                                <p class="mx-more-title"><span aria-hidden="true"></span>{bucket.name}</p>
                                <div class="mx-fields" data-more-fields={bucket.id}></div>
                            </div>
                        ))}
                    </div>
                </details>
            </section>
        </form>

        <section class="mx-results" aria-labelledby="mx-results-title" data-metrics-results>
            <div class="mx-results-head">
                <h2 id="mx-results-title">Your diagnosis.</h2>
                <p data-metrics-summary>Fill in a few numbers above, or try the sample data, and your results appear here.</p>
            </div>
            <div data-metrics-output></div>
        </section>

        <div class="mx-dock" data-metrics-dock hidden>
            <p class="mx-dock-score" data-dock-score></p>
            <button type="button" class="mx-dock-btn" data-dock-action>See results</button>
        </div>

        <p class="mx-source">Every metric and benchmark here comes from the Startup Metrics Cheat Sheet. <a href="/reports">Read it on the reports page →</a></p>
    </main>

    <SubscribeGate
        title="Get your report in one step."
        copy="Subscribe to the Sandbox Réseau newsletter and your PDF report downloads straight away. You’ll also get every new playbook and cheat sheet first. Unsubscribe anytime."
    />
</Layout>

<script>
    import { analyse, BUCKETS, SAMPLE, SIGNALS, STAGES, currencyOf, money, num, type Inputs, type MetricResult, type Report, verdict } from '../../lib/metrics';

    const STORE = 'sbr-metrics-inputs';
    const TEXT_KEYS = new Set(['name', 'stage', 'currency']);
    let report: Report | null = null;

    const root = () => document.querySelector<HTMLElement>('[data-metrics-root]');
    const form = () => document.querySelector<HTMLFormElement>('[data-metrics-form]');

    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    function parseNumber(raw: string) {
        const cleaned = raw.replace(/[,\s₵$%]/g, '').replace(/^GH/i, '');
        if (cleaned === '') return undefined;
        const n = Number(cleaned);
        return Number.isFinite(n) ? n : undefined;
    }

    function read(): Inputs {
        const data = new FormData(form()!);
        const inputs: Record<string, unknown> = {};
        for (const [key, value] of data.entries()) {
            const v = String(value);
            if (TEXT_KEYS.has(key)) inputs[key] = v.trim() || undefined;
            else inputs[key] = parseNumber(v);
        }
        return inputs as Inputs;
    }

    function write(inputs: Inputs) {
        const f = form()!;
        for (const el of Array.from(f.elements) as HTMLInputElement[]) {
            if (!el.name) continue;
            const v = (inputs as Record<string, unknown>)[el.name];
            if (el.type === 'radio') el.checked = el.value === (v ?? 'pmf');
            else if (el.tagName === 'SELECT') el.value = String(v ?? 'GHS');
            else if (typeof v === 'number') el.value = el.name === 'name' ? String(v) : formatNumber(v);
            else el.value = v === undefined || v === null ? '' : String(v);
        }
    }

    function save(inputs: Inputs) {
        try { localStorage.setItem(STORE, JSON.stringify(inputs)); } catch {}
    }
    function restore(): Inputs | null {
        try { return JSON.parse(localStorage.getItem(STORE) || 'null'); } catch { return null; }
    }

    function signalPill(m: MetricResult) {
        if (!m.signal) return '<span class="mx-sig is-info">Info</span>';
        return `<span class="mx-sig" style="--sig:${SIGNALS[m.signal].colour}">${SIGNALS[m.signal].label}</span>`;
    }

    const has = (n: unknown): n is number => typeof n === 'number' && Number.isFinite(n);
    const formatNumber = (n: number) => n.toLocaleString('en-GB', { maximumFractionDigits: 2 });

    function renderDock() {
        const dock = document.querySelector<HTMLElement>('[data-metrics-dock]');
        const score = document.querySelector<HTMLElement>('[data-dock-score]');
        if (!dock || !score) return;
        const r = report;
        dock.hidden = !r || r.computed === 0 || r.inputs.stage === 'idea';
        if (!r || dock.hidden) return;
        const order = ['danger', 'work', 'okay', 'strong'] as const;
        score.innerHTML = `<strong>${r.computed}</strong> metrics${order
            .filter((s) => r.counts[s] > 0)
            .map((s) => `<span style="--sig:${SIGNALS[s].colour}" title="${SIGNALS[s].label}">${r.counts[s]}</span>`)
            .join('')}`;
    }

    // One expandable row per metric: the verdict at a glance, the working and the move inside.
    function metricRow(m: MetricResult, focusTag: boolean) {
        const moves = m.moves.length
            ? `<div class="mx-move"><p class="mx-label">The move</p><ul>${m.moves.map((x) => `<li>${esc(x)}</li>`).join('')}</ul></div>`
            : '';
        return `<details class="mx-item" id="mx-m-${m.id}">
            <summary>
                <span class="mx-num" aria-hidden="true">${String(m.id).padStart(2, '0')}</span>
                <span class="mx-item-text"><strong>${esc(m.name)}${focusTag && m.focus ? '<em>Focus</em>' : ''}</strong><small>${esc(m.signalText)}</small></span>
                <span class="mx-item-value">${esc(m.display)}<i class="bx-dot" style="--sig:${m.signal ? SIGNALS[m.signal].colour : '#c8c8c8'}"></i></span>
                <svg class="mx-item-chevron" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg>
            </summary>
            <div class="mx-item-body">
                <p class="mx-item-verdict">${signalPill(m)}${esc(m.signalText)}</p>
                ${m.working ? `<p class="mx-working">${esc(m.working)}</p>` : ''}
                ${m.note ? `<p class="mx-note">${esc(m.note)}</p>` : ''}
                ${m.redFlag ? `<p class="mx-flag"><span>Red flag</span>${esc(m.redFlag)}</p>` : ''}
                ${moves}
            </div>
        </details>`;
    }

    function chart(r: Report) {
        const p = r.projection;
        if (!p || p.series.length < 2) return '';
        const cur = r.inputs.currency ?? 'GHS';
        const W = 640, H = 240, L = 8, R = 8, T = 16, B = 28;
        const pts = p.series;
        const last = pts[pts.length - 1].month || 1;
        const maxY = Math.max(...pts.map((d) => Math.max(d.revenue, d.expenses))) * 1.1;
        const x = (m: number) => L + (m / last) * (W - L - R);
        const y = (v: number) => T + (1 - v / maxY) * (H - T - B);
        const line = (key: 'revenue' | 'expenses') => pts.map((d, i) => `${i ? 'L' : 'M'}${x(d.month).toFixed(1)},${y(d[key]).toFixed(1)}`).join(' ');
        const end = pts[pts.length - 1];
        const marker = p.alive
            ? `<circle cx="${x(end.month)}" cy="${y(end.expenses)}" r="5" fill="#fff" stroke="#92519b" stroke-width="2.5"/><text x="${Math.min(x(end.month), W - 120)}" y="${y(end.expenses) - 12}" class="mx-chart-label">Profitable · month ${end.month}</text>`
            : `<line x1="${x(end.month)}" x2="${x(end.month)}" y1="${T}" y2="${H - B}" stroke="#0a0a0a" stroke-dasharray="4 4"/><text x="${Math.min(x(end.month) + 6, W - 110)}" y="${T + 12}" class="mx-chart-label">Cash runs out · month ${end.month}</text>`;
        const ticks = [0, Math.round(last / 2), last].map((m) => `<text x="${x(m)}" y="${H - 8}" text-anchor="${m === 0 ? 'start' : m === last ? 'end' : 'middle'}" class="mx-chart-tick">Month ${m}</text>`).join('');
        return `<figure class="mx-chart">
            <figcaption><strong>${p.alive ? 'Default alive' : 'Default dead'}</strong>Monthly revenue growing at ${(p.growth * 100).toFixed(1).replace(/\.0$/, '')}% against flat expenses of ${money(end.expenses, cur)}.</figcaption>
            <svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Revenue projection against monthly expenses">
                <line x1="${L}" x2="${W - R}" y1="${H - B}" y2="${H - B}" stroke="rgba(10,10,10,.15)"/>
                <path d="${line('expenses')}" fill="none" stroke="#0a0a0a" stroke-width="2"/>
                <path d="${line('revenue')}" fill="none" stroke="#92519b" stroke-width="2.5"/>
                ${marker}${ticks}
            </svg>
            <p class="mx-legend"><span style="--c:#92519b">Revenue</span><span style="--c:#0a0a0a">Monthly expenses</span></p>
        </figure>`;
    }

    function render() {
        const r = report;
        const out = document.querySelector<HTMLElement>('[data-metrics-output]');
        const summary = document.querySelector<HTMLElement>('[data-metrics-summary]');
        if (!r || !out || !summary) return;
        renderDock();
        summary.hidden = r.computed > 0;
        if (r.computed === 0) {
            out.innerHTML = '';
            return;
        }
        // Overview: one verdict card, then the plan. Everything else lives in “Every metric”.
        const bucketOf = (m: MetricResult) => BUCKETS.find((x) => x.id === m.bucket)!;
        const dot = (m: MetricResult) => `<i class="bx-dot" style="--sig:${m.signal ? SIGNALS[m.signal].colour : '#c8c8c8'}"></i>`;
        const shortName = (m: MetricResult) => m.name.split(' (')[0];
        const stage = STAGES.find((x) => x.id === r.inputs.stage) ?? STAGES[2];
        const { hero, sub } = verdict(r);
        const tally = (['strong', 'okay', 'work', 'danger'] as const)
            .filter((sg) => r.counts[sg] > 0)
            .map((sg) => `<span><i class="bx-dot" style="--sig:${SIGNALS[sg].colour}"></i><strong>${r.counts[sg]}</strong> ${SIGNALS[sg].label.toLowerCase()}</span>`)
            .join('');
        const verdictCard = `<section class="bx-verdict">
            <div class="bx-top"><span class="bx-label">Your verdict · ${esc(stage.name)}</span><span class="bx-label">${r.computed} of 16 metrics</span></div>
            <p class="bx-hero">${esc(hero)}</p>
            <p class="bx-sub">${esc(sub)}</p>
            <p class="bx-tally">${tally}</p>
            <div class="bx-actions">
                <button type="button" class="mx-black" data-metrics-pdf data-gated><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13h10" /></svg><span data-pdf-label>Download PDF report</span></button>
                <button type="button" class="bx-outline" data-bento-details>See every metric</button>
            </div>
        </section>`;

        // The plan: what to fix, why, and the move for each, numbered like the PDF.
        const plan = r.priorities.length
            ? `<section class="bx-plan">
                <h3 class="mx-statement">Fix these first. <span>In this order.</span></h3>
                <ol>${r.priorities
                    .map((m, i) => {
                        const move = m.moves[m.id === 1 ? 1 : 0];
                        const b = bucketOf(m);
                        return `<li><a href="#mx-m-${m.id}" data-jump style="--bucket:${b.colour};--tint:${b.tint}">
                            <span class="bx-plan-meta"><span class="bx-step">${String(i + 1).padStart(2, '0')}</span><span class="bx-plan-sig">${dot(m)}${m.signal ? SIGNALS[m.signal].label : 'For reference'}</span></span>
                            <span class="bx-plan-name">${esc(shortName(m))}</span>
                            <span class="bx-plan-value">${esc(m.display)}</span>
                            <small>${esc(m.redFlag ?? m.signalText)}</small>
                            ${move ? `<span class="bx-plan-move"><span>The move</span>${esc(move)}</span>` : ''}
                        </a></li>`;
                    })
                    .join('')}</ol>
            </section>`
            : '<p class="mx-none">Nothing urgent in the numbers you’ve shared. Keep tracking them weekly and run this check again next month.</p>';

        const bento = `<div class="bx">${verdictCard}${plan}</div>`;
        const focusTag = (STAGES.find((x) => x.id === r.inputs.stage)?.focus.length ?? 16) < 16;
        const areas = BUCKETS.map((b) => {
            const ms = r.metrics.filter((m) => m.bucket === b.id);
            const done = ms.filter((m) => !m.missing);
            const missing = ms.filter((m) => m.missing);
            const hasChart = b.id === 'runway' && r.projection && r.projection.series.length > 1;
            return `<section class="mx-area${hasChart ? ' is-wide' : ''}" style="--bucket:${b.colour};--tint:${b.tint}">
                <h3><span>${b.name}</span><small>${b.question}</small></h3>
                <div class="mx-area-card">
                    ${hasChart ? `<div class="mx-area-rows">${done.map((m) => metricRow(m, focusTag)).join('')}</div>${chart(r)}` : done.map((m) => metricRow(m, focusTag)).join('')}
                    ${missing.length ? `<p class="mx-area-missing"><strong>Add for this area:</strong> ${missing.map((m) => esc(m.missing!.charAt(0).toLowerCase() + m.missing!.slice(1))).join('; ')}.</p>` : ''}
                </div>
            </section>`;
        }).join('');
        const buckets = `<div class="mx-areas"><h2 class="mx-areas-title mx-statement">Every metric. <span>Tap any row for the detail.</span></h2>${areas}</div>`;
        out.innerHTML = `${bento}${buckets}`;
    }

    // Move each field into the main card if its stage asks for it, otherwise into “Add more numbers”.
    // Moving the same nodes keeps whatever the founder has typed. Only runs when the stage changes:
    // moving a node blurs the field inside it, so re-arranging on every keystroke steals the cursor.
    let arrangedFor: string | undefined;
    function arrange(stage: string) {
        const core = document.querySelector<HTMLElement>('[data-core-fields]');
        if (!core || (stage === arrangedFor && core.isConnected && core.dataset.arranged === stage)) return;
        arrangedFor = stage;
        core.dataset.arranged = stage;
        const active = document.activeElement as HTMLElement | null;
        let extra = 0;
        core.querySelectorAll<HTMLElement>(':scope > [data-field]').forEach((el) => (el.hidden = false));
        const fields = Array.from(document.querySelectorAll<HTMLElement>('[data-field][data-core]'));
        fields.sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order));
        fields.forEach((el) => {
            const isCore = (el.dataset.core ?? '').split(' ').includes(stage);
            const target = isCore ? core : document.querySelector<HTMLElement>(`[data-more-fields="${el.dataset.bucketId}"]`);
            if (target) target.append(el);
            if (!isCore) extra++;
        });
        if (active && active !== document.activeElement && active.isConnected) active.focus({ preventScroll: true });
        document.querySelectorAll<HTMLElement>('[data-more-group]').forEach((g) => (g.hidden = !g.querySelector('[data-field]')));
        const count = document.querySelector('[data-more-count]');
        if (count) count.textContent = `${extra} optional numbers for a fuller check across all 16 metrics`;
    }

    function update() {
        if (!form()) return;
        const inputs = read();
        const idea = inputs.stage === 'idea';
        document.querySelector<HTMLElement>('[data-metrics-idea]')!.hidden = !idea;
        document.querySelector<HTMLElement>('[data-metrics-buckets]')!.hidden = idea;
        document.querySelector<HTMLElement>('[data-metrics-results]')!.hidden = idea;
        const symbol = currencyOf(inputs.currency).symbol.trim();
        document.querySelectorAll('[data-currency-symbol]').forEach((el) => (el.textContent = symbol));
        arrange(inputs.stage ?? 'pmf');
        const hint = document.querySelector<HTMLElement>('[data-stage-hint]');
        if (hint) hint.textContent = STAGES.find((s) => s.id === inputs.stage)?.hint ?? '';
        report = analyse(inputs);
        save(inputs);
        render();
    }

    let timer: number | undefined;
    document.addEventListener('input', (event) => {
        if (!(event.target as Element).closest('[data-metrics-form]')) return;
        clearTimeout(timer);
        timer = window.setTimeout(update, 150);
    });
    document.addEventListener('change', (event) => {
        if ((event.target as Element).closest('[data-metrics-form]')) update();
    });

    document.addEventListener('click', async (event) => {
        const target = event.target as Element;
        if (target.closest('[data-metrics-sample]')) {
            write(SAMPLE);
            update();
            document.querySelector('[data-metrics-results]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return;
        }
        if (target.closest('[data-metrics-clear]')) {
            write({});
            update();
            return;
        }
        const pdf = target.closest<HTMLButtonElement>('[data-metrics-pdf]');
        if (pdf && report && report.computed > 0) {
            const label = pdf.querySelector<HTMLElement>('[data-pdf-label]')!;
            pdf.disabled = true;
            label.textContent = 'Preparing your PDF…';
            try {
                const { downloadReport } = await import('../../lib/metrics-pdf');
                await downloadReport(report);
            } catch (error) {
                console.error(error);
                label.textContent = 'Something went wrong. Try again';
                pdf.disabled = false;
                return;
            }
            label.textContent = 'Download PDF report';
            pdf.disabled = false;
        }
    });

    // Big numbers are easier to check with separators: 600000 becomes 600,000 when you leave the field.
    document.addEventListener('focusout', (event) => {
        const el = event.target as HTMLInputElement;
        if (!el.matches?.('[data-metrics-form] input[inputmode="decimal"]')) return;
        const n = parseNumber(el.value);
        if (n !== undefined) el.value = formatNumber(n);
    });

    // Return on the phone keyboard moves to the next visible field.
    document.addEventListener('keydown', (event) => {
        const el = event.target as HTMLInputElement;
        if (event.key !== 'Enter' || !el.matches?.('[data-metrics-form] input')) return;
        event.preventDefault();
        const inputs = Array.from(form()!.querySelectorAll<HTMLInputElement>('input:not([type="radio"])')).filter((i) => i.offsetParent !== null);
        const next = inputs[inputs.indexOf(el) + 1];
        if (next) next.focus();
        else el.blur();
    });

    // Bento: list rows jump to their card (opening it on phones); buttons reuse the main actions.
    document.addEventListener('click', (event) => {
        const target = event.target as Element;
        const jump = target.closest<HTMLAnchorElement>('[data-jump]');
        if (jump) {
            event.preventDefault();
            const card = document.querySelector<HTMLDetailsElement>(jump.getAttribute('href')!);
            if (!card) return;
            card.open = true;
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }
        if (target.closest('[data-bento-details]')) document.querySelector('.mx-areas')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // The dock offers “See results” until the results reach the screen, then the PDF.
    let resultsVisible = false;
    function syncDock() {
        const results = document.querySelector('[data-metrics-results]');
        const action = document.querySelector<HTMLElement>('[data-dock-action]');
        if (!results || !action) return;
        const box = results.getBoundingClientRect();
        resultsVisible = box.top < window.innerHeight * 0.6 && box.bottom > 0;
        action.textContent = resultsVisible ? 'Download PDF' : 'See results';
    }
    window.addEventListener('scroll', syncDock, { passive: true });
    document.addEventListener('click', (event) => {
        if (!(event.target as Element).closest('[data-dock-action]')) return;
        if (resultsVisible) document.querySelector<HTMLButtonElement>('[data-metrics-pdf]')?.click();
        else document.querySelector('[data-metrics-results]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    function init() {
        if (!root()) return;
        const saved = restore();
        if (saved) write(saved);
        update();
        syncDock();
    }
    document.addEventListener('astro:page-load', init);
</script>

