---
import Layout from '../../layouts/Layout.astro';

const headerSubtitle = "The Dispatch Archive";
---

<Layout 
    title="Newsletters | Sandbox Réseau" 
    description="Read previous issues of The Sandbox Réseau Dispatch, our weekly update on the Accra tech ecosystem."
    headerSubtitle={headerSubtitle}
>
    <!-- Hero Header -->
    <section class="border-b border-[var(--rule)]">
        <div class="mx-auto max-w-[1100px] px-4 py-20 md:py-32 text-center">
            <span class="inline-block w-max border-y border-[var(--rule)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[.2em] text-[var(--muted)] mb-6 animate-enter">
                The Archive
            </span>
            <h1 class="font-serif text-5xl sm:text-7xl md:text-8xl leading-[.85] tracking-tighter mb-8 animate-enter">
                The Gazette Dispatch.
            </h1>
            <p class="mx-auto max-w-2xl text-[var(--muted)] text-base md:text-xl leading-relaxed font-serif animate-enter">
                Deep dives into building, product strategy, and the cultural shifts defining the next wave of African innovation.
            </p>
        </div>
    </section>

    <!-- Main Content / Coming Soon -->
    <main class="mx-auto max-w-[1100px] px-4 py-16 md:py-24">
        <div class="flex flex-col items-center justify-center py-16 md:py-24 animate-enter">
            <div class="w-16 h-16 rounded-full border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_90%,var(--ink)_10%)] hatch flex items-center justify-center mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-[var(--ink)]">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                </svg>
            </div>
            <h2 class="font-serif text-3xl md:text-4xl mb-4 tracking-tight">The Dispatch is Returning.</h2>
            <p class="text-[var(--muted)] max-w-md text-center text-sm md:text-base leading-relaxed mb-10">
                We are currently rebooting our editorial engine. Subscribe via our community channels to be notified when Volume 2 drops.
            </p>
            <a href="https://discord.gg/RMcBDRrV7x" target="_blank" rel="noreferrer"
                class="inline-flex items-center gap-2 rounded border border-[var(--rule)] bg-[var(--ink)] px-8 py-4 text-sm font-bold uppercase tracking-widest text-[var(--paper)] hover:bg-[var(--accent)] transition-all">
                Join the Discord
            </a>
        </div>
    </main>

    <script is:inline>
        (function() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, i) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.classList.add('visible');
                        }, (i % 3) * 150);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.animate-enter').forEach(el => observer.observe(el));
        })();
    </script>
</Layout>
