---
import Layout from '../layouts/Layout.astro';
import GlobalPlayer from '../components/GlobalPlayer.astro';

const headerSubtitle = "Digital Audio-Log";
---

<Layout 
    title="The Reverb Podcast | Sandbox Réseau" 
    description="The high-bandwidth audio-log for the African builder. Listen to the latest dispatches from the Sandbox Réseau ecosystem."
    headerSubtitle={headerSubtitle}
>
    <!-- Hero Section -->
    <section class="border-b border-[var(--rule)]">
        <div class="mx-auto max-w-[1100px] px-4 py-20 md:py-32 text-center">
            <span
                class="inline-block w-max border-y border-[var(--rule)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[.2em] text-[var(--muted)] mb-6 animate-enter">
                Audio Dispatch
            </span>
            <h1 class="font-serif text-5xl sm:text-7xl md:text-8xl leading-[.85] tracking-tighter mb-8 animate-enter">
                The Reverb.
            </h1>
            <p class="mx-auto max-w-2xl text-[var(--muted)] text-base md:text-xl leading-relaxed font-serif animate-enter">
                A fast-paced tech podcast capturing real conversations from the Sandbox Réseau community. No fillers. Just what people are building, thinking, and learning right now.
            </p>
            <div class="mt-10 flex flex-wrap items-center justify-center gap-4 animate-enter">
                <a href="https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN" target="_blank"
                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-6 py-3.5 text-sm font-bold uppercase tracking-widest hover:bg-[#1DB954] hover:text-white hover:border-[#1DB954] transition-all">
                    Listen on Spotify
                </a>
                <a href="https://podcasts.apple.com/gh/podcast/the-reverb/id1884282478" target="_blank"
                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-6 py-3.5 text-sm font-bold uppercase tracking-widest hover:bg-[#8e3ee5] hover:text-white hover:border-[#8e3ee5] transition-all">
                    Listen on Apple
                </a>
            </div>
        </div>
    </section>

    <!-- Main: article stream -->
    <main class="mx-auto max-w-[1100px] px-4 py-16 md:py-24">
        <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1fr_320px]">
            <!-- Main Column: Archive -->
            <div class="space-y-8">
                <div class="archive-scroll-target mb-4 flex items-center justify-between gap-4 animate-enter">
                    <h3 class="font-serif text-2xl tracking-tight">Archive</h3>
                    <div class="h-px flex-1 bg-[var(--rule)]/10"></div>
                    <div id="podcast-count" class="text-[11px] font-bold uppercase tracking-widest text-[var(--muted)]">Loading Episodes...</div>
                </div>

                <div id="podcast-error" class="hidden text-center py-20 text-[var(--muted)] font-serif"></div>
                
                <div id="podcast-archive" class="space-y-6">
                    <!-- Shimmers -->
                    <div class="podcast-shimmer space-y-6">
                        {[1, 2, 3].map(() => (
                            <div class="flex flex-col sm:flex-row gap-6 p-6 rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)] animate-pulse">
                                <div class="w-full aspect-square sm:w-32 sm:h-32 bg-neutral-200/50 rounded border border-[var(--rule)]/20"></div>
                                <div class="flex-1 space-y-4">
                                    <div class="h-3 w-32 bg-neutral-200/50 rounded"></div>
                                    <div class="h-6 w-3/4 bg-neutral-200/50 rounded"></div>
                                    <div class="h-4 w-full bg-neutral-200/50 rounded"></div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Pagination -->
                <div id="podcast-pagination"></div>
            </div>

            <!-- Right Rail -->
            <div class="space-y-8 lg:sticky lg:top-24 lg:self-start">
                
                <!-- Show Art Widget -->
                <div class="rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)] p-6 animate-enter text-center">
                    <div class="relative group mx-auto w-48 h-48 mb-6">
                        <img id="podcastCover" src="/assets/img/podcast-logo.png" alt="The Reverb Logo" class="w-full h-full rounded border border-[var(--rule)] shadow-lg grayscale transition-all duration-700 group-hover:grayscale-0">
                    </div>
                    <h3 class="font-serif text-xl mb-2 pb-4 border-b border-[var(--rule)]/20">The Reverb</h3>
                    <p class="text-[12px] text-[var(--muted)] leading-relaxed m-0 pt-2">
                        Short, high-bandwidth dispatches from African builders making things happen.
                    </p>
                </div>

                <!-- Right Rail CTA -->
                <div class="rounded border border-[var(--rule)] hatch p-6 relative overflow-hidden group animate-enter bg-[color:color-mix(in_oklab,var(--paper)_90%,var(--ink)_10%)] text-center">
                    <div class="relative z-10">
                        <h4 class="font-serif text-xl mb-2 text-[var(--ink)]">Never miss a pulse</h4>
                        <p class="text-[13px] text-[var(--muted)] mb-5 leading-relaxed">
                            Subscribe on your preferred platform for weekly dispatches.
                        </p>
                        <div class="flex flex-col gap-3">
                            <a href="https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN" target="_blank"
                                class="block w-full rounded border border-[var(--rule)] py-2.5 text-[10px] font-bold uppercase tracking-widest text-[var(--ink)] hover:bg-[#1DB954] hover:text-white hover:border-[#1DB954] transition-all bg-[var(--paper)]">
                                Spotify
                            </a>
                            <a href="https://podcasts.apple.com/gh/podcast/the-reverb/id1884282478" target="_blank"
                                class="block w-full rounded border border-[var(--rule)] py-2.5 text-[10px] font-bold uppercase tracking-widest text-[var(--ink)] hover:bg-[#8e3ee5] hover:text-white hover:border-[#8e3ee5] transition-all bg-[var(--paper)]">
                                Apple
                            </a>
                            <a href="https://anchor.fm/s/110059518/podcast/rss" target="_blank"
                                class="block w-full rounded border border-[var(--rule)] py-2.5 text-[10px] font-bold uppercase tracking-widest text-[var(--ink)] hover:bg-[var(--ink)] hover:text-[var(--paper)] transition-all bg-[var(--paper)]">
                                RSS Feed
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <GlobalPlayer />

    <script is:inline>
        const EPISODES_PER_PAGE = 6;
        let allEpisodeCards = [];
        let currentPage = 1;
        let totalPages = 1;

        async function fetchPodcastArchive() {
            const archive = document.getElementById('podcast-archive');
            const countDisplay = document.getElementById('podcast-count');
            const errorDisplay = document.getElementById('podcast-error');
            
            if (!archive) return;

            try {
                const rssUrl = `https://anchor.fm/s/110059518/podcast/rss?t=${Date.now()}`;
                const response = await fetch(rssUrl);
                const text = await response.text();
                const parser = new DOMParser();
                const xml = parser.parseFromString(text, "text/xml");
                const items = xml.querySelectorAll("item");
                
                if (items.length > 0) {
                    const itunesNamespace = "http://www.itunes.com/dtds/podcast-1.0.dtd";
                    allEpisodeCards = [];
                    
                    items.forEach(item => {
                        const title = item.querySelector("title")?.textContent || "The Reverb Episode";
                        const guid = item.querySelector("guid")?.textContent || "";
                        const pubDate = item.querySelector("pubDate")?.textContent || "";
                        const spotifyUrl = item.querySelector("link")?.textContent || "#";
                        const description = item.querySelector("description")?.textContent || "";
                        const audioUrl = item.querySelector("enclosure")?.getAttribute("url") || "";
                        
                        const durationElement = item.getElementsByTagNameNS(itunesNamespace, "duration")[0];
                        const duration = durationElement ? durationElement.textContent : "5:00";
                        
                        const imageElement = item.getElementsByTagNameNS(itunesNamespace, "image")[0];
                        const thumb = imageElement ? imageElement.getAttribute("href") : "/assets/img/podcast-logo.png";
                        
                        const dateObj = new Date(pubDate);
                        const formattedDate = dateObj.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
                        
                        const decoder = document.createElement('div');
                        decoder.innerHTML = description;
                        const decodedDesc = decoder.textContent || decoder.innerText || "";
                        const cleanDesc = decodedDesc.replace(/<[^>]*>?/gm, '').replace(/&quot;/g, '"').trim();
                        const formattedDesc = cleanDesc.replace(/"([A-Z])/g, '" $1');
                        const shortDesc = formattedDesc.substring(0, 180) + (formattedDesc.length > 180 ? '...' : '');

                        allEpisodeCards.push(`
                            <div class="episode-card group relative flex flex-col sm:flex-row gap-6 p-6 rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_97%,var(--ink)_3%)] hover:border-[var(--ink)] transition-all animate-enter" 
                                 data-episode-id="${guid}" 
                                 data-title="${title}" 
                                 data-meta="${formattedDate} • ${duration}" 
                                 data-thumb="${thumb}"
                                 data-audio-url="${audioUrl}">
                                
                                <div class="w-full aspect-square sm:w-32 sm:h-32 flex-shrink-0 bg-[var(--paper)] rounded border border-[var(--rule)] overflow-hidden relative group/art cursor-pointer" onclick="if(window.openLightbox) openLightbox('${thumb}')">
                                    <img src="${thumb}" alt="${title}" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
                                    
                                    ${audioUrl ? `
                                    <button class="play-btn absolute inset-0 flex items-center justify-center bg-[var(--ink)]/40 opacity-0 group-hover/art:opacity-100 transition-opacity text-[var(--paper)]">
                                        <div class="play-icon w-10 h-10 flex items-center justify-center rounded-full border-2 border-[var(--paper)]">
                                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                                <path d="M8 5v14l11-7z"/>
                                            </svg>
                                        </div>
                                    </button>
                                    ` : ''}
                                </div>
                                
                                <div class="flex-1 flex flex-col justify-between">
                                    <div>
                                        <div class="flex items-center gap-3 text-[10px] uppercase font-bold tracking-widest text-[var(--muted)] mb-2">
                                             <span>${formattedDate}</span>
                                             <span class="w-1 h-1 rounded-full bg-[var(--rule)]"></span>
                                             <span>${duration}</span>
                                        </div>
                                        <h3 class="font-serif text-xl sm:text-2xl mb-2 text-[var(--ink)] group-hover:accent-text transition-colors">${title}</h3>
                                        <p class="text-[14px] text-[var(--muted)] leading-relaxed m-0">${shortDesc}</p>
                                    </div>
                                </div>
                            </div>
                        `);
                    });
                    
                    totalPages = Math.ceil(allEpisodeCards.length / EPISODES_PER_PAGE);
                    currentPage = 1;
                    renderPage(currentPage);

                    if (countDisplay) {
                        countDisplay.textContent = `${items.length} Episodes`;
                    }
                }
            } catch (e) {
                console.error("Failed to fetch podcast archive:", e);
                if (errorDisplay) {
                   errorDisplay.textContent = "Failed to load archive. Please try refreshing.";
                   errorDisplay.classList.remove('hidden');
                }
            }
        }

        function renderPage(page) {
            const archive = document.getElementById('podcast-archive');
            if (!archive) return;

            currentPage = page;
            const start = (page - 1) * EPISODES_PER_PAGE;
            const end = start + EPISODES_PER_PAGE;
            const pageCards = allEpisodeCards.slice(start, end);

            archive.innerHTML = pageCards.join('');
            
            // Animate cards in
            archive.querySelectorAll('.animate-enter').forEach((el, i) => {
                setTimeout(() => el.classList.add('visible'), i * 60);
            });

            initPodcastActions();
            renderPagination();

            // Scroll to top of archive
            const archiveHeader = document.querySelector('.archive-scroll-target');
            if (archiveHeader && page > 1) {
                archiveHeader.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function renderPagination() {
            const container = document.getElementById('podcast-pagination');
            if (!container || totalPages <= 1) {
                if (container) container.innerHTML = '';
                return;
            }

            const maxVisible = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);
            if (endPage - startPage + 1 < maxVisible) {
                startPage = Math.max(1, endPage - maxVisible + 1);
            }

            let html = `<nav class="flex items-center justify-center gap-2 pt-12 pb-4" aria-label="Podcast archive pagination">`;

            // Previous button
            html += `<button 
                onclick="renderPage(${currentPage - 1})" 
                ${currentPage === 1 ? 'disabled' : ''}
                class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded border text-[11px] font-bold uppercase tracking-widest transition-all
                       ${currentPage === 1 
                         ? 'border-[var(--rule)]/30 text-[var(--muted)]/40 cursor-not-allowed' 
                         : 'border-[var(--rule)] text-[var(--muted)] hover:border-[var(--ink)] hover:text-[var(--ink)]'}">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg>
                Prev
            </button>`;

            // First page + ellipsis
            if (startPage > 1) {
                html += pageButton(1);
                if (startPage > 2) {
                    html += `<span class="px-1 text-[var(--muted)]/40 text-sm select-none">…</span>`;
                }
            }

            // Page number buttons
            for (let i = startPage; i <= endPage; i++) {
                html += pageButton(i);
            }

            // Last page + ellipsis
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    html += `<span class="px-1 text-[var(--muted)]/40 text-sm select-none">…</span>`;
                }
                html += pageButton(totalPages);
            }

            // Next button
            html += `<button 
                onclick="renderPage(${currentPage + 1})" 
                ${currentPage === totalPages ? 'disabled' : ''}
                class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded border text-[11px] font-bold uppercase tracking-widest transition-all
                       ${currentPage === totalPages 
                         ? 'border-[var(--rule)]/30 text-[var(--muted)]/40 cursor-not-allowed' 
                         : 'border-[var(--rule)] text-[var(--muted)] hover:border-[var(--ink)] hover:text-[var(--ink)]'}">
                Next
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
            </button>`;

            html += `</nav>`;

            // Page info
            const startEp = (currentPage - 1) * EPISODES_PER_PAGE + 1;
            const endEp = Math.min(currentPage * EPISODES_PER_PAGE, allEpisodeCards.length);
            html += `<p class="text-center text-[11px] font-bold uppercase tracking-widest text-[var(--muted)]/60 pb-2">
                Showing ${startEp}–${endEp} of ${allEpisodeCards.length}
            </p>`;

            container.innerHTML = html;
        }

        function pageButton(num) {
            const isActive = num === currentPage;
            return `<button 
                onclick="renderPage(${num})" 
                class="w-10 h-10 rounded border text-sm font-bold transition-all
                       ${isActive 
                         ? 'bg-[var(--ink)] text-[var(--paper)] border-[var(--ink)]' 
                         : 'border-[var(--rule)] text-[var(--muted)] hover:border-[var(--ink)] hover:text-[var(--ink)]'}"
                ${isActive ? 'aria-current="page"' : ''}>
                ${num}
            </button>`;
        }

        function initPodcastActions() {
            document.querySelectorAll('.play-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const card = btn.closest('.episode-card');
                    if (card) {
                        const id = card.dataset.episodeId || '';
                        const url = card.dataset.audioUrl || '';
                        const title = card.dataset.title || '';
                        const meta = card.dataset.meta || '';
                        const thumb = card.dataset.thumb || '';
                        if (window.playEpisode) {
                            window.playEpisode(id, url, title, meta, thumb);
                        }
                    }
                });
            });
        }

        // Expose renderPage globally for onclick handlers
        window.renderPage = renderPage;

        document.addEventListener('astro:page-load', fetchPodcastArchive);

        (function() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry, i) => {
                    if (entry.isIntersecting) {
                        setTimeout(() => {
                            entry.target.classList.add('visible');
                        }, (i % 6) * 80);
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.animate-enter').forEach(el => observer.observe(el));
        })();
    </script>
</Layout>

