---
import Layout from '../layouts/Layout.astro';
import registry from '../data/registry.json';
import RegistryCard from '../components/RegistryCard.astro';

const PAGE_SIZE = 12;

// Industries ordered by how many builders they have, so the busiest filters come first.
const industryCounts = registry.reduce<Record<string, number>>((counts, company) => {
    counts[company.industry] = (counts[company.industry] ?? 0) + 1;
    return counts;
}, {});
const industries = Object.keys(industryCounts).sort((a, b) => industryCounts[b] - industryCounts[a]);
---

<Layout
    title="Registry | Sandbox Réseau"
    description="Discover the products, startups, and organizations building in the Sandbox Réseau ecosystem. A curated directory of builders from Accra and beyond."
>
    <main class="registry-page">
        <section class="registry-head" aria-labelledby="registry-title">
            <span class="registry-pill"><span class="registry-dot" aria-hidden="true"></span>Registry · {registry.length} builders · {industries.length} industries</span>
            <h1 id="registry-title">The builder registry.</h1>
            <p>A curated directory of the products, startups, and organizations connected to the Sandbox Réseau community. All builder-led. All shipping.</p>
        </section>

        <section class="registry-body" aria-label="Builders">
            <div class="registry-toolbar">
                <label class="registry-search">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M7 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM14 14l-3.5-3.5" /></svg>
                    <span class="sr-only">Search the registry</span>
                    <input type="search" placeholder="Search builders, tags…" autocomplete="off" data-registry-search />
                </label>
                <div class="registry-filters" role="group" aria-label="Filter by industry">
                    <button type="button" class="registry-chip" aria-pressed="true" data-registry-filter="All">All <span>{registry.length}</span></button>
                    {industries.map((industry) => (
                        <button type="button" class="registry-chip" aria-pressed="false" data-registry-filter={industry}>{industry} <span>{industryCounts[industry]}</span></button>
                    ))}
                </div>
            </div>

            <p class="registry-count" aria-live="polite" data-registry-count>Showing {Math.min(PAGE_SIZE, registry.length)} of {registry.length}</p>

            <div class="registry-grid" data-registry-grid data-page-size={PAGE_SIZE}>
                {registry.map((company, index) => (
                    <RegistryCard
                        company={company}
                        hidden={index >= PAGE_SIZE}
                        data-industry={company.industry}
                        data-search={[company.name, company.description, company.industry, company.location, ...company.tags].join(' ').toLowerCase()}
                    />
                ))}
            </div>

            <div class="registry-empty" hidden data-registry-empty>
                <h2>No builders found.</h2>
                <p>Try a different search or industry.</p>
                <button type="button" data-registry-clear>Clear filters</button>
            </div>

            <div class="registry-more" hidden={registry.length <= PAGE_SIZE} data-registry-more-wrap>
                <button type="button" data-registry-more>Load more builders</button>
            </div>
        </section>

        <section class="registry-cta" aria-labelledby="registry-cta-title">
            <div class="registry-cta-card">
                <h2 id="registry-cta-title">Building something?</h2>
                <p>If you’re part of the Sandbox Réseau community and shipping a product, you belong here. Drop your project in <strong>#show-your-work</strong> on Discord and we’ll add you to the registry.</p>
                <a class="registry-cta-button" href="https://discord.gg/RMcBDRrV7x" target="_blank" rel="noreferrer">
                    Join the Discord
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
                </a>
            </div>
        </section>
    </main>
</Layout>

<script>
    function initRegistry() {
        const grid = document.querySelector<HTMLElement>('[data-registry-grid]');
        if (!grid) return;

        const cards = Array.from(grid.querySelectorAll<HTMLElement>('.registry-card'));
        const search = document.querySelector<HTMLInputElement>('[data-registry-search]');
        const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-registry-filter]'));
        const count = document.querySelector<HTMLElement>('[data-registry-count]');
        const empty = document.querySelector<HTMLElement>('[data-registry-empty]');
        const moreWrap = document.querySelector<HTMLElement>('[data-registry-more-wrap]');
        const pageSize = Number(grid.dataset.pageSize) || 12;

        let filter = 'All';
        let query = '';
        let limit = pageSize;

        const render = () => {
            const matches = cards.filter((card) =>
                (filter === 'All' || card.dataset.industry === filter) && (!query || card.dataset.search?.includes(query)));
            const shown = new Set(matches.slice(0, limit));

            cards.forEach((card) => { card.hidden = !shown.has(card); });
            chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.registryFilter === filter)));
            if (count) count.textContent = matches.length ? `Showing ${shown.size} of ${matches.length}` : '';
            if (empty) empty.hidden = matches.length > 0;
            if (moreWrap) moreWrap.hidden = matches.length <= limit;
        };

        search?.addEventListener('input', () => {
            query = search.value.trim().toLowerCase();
            limit = pageSize;
            render();
        });
        chips.forEach((chip) => chip.addEventListener('click', () => {
            filter = chip.dataset.registryFilter || 'All';
            limit = pageSize;
            render();
        }));
        document.querySelector('[data-registry-more]')?.addEventListener('click', () => {
            limit += pageSize;
            render();
        });
        document.querySelector('[data-registry-clear]')?.addEventListener('click', () => {
            if (search) search.value = '';
            query = '';
            filter = 'All';
            limit = pageSize;
            render();
        });
    }

    // Elements are replaced on each navigation, so binding per page load doesn't accumulate listeners.
    document.addEventListener('astro:page-load', initRegistry);
</script>

<style>
    .registry-page{font-family:Inter,system-ui,sans-serif;color:#0a0a0a}
    .registry-head{max-width:1040px;margin:0 auto;padding:152px 32px 0}
    .registry-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid rgba(10,10,10,.1);border-radius:999px;color:#6b6b6b;font-size:13px;font-weight:500}
    .registry-dot{width:7px;height:7px;border-radius:50%;background:#8fbf24}
    .registry-head h1{margin:24px 0 0;font-size:clamp(2.5rem,1.6rem + 3vw,4rem);font-weight:600;line-height:1.02;letter-spacing:-.03em}
    .registry-head p{max-width:50ch;margin:20px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .registry-body{max-width:1040px;margin:0 auto;padding:56px 32px 0}
    .registry-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:16px}
    .registry-search{display:flex;align-items:center;gap:10px;flex:1 1 260px;max-width:340px;height:44px;padding:0 18px;border:1px solid rgba(10,10,10,.1);border-radius:999px;color:#a1a1a1;transition:border-color .2s}
    .registry-search:focus-within{border-color:rgba(10,10,10,.3)}
    .registry-search input{flex:1;min-width:0;border:0;background:transparent;color:#0a0a0a;font:inherit;font-size:15px;outline:none}
    .registry-search input::placeholder{color:#a1a1a1}
    .registry-filters{display:flex;flex-wrap:wrap;gap:8px}
    .registry-chip{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 14px;border:1px solid rgba(10,10,10,.1);border-radius:999px;background:#fff;color:#6b6b6b;font:inherit;font-size:14px;font-weight:500;cursor:pointer;transition:border-color .2s,background-color .2s,color .2s}
    .registry-chip span{color:#a1a1a1;font-size:12px;font-variant-numeric:tabular-nums}
    .registry-chip:hover{border-color:rgba(10,10,10,.3);color:#0a0a0a}
    .registry-chip[aria-pressed="true"]{border-color:#0a0a0a;background:#0a0a0a;color:#fff}
    .registry-chip[aria-pressed="true"] span{color:rgba(255,255,255,.6)}
    .registry-count{min-height:1.4em;margin:28px 0 16px;color:#a1a1a1;font-size:14px}
    .registry-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .registry-empty{padding:72px 24px;border:1px dashed rgba(10,10,10,.15);border-radius:28px;text-align:center}
    .registry-empty h2{margin:0;font-size:22px;font-weight:600}
    .registry-empty p{margin:8px 0 0;color:#6b6b6b}
    .registry-empty button,.registry-more button{height:44px;margin-top:24px;padding:0 24px;border:1px solid rgba(10,10,10,.1);border-radius:999px;background:#fff;color:#0a0a0a;font:inherit;font-size:15px;font-weight:600;cursor:pointer;transition:border-color .2s}
    .registry-empty button:hover,.registry-more button:hover{border-color:rgba(10,10,10,.4)}
    .registry-more{display:flex;justify-content:center;margin-top:24px}
    .registry-more[hidden],.registry-empty[hidden]{display:none}
    .registry-cta{max-width:1040px;margin:0 auto;padding:80px 32px 64px}
    .registry-cta-card{display:flex;flex-direction:column;align-items:center;padding:72px 32px;border-radius:28px;background:#f5f5f5;text-align:center}
    .registry-cta-card h2{margin:0;font-size:clamp(1.5rem,1.15rem + 1.5vw,2.25rem);font-weight:600;line-height:1.1;letter-spacing:-.015em}
    .registry-cta-card p{max-width:50ch;margin:16px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .registry-cta-card strong{color:#0a0a0a;font-weight:600}
    .registry-cta-button{display:inline-flex;align-items:center;gap:10px;height:48px;margin-top:32px;padding:0 28px;border-radius:999px;background:#0a0a0a;color:#fff;font-size:16px;font-weight:600;text-decoration:none;transition:background-color .2s,transform .2s}
    .registry-cta-button:hover{background:rgba(10,10,10,.9)}.registry-cta-button:active{transform:scale(.99)}
    @media(max-width:1023px){.registry-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:639px){.registry-head{padding:120px 24px 0}.registry-body{padding:40px 24px 0}.registry-search{max-width:none}.registry-filters{flex-wrap:nowrap;margin:0 -24px;padding:0 24px;overflow-x:auto;scrollbar-width:none}.registry-chip{flex-shrink:0}.registry-grid{grid-template-columns:1fr}.registry-cta{padding:64px 24px 48px}.registry-cta-card{padding:56px 24px}}
</style>
