---
import Layout from '../layouts/Layout.astro';

// Sign-ups are collected in Google Forms; swap this link if the form changes.
const formUrl = 'https://forms.gle/dqTPR5NtfC5fjTAH9';
const discordInvite = 'https://discord.gg/RMcBDRrV7x';

const svg = (path: string, size = 18) =>
    `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${path}</svg>`;

const arrow = '<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>';
const check = '<svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" /></svg>';

const steps = [
    { title: 'Apply', desc: 'Tell us your devices, what you’d like to test and how much time you have.' },
    { title: 'Get matched', desc: 'When a product fits you, we send an invite with what to test.' },
    { title: 'Test and tell', desc: 'Try it, then tell the founder what works and what doesn’t.' },
];

const features = [
    { title: 'First look', desc: 'Use new apps and products before they launch, while they’re still being shaped.', icon: svg('<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>') },
    { title: 'A line to the founder', desc: 'Talk to the people building it, not a support inbox.', icon: svg('<path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l.9-4.4A8 8 0 1 1 20 12Z"/>') },
    { title: 'Feedback that counts', desc: 'Good notes become real fixes and features. You’ll see what changed.', icon: svg('<path d="m4 12.5 5 5L20 6.5"/>') },
    { title: 'A sharper eye', desc: 'Learn how products get built, and what makes them work. Handy if you design, build or want to.', icon: svg('<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3"/>') },
    { title: 'A place in the community', desc: 'Meet founders and fellow testers across the Sandbox Réseau community.', icon: svg('<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5c.6-3.2 3-5 6-5s5.4 1.8 6 5"/><path d="M16 5.6a3.2 3.2 0 0 1 0 5.8M17.5 14.7c1.9.6 3.1 2.3 3.5 4.8"/>') },
    { title: 'On your terms', desc: 'Free to join. Set your hours, pick what fits and skip any invite.', icon: svg('<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>') },
];

// Pre-filled into the Google Form: the page's choices become the first answers on the application.
const formBase = 'https://docs.google.com/forms/d/e/1FAIpQLScBSDsS16KerMGmBOsJ6QGUWHVIwZkwT5Yb7xmw4RyPF7uj3g/viewform';
const fields = [
    { entry: '373108274', label: 'Which do you use?', hint: 'Pick all that apply', multi: true, options: [['iOS', 'iOS'], ['Android', 'Android'], ['Windows', 'Windows'], ['macOS', 'macOS'], ['Linux', 'Linux']] },
    { entry: '82861280', label: 'What would you most like to test?', hint: 'Pick one', multi: false, options: [['Mobile apps', 'Mobile Applications'], ['Desktop software', 'Desktop Software'], ['Smart home devices', 'Smart Home Devices'], ['Wearables', 'Wearables'], ['Gaming peripherals', 'Gaming Peripherals']] },
    { entry: '719469306', label: 'How much time a week?', hint: 'Pick one', multi: false, options: [['1–3 hours', '1 to 3 hours'], ['4–6 hours', '4 to 6 hours'], ['7–10 hours', '7 to 10 hours'], ['10+ hours', 'More than 10 hours']] },
];

const faqs = [
    { q: 'Does it cost anything?', a: 'No. The Test Club is free to join.', icon: svg('<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.2"/>', 17) },
    { q: 'Do I need testing experience?', a: 'No. The form asks about your experience so we can match you well, but first-timers are welcome. If you use apps and have opinions, you’re qualified.', icon: svg('<path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M6 10.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5"/>', 17) },
    { q: 'How much time does it take?', a: 'You decide. The form asks how many hours a week you can give, from 1–3 hours upwards, and you can turn down any invite.', icon: svg('<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>', 17) },
    { q: 'Which devices can I test on?', a: 'Phones and computers running iOS, Android, Windows, macOS or Linux. Some tests are for hardware like wearables or smart home devices.', icon: svg('<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>', 17) },
    { q: 'What happens to my details?', a: 'We use them to match you with tests and get in touch about them. Products you test may not be public yet, so we ask that you keep them to yourself too.', icon: svg('<rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/>', 17) },
    { q: 'I’m a founder. How do I get testers?', a: 'Join the Discord and post in #testing-pool. Tell us what you’re building and who you need, and we’ll help you find them.', icon: svg('<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>', 17) },
];
---

<Layout
    title="Test Club | Sandbox Réseau"
    description="Join the Sandbox Réseau Test Club. Try new apps and products from Accra’s builders before they launch, and help shape what ships."
    image="/assets/img/event-3.jpg"
    imageAlt="A founder demoing an app at a Sandbox Réseau edition"
>
    <main class="tc-page">
        <section class="tc-hero" aria-labelledby="tc-title">
            <h1 id="tc-title">Try it first.<br />Shape what ships.</h1>
            <p>Join the Sandbox Réseau Test Club and get early access to new apps and products from founders in our community, before they launch.</p>
            <div class="tc-actions">
                <a class="tc-btn tc-btn-dark" href={formUrl} target="_blank" rel="noreferrer">Join the Test Club <Fragment set:html={arrow} /></a>
                <a class="tc-btn tc-btn-line" href="#apply">Start here</a>
            </div>

            <div class="tc-stage" aria-hidden="true">
                <div class="tc-stage-card tc-stage-invite">
                    <div class="tc-stage-top"><span class="tc-stage-kicker"><span></span>New test invite</span><span class="tc-stage-tag">Example</span></div>
                    <strong>A new savings app</strong>
                    <p>Sign up, set a goal and make your first deposit. Tell us where you got stuck.</p>
                    <div class="tc-phone-meta"><span>~15 min</span><span>iOS · Android</span></div>
                </div>
                <div class="tc-phone">
                    <div class="tc-phone-bar"><span>09:41</span><span class="tc-phone-icons"><i></i><i></i><i></i></span></div>
                    <p class="tc-phone-title">Test Club</p>
                    <div class="tc-phone-tip">Tap I’m in</div>
                    <div class="tc-phone-card">
                        <span class="tc-phone-kicker"><span></span>New invite</span>
                        <strong>A new savings app</strong>
                        <p>Sign up, set a goal, make a first deposit.</p>
                        <div class="tc-phone-meta"><span>~15 min</span><span>iOS · Android</span></div>
                        <span class="tc-phone-yes">I’m in</span>
                    </div>
                    <div class="tc-phone-tabs"><span class="is-on">Invites</span><span>Feedback</span><span>Profile</span></div>
                </div>
                <div class="tc-stage-card tc-stage-feedback">
                    <span class="tc-stage-sent"><svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7" /></svg>Feedback sent</span>
                    <p class="tc-stage-quote">“Took me a while to find the deposit button. Maybe put it on the home screen?”</p>
                    <span class="tc-stage-reply"><span></span>Founder replied · Fixed in v1.2</span>
                </div>
            </div>
        </section>

        <section class="tc-section" id="how" aria-labelledby="tc-how">
            <h2 id="tc-how">Apply once.<br />Then just test.</h2>
            <ol class="tc-steps">
                {steps.map((step, index) => (
                    <li>
                        <span class="tc-step-n">{index + 1}</span>
                        <h3>{step.title}</h3>
                        <p>{step.desc}</p>
                        <div class="tc-step-ui" aria-hidden="true">
                            {index === 0 && (
                                <div class="tc-ui tc-ui-form">
                                    <p>Which systems do you use?</p>
                                    <div class="tc-ui-chips"><span class="is-on">iOS</span><span class="is-on">Android</span><span>Windows</span><span class="is-on">macOS</span></div>
                                    <p>Hours a week</p>
                                    <div class="tc-ui-select">1 to 3 hours <span>⌄</span></div>
                                </div>
                            )}
                            {index === 1 && (
                                <div class="tc-ui tc-ui-notes">
                                    <div class="tc-ui-note"><span class="tc-ui-dot"></span><div><strong>New invite</strong><small>A new savings app · ~15 min</small></div><em>now</em></div>
                                    <div class="tc-ui-note is-old"><span class="tc-ui-dot"></span><div><strong>New invite</strong><small>A fitness wearable · 1 week</small></div><em>2d</em></div>
                                    <div class="tc-ui-note is-old"><span class="tc-ui-dot"></span><div><strong>Thanks for testing</strong><small>Your notes shipped in v1.2</small></div><em>1w</em></div>
                                </div>
                            )}
                            {index === 2 && (
                                <div class="tc-ui tc-ui-chat">
                                    <div class="tc-ui-bubble">Took me a while to find the deposit button. Maybe put it on the home screen?</div>
                                    <div class="tc-ui-bubble is-founder">Great catch. Moving it in the next build 🙌</div>
                                </div>
                            )}
                        </div>
                    </li>
                ))}
            </ol>
        </section>

        <section class="tc-dark" aria-labelledby="tc-why">
            <div class="tc-dark-inner">
                <h2 id="tc-why">What you get.</h2>
                <ul class="tc-features">
                    {features.map((feature) => (
                        <li>
                            <span class="tc-feature-icon" set:html={feature.icon} />
                            <h3>{feature.title}</h3>
                            <p>{feature.desc}</p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <section class="tc-section" id="apply" aria-labelledby="tc-pick">
            <h2 id="tc-pick">Start your application.</h2>
            <p class="tc-lede">Answer three quick questions here. We’ll carry your answers into the application form, so you only fill in the rest.</p>
            <form class="tc-apply" data-tc-apply data-base={formBase}>
                {fields.map((field) => (
                    <fieldset data-entry={field.entry} data-multi={field.multi ? 'true' : undefined}>
                        <legend>{field.label}<span>{field.hint}</span></legend>
                        <div class="tc-chips">
                            {field.options.map(([label, value]) => (
                                <button type="button" class="tc-chip" data-value={value} aria-pressed="false" role={field.multi ? undefined : 'radio'} aria-checked={field.multi ? undefined : 'false'}>
                                    <span class="tc-chip-box" set:html={check} />{label}
                                </button>
                            ))}
                        </div>
                    </fieldset>
                ))}
                <div class="tc-apply-foot">
                    <a class="tc-btn tc-btn-dark" href={formUrl} target="_blank" rel="noreferrer" data-tc-continue>Continue to the application <Fragment set:html={arrow} /></a>
                    <p class="tc-count" data-tc-status>Pick your answers, or skip straight to the form.</p>
                </div>
            </form>
        </section>

        <section class="tc-band" aria-labelledby="tc-band-title">
            <div>
                <h2 id="tc-band-title">Be the first to try what’s next.</h2>
                <p>Free to join. The application takes a few minutes.</p>
            </div>
            <div class="tc-band-actions">
                <a class="tc-btn tc-btn-white" href={formUrl} target="_blank" rel="noreferrer">Join the Test Club <Fragment set:html={arrow} /></a>
                <a class="tc-btn tc-btn-ghost" href={discordInvite} target="_blank" rel="noreferrer">Need testers?</a>
            </div>
        </section>

        <section class="tc-section tc-faq" aria-labelledby="tc-faq">
            <h2 id="tc-faq">Test Club questions,<br />answered.</h2>
            <div class="tc-faq-list">
                {faqs.map((faq) => (
                    <details>
                        <summary>
                            <span class="tc-faq-icon" set:html={faq.icon} />
                            <span class="tc-faq-q">{faq.q}</span>
                            <svg class="tc-faq-plus" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M8 3.5v9M3.5 8h9" /></svg>
                        </summary>
                        <p>{faq.a}</p>
                    </details>
                ))}
            </div>
        </section>
    </main>
</Layout>

<script>
    // "Start your application": chips become pre-filled answers on the Google Form.
    function initApply() {
        const form = document.querySelector<HTMLFormElement>('[data-tc-apply]');
        const link = document.querySelector<HTMLAnchorElement>('[data-tc-continue]');
        const status = document.querySelector('[data-tc-status]');
        if (!form || !link || !status || form.dataset.ready) return;
        form.dataset.ready = 'true';
        const groups = Array.from(form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-entry]'));
        const sync = () => {
            const params = new URLSearchParams({ usp: 'pp_url' });
            let answered = 0;
            for (const group of groups) {
                const chosen = Array.from(group.querySelectorAll<HTMLButtonElement>('.tc-chip[aria-pressed="true"]'));
                if (chosen.length) answered++;
                chosen.forEach((chip) => params.append(`entry.${group.dataset.entry}`, chip.dataset.value ?? ''));
            }
            link.href = answered ? `${form.dataset.base}?${params}` : form.dataset.base!;
            status.textContent = answered === 0 ? 'Pick your answers, or skip straight to the form.' : answered === groups.length ? 'All set. Your answers will be filled in on the form.' : `${answered} of ${groups.length} answered. These will be filled in on the form.`;
        };
        form.addEventListener('click', (event) => {
            const chip = (event.target as Element).closest<HTMLButtonElement>('.tc-chip');
            const group = chip?.closest<HTMLFieldSetElement>('fieldset');
            if (!chip || !group) return;
            const on = chip.getAttribute('aria-pressed') !== 'true';
            if (!group.dataset.multi) {
                group.querySelectorAll('.tc-chip').forEach((other) => { other.setAttribute('aria-pressed', 'false'); other.setAttribute('aria-checked', 'false'); });
                chip.setAttribute('aria-checked', String(on));
            }
            chip.setAttribute('aria-pressed', String(on));
            sync();
        });
        sync();
    }
    document.addEventListener('astro:page-load', initApply);
</script>

<style>
    .tc-page{padding:0 0 32px;font-family:Inter,system-ui,sans-serif;color:#0a0a0a}
    .tc-page h2{margin:0;font-size:clamp(1.75rem,1.3rem + 1.8vw,2.625rem);font-weight:600;line-height:1.08;letter-spacing:-.03em}

    /* Buttons */
    .tc-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;height:48px;padding:0 24px;border-radius:999px;font-size:15px;font-weight:600;text-decoration:none;white-space:nowrap;transition:background-color .2s,border-color .2s,color .2s}
    .tc-btn-dark{background:#0a0a0a;color:#fff}
    .tc-btn-dark:hover{background:#2a2a2a}
    .tc-btn-line{border:1px solid rgba(10,10,10,.15);color:#0a0a0a}
    .tc-btn-line:hover{border-color:#0a0a0a}
    .tc-btn-white{background:#fff;color:#0a0a0a}
    .tc-btn-white:hover{background:#d3fa69}
    .tc-btn-ghost{border:1px solid rgba(255,255,255,.25);color:#fff}
    .tc-btn-ghost:hover{border-color:#fff}

    /* Hero: headline, copy and buttons, then a wide photo with a phone beside it */
    .tc-hero{max-width:1040px;margin:0 auto;padding:148px 32px 0}
    .tc-hero h1{margin:0;font-size:clamp(2.75rem,1.6rem + 4vw,4.5rem);font-weight:600;line-height:1.02;letter-spacing:-.045em}
    .tc-hero>p{max-width:44ch;margin:22px 0 0;color:#6b6b6b;font-size:18px;line-height:1.5}
    .tc-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}
    .tc-stage{position:relative;display:flex;align-items:center;justify-content:center;gap:40px;margin-top:56px;padding:56px 32px;overflow:hidden;border-radius:28px;background:radial-gradient(90% 70% at 50% 100%,rgba(211,250,105,.35),transparent 70%),#f3f3f1}
    /* The site's brush doodles, faded to read like pencil sketches behind the phone */
    .tc-stage{isolation:isolate}
    .tc-stage::before,.tc-stage::after{content:'';position:absolute;z-index:-1;background:center/contain no-repeat;pointer-events:none}
    .tc-stage::before{left:50%;top:50%;width:min(720px,92%);aspect-ratio:1425/816;background-image:url('/assets/img/cta-doodle-sweep.svg');opacity:.13;transform:translate(-50%,-46%) rotate(-8deg)}
    .tc-stage::after{right:6%;top:-18px;width:150px;aspect-ratio:1102/1299;background-image:url('/assets/img/cta-doodle-spiral.svg');opacity:.16;transform:rotate(12deg)}
    .tc-stage-card,.tc-phone{position:relative;z-index:1}
    .tc-stage-card{width:250px;padding:18px;border-radius:20px;background:#fff;box-shadow:0 24px 50px -28px rgba(10,10,10,.35),0 0 0 1px rgba(10,10,10,.04)}
    .tc-stage-invite{transform:rotate(-3deg) translateY(-20px)}
    .tc-stage-feedback{transform:rotate(3deg) translateY(30px)}
    .tc-stage-top{display:flex;align-items:center;justify-content:space-between}
    .tc-stage-kicker{display:inline-flex;align-items:center;gap:6px;color:#3a3a3a;font-size:12px;font-weight:600}
    .tc-stage-kicker span{width:6px;height:6px;border-radius:50%;background:#8fbf24}
    .tc-stage-tag{padding:2px 8px;border-radius:999px;background:#f5f5f5;color:#8a8a8a;font-size:11px}
    .tc-stage-card strong{display:block;margin-top:12px;font-size:16px;font-weight:600}
    .tc-stage-card>p{margin:6px 0 0;color:#6b6b6b;font-size:13px;line-height:1.45}
    .tc-stage-card .tc-phone-meta{margin-top:12px}
    .tc-stage-card .tc-phone-meta span{font-size:11px;padding:3px 9px}
    .tc-stage-sent{display:inline-flex;align-items:center;gap:6px;color:#14a03c;font-size:12px;font-weight:600}
    .tc-stage-feedback .tc-stage-quote{color:#0a0a0a;font-size:14px;margin-top:10px}
    .tc-stage-reply{display:flex;align-items:center;gap:6px;margin-top:12px;padding-top:12px;border-top:1px solid rgba(10,10,10,.07);color:#8a8a8a;font-size:12px}
    .tc-stage-reply span{width:6px;height:6px;border-radius:50%;background:#8fbf24}
    .tc-phone{flex-shrink:0;width:200px;position:relative;display:flex;flex-direction:column;height:410px;padding:14px 12px 10px;border:1.5px solid #1a1a1a;border-radius:34px;background:#f1f2f4;box-shadow:inset 0 0 0 5px #fff,0 30px 60px -30px rgba(10,10,10,.35)}
    .tc-phone-bar{display:flex;justify-content:space-between;padding:4px 10px 0;font-size:10.5px;font-weight:600}
    .tc-phone-icons{display:flex;gap:2px;align-items:flex-end}
    .tc-phone-icons i{display:block;width:3px;border-radius:1px;background:#0a0a0a}
    .tc-phone-icons i:nth-child(1){height:5px}.tc-phone-icons i:nth-child(2){height:7px}.tc-phone-icons i:nth-child(3){height:9px}
    .tc-phone-title{margin:18px 0 0;font-size:12px;font-weight:600;letter-spacing:.06em;text-align:center;text-transform:uppercase}
    .tc-phone-tip{position:relative;align-self:center;margin-top:22px;padding:5px 10px;border-radius:999px;background:#0a0a0a;color:#fff;font-size:10px;font-weight:600}
    .tc-phone-tip::after{content:'↓';position:absolute;left:50%;bottom:-15px;color:#0a0a0a;font-size:11px;transform:translateX(-50%)}
    .tc-phone-card{margin-top:20px;padding:12px;border-radius:16px;background:#fff;box-shadow:0 8px 20px -12px rgba(10,10,10,.25)}
    .tc-phone-kicker{display:inline-flex;align-items:center;gap:5px;color:#3a3a3a;font-size:9.5px;font-weight:600}
    .tc-phone-kicker span{width:5px;height:5px;border-radius:50%;background:#8fbf24}
    .tc-phone-card strong{display:block;margin-top:6px;font-size:12.5px;font-weight:600}
    .tc-phone-card p{margin:3px 0 0;color:#6b6b6b;font-size:10px;line-height:1.4}
    .tc-phone-meta{display:flex;gap:4px;margin-top:8px}
    .tc-phone-meta span{padding:2px 7px;border-radius:999px;background:#f1f2f4;font-size:9px;font-weight:500}
    .tc-phone-yes{display:grid;place-items:center;height:28px;margin-top:10px;border-radius:999px;background:#d3fa69;font-size:11px;font-weight:600}
    .tc-phone-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin-top:auto;padding:5px;border-radius:999px;background:#fff;font-size:9px;font-weight:500;text-align:center}
    .tc-phone-tabs span{padding:6px 0;border-radius:999px;color:#8a8a8a}
    .tc-phone-tabs .is-on{background:#f1f2f4;color:#0a0a0a}

    /* Sections */
    .tc-section{max-width:1040px;margin:0 auto;padding:128px 32px 0}
    .tc-lede{max-width:52ch;margin:16px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}

    /* Steps: number, title, copy, then a cropped slice of the product */
    .tc-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:48px 0 0;padding:0;list-style:none}
    .tc-steps li{display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(10,10,10,.1);border-radius:24px}
    .tc-step-n{display:grid;place-items:center;width:28px;height:28px;margin:24px 24px 0;border:1px solid rgba(10,10,10,.15);border-radius:50%;color:#6b6b6b;font-size:13px;font-weight:500}
    .tc-steps h3{margin:20px 24px 0;font-size:21px;font-weight:600;letter-spacing:-.015em}
    .tc-steps li>p{margin:6px 24px 0;color:#6b6b6b;font-size:15px;line-height:1.45}
    .tc-step-ui{height:170px;margin-top:auto;padding:20px 20px 0;border-top:1px solid rgba(10,10,10,.08);background:linear-gradient(#fafafa,#f2f2f2);overflow:hidden}
    .tc-steps li>p{margin-bottom:24px}
    .tc-ui{height:100%;padding:14px;border-radius:16px 16px 0 0;background:#fff;box-shadow:0 0 0 1px rgba(10,10,10,.06),0 10px 30px -18px rgba(10,10,10,.3)}
