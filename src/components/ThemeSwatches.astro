---
---
<div class="flex flex-col items-center gap-2 pb-4">
    <div class="flex items-center gap-3 text-[11px] font-semibold tracking-[.18em] uppercase text-[var(--muted)]">
        <span>Theme</span>
        <div class="flex items-center gap-1">
            <button class="h-[18px] w-[18px] rounded-full border border-[var(--rule)] bg-[#fbfaf7]"
                data-theme-swatch="white" aria-label="White theme"></button>
            <button class="h-[18px] w-[18px] rounded-full border border-[var(--rule)] bg-[#0b0b0b]"
                data-theme-swatch="black" aria-label="Black theme"></button>
            <button class="h-[18px] w-[18px] rounded-full border border-[var(--rule)] bg-[#fff7cc]"
                data-theme-swatch="yellow" aria-label="Yellow theme"></button>
        </div>

        <span class="mx-2 h-3 w-px bg-[var(--rule)]/30"></span>

        <span>Color</span>
        <div class="flex items-center gap-1">
            <button class="h-[18px] w-[18px] rounded-full border border-[var(--rule)] bg-[#0ea5e9]"
                data-accent-swatch="blue" aria-label="Blue"></button>
            <button class="h-[18px] w-[18px] rounded-full border border-[var(--rule)] bg-[#10b981]"
                data-accent-swatch="emerald" aria-label="Emerald"></button>
            <button class="h-[18px] w-[18px] rounded-full border border-[var(--rule)] bg-[#8b5cf6]"
                data-accent-swatch="violet" aria-label="Violet"></button>
            <button class="h-[18px] w-[18px] rounded-full border border-[var(--rule)] bg-[#f59e0b]"
                data-accent-swatch="amber" aria-label="Amber"></button>
            <button class="h-[18px] w-[18px] rounded-full border border-[var(--rule)] bg-[#ef4444]"
                data-accent-swatch="red" aria-label="Red"></button>
            <button class="h-[18px] w-[18px] rounded-full border border-[var(--rule)] bg-[#d946ef]"
                data-accent-swatch="fuchsia" aria-label="Fuchsia"></button>
        </div>
    </div>
</div>
