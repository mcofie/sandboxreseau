---
---
<div id="global-player" class="player-bar fixed inset-x-0 bottom-0 z-[60] px-3 pb-3 sm:px-4 sm:pb-4 pointer-events-none">
    <div class="player-card pointer-events-auto relative mx-auto max-w-[1040px] rounded-[20px] sm:rounded-[24px]">
        <div class="flex items-center gap-3 sm:gap-5 px-3 py-3 sm:px-5 sm:py-4">
            <!-- Episode Info -->
            <div class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
                <div class="h-11 w-11 sm:h-12 sm:w-12 flex-shrink-0 overflow-hidden rounded-xl bg-white">
                    <img id="playerThumbnail" alt="" class="h-full w-full object-cover">
                </div>
                <div class="min-w-0">
                    <div id="prefixState" class="player-eyebrow mb-0.5 hidden sm:block">Now Playing</div>
                    <h4 id="playerTitle" class="truncate text-sm sm:text-[15px] font-semibold leading-tight text-white">Select an episode to play</h4>
                    <div id="playerMeta" class="mt-0.5 truncate text-xs text-white/55">00:00 • 0:00</div>
                </div>
            </div>

            <!-- Controls -->
            <div class="flex shrink-0 items-center gap-2 sm:gap-4">
                <div class="hidden md:block text-xs font-medium tabular-nums text-white/55">
                    <span id="playerCurrentTime">0:00</span> / <span id="playerDuration">0:00</span>
                </div>

                <!-- Speed Selector -->
                <div class="relative">
                    <button id="speedToggle" type="button" aria-label="Playback speed" class="speed-toggle">1.0x</button>
                    <div id="speedDropdown" class="speed-dropdown">
                        <div class="speed-option active" data-speed="1">1.0x</div>
                        <div class="speed-option" data-speed="1.25">1.25x</div>
                        <div class="speed-option" data-speed="1.5">1.5x</div>
                        <div class="speed-option" data-speed="1.75">1.75x</div>
                        <div class="speed-option" data-speed="2">2.0x</div>
                    </div>
                </div>

                <!-- Play/Pause -->
                <button id="playerMainToggle" type="button" aria-label="Play or pause" class="flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-white text-[#0a0a0a] transition-transform hover:scale-105 active:scale-95">
                    <svg id="playIconMain" class="h-5 w-5 sm:h-6 sm:w-6 fill-current translate-x-[1px]" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M8 5v14l11-7z"/>
                    </svg>
                    <svg id="pauseIconMain" class="hidden h-5 w-5 sm:h-6 sm:w-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Progress (bottom edge of the card; tall hit area, thin track) -->
        <div id="playerProgressContainer" class="progress-bar-container absolute inset-x-0 bottom-0 overflow-hidden rounded-b-[20px] sm:rounded-b-[24px]">
            <div id="playerProgressBar" class="progress-bar-fill"></div>
        </div>
    </div>
</div>
