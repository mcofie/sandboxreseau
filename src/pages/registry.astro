---
import Layout from '../layouts/Layout.astro';
import registry from '../data/registry.json';

const industries = ['All', ...new Set(registry.map(item => item.industry))];
---

<Layout 
    title="Registry | Sandbox Réseau" 
    description="Discover the products, startups, and organizations building in the Sandbox Réseau ecosystem."
>
    <!-- Static Header -->
    <header class="mx-auto max-w-[1100px] px-4 py-8 md:py-12">
        <div class="max-w-xl">
            <span class="inline-block w-max border-y border-[var(--rule)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[.2em] text-[var(--muted)] mb-3">
                Index
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl leading-tight mb-3">
                The Ecosystem Registry.
            </h2>
            <p class="text-[var(--muted)] text-sm md:text-base leading-relaxed">
                A directory of the products, startups, and organizations building in our ecosystem and connected to Sandbox Réseau.
            </p>
        </div>
    </header>

    <!-- Sticky Control Bar -->
    <section class="sticky top-0 z-20 border-y border-[var(--rule)] bg-[var(--paper)]/95 backdrop-blur-md">
        <div class="mx-auto max-w-[1100px] px-4 py-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <!-- Search -->
                <div class="w-full md:w-72">
                    <div class="relative">
                        <input type="text" id="companySearch" placeholder="Search entries..." aria-label="Search"
                            class="search-input w-full rounded border border-[var(--rule)] bg-[var(--paper)] px-4 py-2 text-sm focus:border-[var(--accent)] outline-none transition-colors" />
                        <div class="absolute right-3 top-2.5 text-[var(--muted)] pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                        </div>
                    </div>
                </div>

                <!-- Filters: Scrollable on Mobile -->
                <div class="flex overflow-x-auto pb-1 md:pb-0 hide-scrollbar -mx-4 px-4 md:mx-0 md:px-0">
                    <div class="flex gap-2 whitespace-nowrap">
                        {industries.map((industry) => (
                            <button 
                                class={`filter-chip rounded-full border border-[var(--rule)] px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider hover:bg-[var(--accent)] hover:text-white transition-all ${industry === 'All' ? 'active bg-[var(--ink)] text-[var(--paper)] border-[var(--ink)]' : 'bg-[var(--paper)] text-[var(--muted)]'}`}
                                data-filter={industry}
                            >
                                {industry}
                            </button>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content List -->
    <main class="mx-auto max-w-[1100px] px-4 py-10">
        <div class="flex flex-col gap-4" id="companyGrid">
            {registry.map(company => (
                <div class="company-card group flex flex-col sm:flex-row items-start gap-5 rounded border border-[var(--rule)] bg-[var(--paper)] p-6 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300" data-industry={company.industry} data-tags={company.tags.join(',')}>
                    <!-- Badge Row Top (Industry, Status) - Always on Top -->
                    <div class="flex-1 w-full">
                        <div class="flex flex-row items-start gap-4 mb-4">
                            <div class="company-logo-container w-12 h-12 sm:w-16 sm:h-16 rounded border border-[var(--rule)] bg-[var(--ink)] text-[var(--paper)] p-1.5 flex items-center justify-center overflow-hidden shrink-0 transition-colors duration-300">
                                {(company.logo.startsWith('http') || company.logo.startsWith('/') || company.logo.startsWith('assets/') || company.logo.includes('.')) 
                                    ? <img src={company.logo.startsWith('assets/') ? `/${company.logo}` : company.logo} alt={`${company.name} Logo`} class="w-full h-full object-contain brightness-[1.1] dark:brightness-100" />
                                    : <span class="font-serif text-xl sm:text-2xl font-bold select-none">{company.logo}</span>
                                }
                            </div>
                            <div class="flex-1 min-w-0 flex flex-col justify-center py-0.5">
                                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                    <h3 class="name font-serif text-xl sm:text-2xl font-bold leading-tight group-hover:accent-text transition-colors">{company.name}</h3>
                                    <span class="px-2 py-0.5 rounded-full border border-[var(--rule)]/20 text-[8px] font-bold uppercase tracking-widest bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)]">{company.status === 'LIVE' ? '● ' + company.status : company.status}</span>
                                </div>
                                <span class="text-[10px] uppercase tracking-widest font-bold text-[var(--accent)] mt-1">{company.industry}</span>
                            </div>
                        </div>
                        <p class="description text-sm text-[var(--muted)] leading-relaxed mb-4 max-w-2xl">
                            {company.description}
                        </p>
                        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[var(--rule)]/5">
                            <div class="flex flex-wrap gap-2 items-center">
                                <span class="text-[9px] font-bold uppercase tracking-widest text-[color:color-mix(in_oklab,var(--ink)_50%,var(--paper)_50%)]">Building in:</span>
                                <span class="text-[10px] font-semibold text-[color:color-mix(in_oklab,var(--ink)_80%,var(--paper)_20%)]">{company.tags.join(' • ')}</span>
                            </div>
                            <div class="flex items-center gap-4 ml-auto">
                                <span class="text-[11px] font-serif text-[var(--muted)]">{company.location || 'Global'}</span>
                                <a href={company.url} target="_blank" rel="noopener noreferrer" class="text-[11px] font-bold uppercase tracking-widest hover:underline accent-text">{company.cta} →</a>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
        
        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-20 border-2 border-dashed border-[var(--rule)]/10 rounded-xl">
            <div class="text-4xl mb-4">🔍</div>
            <h3 class="font-serif text-xl mb-1">No results found</h3>
            <p class="text-[var(--muted)] text-sm">Try adjusting your search or filter to find what you're looking for.</p>
            <button id="clearFilters" class="mt-4 text-xs font-bold uppercase tracking-widest underline accent-text">Clear all filters</button>
        </div>
    </main>

    <script>
        import debounce from 'lodash-es/debounce';

        const searchInput = document.getElementById('companySearch') as HTMLInputElement;
        const companyGrid = document.getElementById('companyGrid');
        const emptyState = document.getElementById('emptyState');
        const cards = document.querySelectorAll('.company-card') as NodeListOf<HTMLElement>;
        const filterChips = document.querySelectorAll('.filter-chip');
        const clearBtn = document.getElementById('clearFilters');

        let currentFilter = 'All';
        let currentSearch = '';

        const updateDisplay = () => {
            let visibleCount = 0;
            
            cards.forEach(card => {
                const name = card.querySelector('.name')?.textContent?.toLowerCase() || '';
                const desc = card.querySelector('.description')?.textContent?.toLowerCase() || '';
                const tags = card.getAttribute('data-tags')?.toLowerCase() || '';
                const industry = card.getAttribute('data-industry') || '';

                const matchesSearch = !currentSearch || 
                    name.includes(currentSearch) || 
                    desc.includes(currentSearch) || 
                    tags.includes(currentSearch);
                
                const matchesFilter = currentFilter === 'All' || industry === currentFilter;

                if (matchesSearch && matchesFilter) {
                    card.classList.remove('hidden');
                    card.classList.add('flex');
                    visibleCount++;
                } else {
                    card.classList.remove('flex');
                    card.classList.add('hidden');
                }
            });

            if (visibleCount === 0) {
                companyGrid?.classList.add('hidden');
                emptyState?.classList.remove('hidden');
            } else {
                companyGrid?.classList.remove('hidden');
                emptyState?.classList.add('hidden');
            }
        };

        // Debounced search
        const handleSearch = debounce((e: Event) => {
            currentSearch = (e.target as HTMLInputElement).value.toLowerCase();
            updateDisplay();
        }, 150);

        searchInput?.addEventListener('input', handleSearch);

        // Filter chips
        filterChips.forEach(chip => {
            chip.addEventListener('click', () => {
                filterChips.forEach(c => {
                    c.classList.remove('active', 'bg-[var(--ink)]', 'text-[var(--paper)]');
                });
                chip.classList.add('active', 'bg-[var(--ink)]', 'text-[var(--paper)]');
                
                currentFilter = chip.getAttribute('data-filter') || 'All';
                updateDisplay();
            });
        });

        // Clear filters
        clearBtn?.addEventListener('click', () => {
            if (searchInput) searchInput.value = '';
            currentSearch = '';
            currentFilter = 'All';
            
            filterChips.forEach(c => {
                c.classList.remove('active', 'bg-[var(--ink)]', 'text-[var(--paper)]');
                if (c.getAttribute('data-filter') === 'All') {
                    c.classList.add('active', 'bg-[var(--ink)]', 'text-[var(--paper)]');
                }
            });
            
            updateDisplay();
        });
    </script>
</Layout>

<style>
    .filter-chip.active {
        background-color: var(--ink);
        color: var(--paper);
    }
</style>
