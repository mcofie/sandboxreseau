---
import Layout from '../layouts/Layout.astro';
import editions from '../data/editions.json';
import registry from '../data/registry.json';
import reports from '../data/reports.json';
import { fetchPodcastEpisodes } from '../lib/podcast';
import PodcastGrid from '../components/PodcastGrid.astro';
import FaqList from '../components/FaqList.astro';

const nextEdition = editions.find((edition) => edition.status === 'In Preparation') || editions[0];
const latestEpisodes = (await fetchPodcastEpisodes()).slice(0, 3);
const editionCards = [...editions].sort((a, b) => b.no - a.no).map((edition) => {
    const upcoming = edition.status === 'In Preparation';
    return {
        vol: String(edition.no).padStart(2, '0'),
        name: upcoming ? 'Up next' : edition.title,
        image: edition.image ? `/${edition.image}` : '/assets/img/RNBL3150.webp',
        caption: upcoming ? `${edition.date} · Accra. Details are being finalised. Save your seat on Luma.` : `${edition.date} · ${edition.description}`,
        href: upcoming ? edition.lumaUrl || 'https://luma.com/sandbox-reseau' : '/editions',
        external: upcoming,
    };
});
const featuredReport = reports.find((report) => report.status === 'available') ?? reports[0];
// Every other report, shown as a list beside the featured one.
const otherReports = reports.filter((report) => report !== featuredReport).slice(0, 4);
const faqs = [
    {
        question: 'What is Sandbox Réseau?',
        answer: 'A gathering in Accra for Africa’s founders, builders, and curious minds. Each edition mixes builder demos, mini-talks, and open networking. Signal over noise, progress over polish.',
        icon: 'M8 13.5a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11zM8 10.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5zM8 8h.01',
    },
    {
        question: 'Who is it for?',
        answer: 'Founders, engineers, designers, operators, and anyone curious about what’s being built across the continent. No credentials needed. Come with a question, a rough prototype, or just an open mind.',
        icon: 'M6 7.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM2.5 13a3.5 3.5 0 0 1 7 0M10.5 7.5a1.75 1.75 0 1 0 0-3.5M11.5 9.6a3.2 3.2 0 0 1 2 3',
    },
    {
        question: 'When and where is the next edition?',
        answer: `Vol. ${String(nextEdition.no).padStart(2, '0')} takes place on ${nextEdition.date} in Accra. The venue and timing are shared on the <a href="${nextEdition.lumaUrl || 'https://luma.com/sandbox-reseau'}" target="_blank" rel="noreferrer">Luma page</a>.`,
        icon: 'M3 4.5h10v8.5H3zM3 7.5h10M5.5 3v3M10.5 3v3',
    },
    {
        question: 'How do I get an invite?',
        answer: 'Request your spot on <a href="https://luma.com/sandbox-reseau" target="_blank" rel="noreferrer">Luma</a>. We keep the room small so conversations stay good, so it’s worth registering early.',
        icon: 'M2.5 5.5V4h11v1.5a1.5 1.5 0 0 0 0 3V12h-11V8.5a1.5 1.5 0 0 0 0-3zM9.5 4v8',
    },
    {
        question: 'Can I demo what I’m building?',
        answer: 'Yes. Builder demos are the heart of every edition, and early prototypes are welcome. Share what you’re working on in the <a href="https://discord.gg/RMcBDRrV7x" target="_blank" rel="noreferrer">community Discord</a> to be considered for an upcoming edition.',
        icon: 'M2.5 3h11v7.5h-11zM8 10.5V13M5.5 13h5M6.5 5.25 9.5 6.75l-3 1.5z',
    },
    {
        question: 'What is The Pitch?',
        answer: 'Our flagship pitch competition: 6–8 early-stage founders, one stage, real judges, and a live audience. It’s free to apply and free to attend. <a href="/the-pitch">Learn more</a>.',
        icon: 'M8 2.5a2 2 0 0 0-2 2V8a2 2 0 1 0 4 0V4.5a2 2 0 0 0-2-2zM4.5 7.5a3.5 3.5 0 0 0 7 0M8 11v2.5',
    },
    {
        question: 'How do I stay connected between editions?',
        answer: 'Join the <a href="https://discord.gg/RMcBDRrV7x" target="_blank" rel="noreferrer">Discord</a>. It’s where builders in Accra and the diaspora share wins, ask for help, and keep each other accountable.',
        icon: 'M2.5 3.5h11v7h-6l-3 2.5v-2.5h-2z',
    },
    {
        question: 'I missed an edition. Where can I catch up?',
        answer: 'Listen to <a href="/podcast">The Reverb</a>, browse the <a href="/gallery">gallery</a>, read the <a href="https://mcofie.substack.com/" target="_blank" rel="noreferrer">newsletter</a>, or revisit every <a href="/editions">past edition</a>.',
        icon: 'M8 13.5a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11zM8 5v3l2 1.5',
    },
];
const formatSlides = [
    { label: 'Builder demos', image: '/assets/img/gallery-v3-5.webp', alt: 'A builder showcasing a new prototype' },
    { label: 'Mini-talks', image: '/assets/img/gallery-v4-5.webp', alt: 'Founders sharing their builder journey' },
    { label: 'Open Q&A', image: '/assets/img/gallery-v3-3.webp', alt: 'An interactive Q&A session' },
    { label: 'Open networking', image: '/assets/img/gallery-v3-4.webp', alt: 'Builders networking in Accra' },
    { label: 'New connections', image: '/assets/img/RNBL3150.webp', alt: 'Attendees connecting during Sandbox Réseau' },
];
const featuredBuilders = ['Pouch', 'Chime', 'STACX', 'Speso', 'Phundit', 'Clerra', 'Sail rides', 'Syio Labs', 'BoostMate', 'Traaple', 'Gaderin', 'NewComma', "Trip o'clock"]
    .map((name) => registry.find((company) => company.name === name))
    .filter((company) => company?.logo);
---

<Layout>
    <main class="home-page">
        <section class="home-hero" data-dark-hero>
            <div class="hero-frame">
                <img class="hero-poster" src="/assets/img/hero-poster.webp" alt="" width="1280" height="720" fetchpriority="high" decoding="async" />
                <iframe id="hero-video" class="hero-video" data-src="https://www.youtube-nocookie.com/embed/qSOznAR_sLs?autoplay=1&mute=1&controls=0&loop=1&playlist=qSOznAR_sLs&playsinline=1&rel=0&modestbranding=1&cc_load_policy=0&iv_load_policy=3&disablekb=1&enablejsapi=1" title="Sandbox Réseau event highlights" allow="autoplay; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" tabindex="-1" aria-hidden="true"></iframe>
                <h1 class="sr-only">Sandbox Réseau: make room for what’s next.</h1>
            </div>
        </section>

        <section class="about-strip" aria-labelledby="about-strip-title">
            <div class="about-strip-inner">
                <h2 id="about-strip-title" class="about-statement">Where Africa’s founders and builders connect, collaborate, and shape the future. <span>Builder demos, mini-talks, and open networking. Signal over noise; progress over polish.</span></h2>
            </div>
        </section>

        <section class="format-cards" id="experience" aria-labelledby="format-cards-title">
            <div class="format-card format-card-copy cta-doodles">
                <div>
                    <h2 id="format-cards-title">Three parts.<br />One evening.</h2>
                    <p>Builders demo what they’re making. A few people a step ahead share short, honest talks. Then the floor opens up: trade ideas, make introductions, start something.</p>
                </div>
                <a class="format-cta" href={nextEdition.lumaUrl || 'https://luma.com/sandbox-reseau'} target="_blank" rel="noreferrer">Save your seat <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg></a>
            </div>
            <div class="format-card format-carousel" data-format-carousel>
                {formatSlides.map((slide, index) => (
                    <figure class:list={['format-slide', index === 0 && 'is-active']} aria-hidden={index === 0 ? 'false' : 'true'}>
                        <img src={slide.image} alt={slide.alt} loading={index === 0 ? 'eager' : 'lazy'} />
                        <figcaption><span>{String(index + 1).padStart(2, '0')}</span>{slide.label}</figcaption>
                    </figure>
                ))}
                <div class="format-dots" role="tablist" aria-label="Meetup format">
                    {formatSlides.map((slide, index) => (
                        <button type="button" role="tab" aria-label={slide.label} aria-selected={index === 0 ? 'true' : 'false'} class:list={[index === 0 && 'is-active']} data-slide={index}></button>
                    ))}
                </div>
            </div>
        </section>

        <section class="podcast-section" aria-labelledby="podcast-section-title">
            <h2 id="podcast-section-title">Fresh from The Reverb.</h2>
            <p class="podcast-intro">Short, honest conversations from the Sandbox Réseau community: what people are building, thinking, and learning right now.</p>
            <div class="podcast-grid-wrap"><PodcastGrid episodes={latestEpisodes} /></div>
            <p class="podcast-platforms">Also on<a href="https://open.spotify.com/show/1mQUSNNpjenkeUiFVBXWCN" target="_blank" rel="noreferrer">Spotify</a><a href="https://podcasts.apple.com/gh/podcast/the-reverb/id1884282478" target="_blank" rel="noreferrer">Apple Podcasts</a><a href="https://thekompound.substack.com" target="_blank" rel="noreferrer">Substack</a></p>
            <div class="podcast-more"><a class="format-cta" href="/podcast">All episodes <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg></a></div>
        </section>

        <section class="editions-rail" aria-labelledby="editions-rail-title">
            <div class="editions-rail-head">
                <div>
                    <h2 id="editions-rail-title">Every edition, a new room.</h2>
                    <p>Each gathering takes on one hard question builders face and leaves with sharper answers than it started with.</p>
                </div>
                <div class="editions-rail-nav">
                    <button type="button" aria-label="Previous editions" data-rail-prev disabled><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg></button>
                    <button type="button" aria-label="Next editions" data-rail-next><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg></button>
                </div>
            </div>
            <div class="editions-track" data-rail-track>
                {editionCards.map((card) => (
                    <figure class="edition-slide">
                        <a href={card.href} target={card.external ? '_blank' : undefined} rel={card.external ? 'noreferrer' : undefined}>
                            <div class="edition-slide-art">
                                <img src={card.image} alt="" loading="lazy" />
                                <span class="edition-pill"><span>{card.name}</span><span class="edition-pill-vol">Vol. {card.vol}</span></span>
                            </div>
                            <figcaption>{card.caption}</figcaption>
                        </a>
                    </figure>
                ))}
            </div>
        </section>

        <section class="about-strip builders-strip" aria-labelledby="builders-strip-title">
            <div class="about-strip-inner cta-doodles">
                <h2 id="builders-strip-title">The people building these companies <br />found their room at Sandbox Réseau.</h2>
                <ul class="about-logos">
                    {featuredBuilders.map((company) => (
                        <li><img src={company.logo} alt="" loading="lazy" /><span>{company.name}</span></li>
                    ))}
                </ul>
                <a class="format-cta builders-cta" href="/registry">View all builders <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg></a>
            </div>
        </section>

        <section class="resources-section" aria-labelledby="resources-title">
            <div class="resources-head">
                <div>
                    <h2 id="resources-title">Reports &amp; resources.</h2>
                    <p>Research, playbooks, and notes from the room: what we’re learning about building in Africa.</p>
                </div>
                <a class="resources-all" href="/reports">View all <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg></a>
            </div>
            <div class="resources-grid">
                <a class="resource-feature" href="/reports">
                    <div class="resource-feature-art">
                        <img src={featuredReport.bgImage} alt="" loading="lazy" />
                        <span class="resource-chip resource-chip-left">Report</span>
                        <span class="resource-chip resource-chip-right">{featuredReport.pages} pages</span>
                    </div>
                    <h3>{featuredReport.title}: {featuredReport.subtitle}</h3>
                    <p>{featuredReport.description}</p>
                    <span class="resource-read">Read the report <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg></span>
                </a>
                <div class="resource-list">
                    {otherReports.map((report) => (
                        <a class="resource-item" href="/reports">
                            <div class="resource-thumb"><img src={report.bgImage} alt="" loading="lazy" /></div>
                            <div class="resource-item-copy">
                                <div class="resource-meta"><span>{report.tags[0]}</span>{report.status === 'available' ? report.date : 'Coming soon'}</div>
                                <h3>{report.title}</h3>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <section class="faq-section" id="faq" aria-labelledby="faq-title">
            <h2 id="faq-title">Questions, answered.</h2>
            <FaqList items={faqs} idPrefix="home-faq" />
        </section>

    </main>
</Layout>

<script>
    // YouTube ignores cc_load_policy when the viewer has captions on (or for muted autoplay),
    // so unload the captions module through the player API once the video starts.
    type YTPlayer = { unloadModule(name: string): void };
    type YTNamespace = { Player: new (el: HTMLElement, opts: object) => YTPlayer };
    const w = window as typeof window & { YT?: YTNamespace; onYouTubeIframeAPIReady?: () => void };

    function hideHeroCaptions() {
        const iframe = document.getElementById('hero-video');
        if (!iframe || !w.YT?.Player) return;
        new w.YT.Player(iframe, {
            events: {
                onStateChange: (event: { target: YTPlayer; data: number }) => {
                    if (event.data !== 1) return; // 1 = playing
                    event.target.unloadModule('captions');
                    event.target.unloadModule('cc');
                },
            },
        });
    }

    // The YouTube player is heavy, so the poster paints first and the video loads once the page is idle.
    function loadHeroVideo() {
        const iframe = document.getElementById('hero-video') as HTMLIFrameElement | null;
        if (!iframe?.dataset.src || iframe.src) return;
        iframe.addEventListener('load', () => setTimeout(() => iframe.classList.add('is-ready'), 600), { once: true });
        iframe.src = iframe.dataset.src;
        initHeroVideo();
    }

    function scheduleHeroVideo() {
        if (!document.getElementById('hero-video')) return;
        const start = () => ('requestIdleCallback' in window ? requestIdleCallback(loadHeroVideo, { timeout: 2500 }) : setTimeout(loadHeroVideo, 1200));
        if (document.readyState === 'complete') start();
        else window.addEventListener('load', start, { once: true });
    }

    function initHeroVideo() {
        if (!document.getElementById('hero-video')) return;
        if (w.YT?.Player) return hideHeroCaptions();
        w.onYouTubeIframeAPIReady = hideHeroCaptions;
        if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
            const tag = document.createElement('script');
            tag.src = 'https://www.youtube.com/iframe_api';
            document.head.append(tag);
        }
    }

    let carouselTimer: number | undefined;

    function initFormatCarousel() {
        window.clearInterval(carouselTimer);
        const carousel = document.querySelector('[data-format-carousel]');
        if (!carousel) return;
        const slides = carousel.querySelectorAll<HTMLElement>('.format-slide');
        const dots = carousel.querySelectorAll<HTMLButtonElement>('.format-dots button');
        let current = 0;

        const show = (index: number) => {
            current = (index + slides.length) % slides.length;
            slides.forEach((slide, i) => {
                slide.classList.toggle('is-active', i === current);
                slide.setAttribute('aria-hidden', String(i !== current));
            });
            dots.forEach((dot, i) => {
                dot.classList.toggle('is-active', i === current);
                dot.setAttribute('aria-selected', String(i === current));
            });
        };

        const start = () => {
            window.clearInterval(carouselTimer);
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            carouselTimer = window.setInterval(() => show(current + 1), 5000);
        };

        dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); start(); }));
        start();
    }

    function initEditionsRail() {
        const track = document.querySelector<HTMLElement>('[data-rail-track]');
        const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
        const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');
        if (!track || !prev || !next) return;

        const step = () => {
            const slide = track.querySelector<HTMLElement>('.edition-slide');
            return slide ? slide.offsetWidth + 16 : track.clientWidth * 0.8;
        };
        const update = () => {
            prev.disabled = track.scrollLeft <= 2;
            next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
        };

        prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
        next.addEventListener('click', () => track.scrollBy({ left: step() }));
        track.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
    }


    scheduleHeroVideo();
    initFormatCarousel();
    initEditionsRail();
    document.addEventListener('astro:after-swap', () => { scheduleHeroVideo(); initFormatCarousel(); initEditionsRail(); });
</script>

<style>
    .home-page{--home-paper:#fff;--home-ink:#171816;--home-muted:#6c6d67;--home-accent:#d3fa69;background:var(--home-paper);color:var(--home-ink);font-family:Inter,system-ui,sans-serif}
    .home-page *{box-sizing:border-box}
    .home-hero{position:relative;z-index:1;padding:16px 16px 0}
    .hero-frame{position:relative;isolation:isolate;display:flex;flex-direction:column;container-type:size;height:84vh;min-height:560px;max-width:1920px;margin:0 auto;overflow:hidden;border-radius:28px;background:linear-gradient(180deg,#3a3b3d 0%,#6b6c6e 55%,#b9bab9 100%);color:#fff}
    .hero-poster{position:absolute;inset:0;z-index:-3;width:100%;height:100%;object-fit:cover}
    .hero-video{position:absolute;top:50%;left:50%;z-index:-2;width:max(100%,177.78cqh);height:max(100%,56.25cqw);pointer-events:none;border:0;opacity:0;transform:translate(-50%,-50%) scale(1.2);transition:opacity .8s ease}
    .hero-video.is-ready{opacity:1}
    /* A tall portrait frame crops a 16:9 video to a sliver, so narrow screens get a shape closer to the footage */
    @media(max-height:560px) and (orientation:landscape){.hero-frame{height:84svh;min-height:0}}
    @media(max-width:1023px) and (orientation:portrait){.hero-frame{height:auto;min-height:0;aspect-ratio:4/3}}
    @media(max-width:639px) and (orientation:portrait){.hero-frame{aspect-ratio:1/1;border-radius:24px}.hero-video{transform:translate(-50%,-50%) scale(1.1)}}
    /* Sizes mirror nor.ma: 1040px container, 28px radii, sm = 640px, lg = 1024px */
    .about-strip{position:relative;z-index:0;margin:-32px 0 64px;padding:0 16px}
    .about-strip-inner{max-width:1920px;margin:0 auto;padding:96px 24px 64px;background:#f5f5f5;border-radius:0 0 28px 28px;text-align:center}
    .about-strip h2{max-width:34ch;margin:0 auto;font-size:28px;font-weight:600;line-height:1.2;letter-spacing:-.01em;text-wrap:balance;color:#0a0a0a}
    .about-strip .about-statement{max-width:36ch;font-size:clamp(26px,1.2rem + 1.4vw,36px);line-height:1.18;letter-spacing:-.015em}
    .about-strip:not(.builders-strip) .about-strip-inner{padding:120px 24px 88px}
    .about-statement span{color:#6b6b6b}
    .builders-strip{margin:64px 0}.builders-strip .about-strip-inner{padding-top:64px;border-radius:28px}
    .about-logos{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:28px 40px;max-width:calc(1040px - 4rem);margin:56px auto 0;padding:0;list-style:none}
    .about-logos li{display:flex;align-items:center;gap:8px;color:#404040;font-size:17px;font-weight:600;letter-spacing:-.02em;opacity:.8;transition:opacity .5s cubic-bezier(.22,1,.36,1)}
    .about-logos li:hover{opacity:1}
    .about-strip .builders-cta{display:inline-flex;margin-top:56px;padding:0 28px}
    .about-logos img{width:26px;height:26px;object-fit:contain;border-radius:7px;filter:grayscale(1) contrast(1.1);mix-blend-mode:multiply}
    .format-cards{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;gap:16px;width:100%;max-width:1040px;margin:0 auto;padding:64px 32px}
    .format-card{position:relative;min-height:600px;border-radius:28px;overflow:hidden}
    .format-card-copy{display:flex;flex-direction:column;justify-content:space-between;padding:56px;background:#f5f5f5}
    .format-card-copy h2{max-width:16ch;margin:0;font-size:clamp(1.5rem,1.15rem + 1.5vw,2.25rem);font-weight:600;line-height:1.1;letter-spacing:-.015em;text-wrap:balance;color:#0a0a0a}
    .format-card-copy p{max-width:38ch;margin:20px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .format-cta{display:flex;align-items:center;justify-content:center;gap:10px;height:48px;margin-top:40px;border-radius:999px;background:#0a0a0a;color:#fff;font-size:16px;font-weight:600;text-decoration:none;transition:background-color .2s cubic-bezier(.22,1,.36,1),transform .2s cubic-bezier(.22,1,.36,1)}
    .format-cta:hover{background:rgba(10,10,10,.9)}.format-cta:active{transform:scale(.99)}
    .format-carousel{background:#111}
    .format-slide{position:absolute;inset:0;margin:0;opacity:0;transition:opacity .7s cubic-bezier(.22,1,.36,1)}
    .format-slide.is-active{opacity:1}
    .format-slide img{width:100%;height:100%;object-fit:cover;object-position:center}
    .format-slide figcaption{position:absolute;top:20px;left:20px;display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;background:rgba(0,0,0,.2);color:#fff;font-size:13px;font-weight:500;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
