---
import Layout from '../layouts/Layout.astro';

const discordInvite = 'https://discord.gg/RMcBDRrV7x';

const audience = [
    'Founders and engineers building products in Ghana and West Africa',
    'Designers, data people, indie makers, and the product-curious',
    'Diaspora builders who want to stay connected to Accra’s ecosystem',
    'Anyone with a builder’s mindset. Beginner-friendly, curiosity is enough',
];

const channels = [
    { name: 'show-your-work', desc: 'Share what you’re building. Screenshots, links, updates.' },
    { name: 'feedback-wanted', desc: 'Post your product, get honest feedback from builders.' },
    { name: 'testing-pool', desc: 'Need testers? The community is your first 50 users.' },
    { name: 'funding-talk', desc: 'Raising capital? Looking for investors? Discuss here.' },
    { name: 'wins', desc: 'Celebrate the build. First user, revenue, or hire.' },
];

const pillars = [
    { title: 'The meetups', desc: 'In-person editions in Accra. Builder demos, mini-talks, and open networking.', href: '/editions', cta: 'See past editions' },
    { title: 'The Reverb', desc: 'Our podcast featuring builders from the community. Short episodes. No fluff.', href: '/podcast', cta: 'Listen now' },
    { title: 'The Pitch', desc: 'Our pitch competition. 6–8 founders. One stage. Real judges.', href: '/the-pitch', cta: 'Learn more' },
];

const values = [
    'Build in public.',
    'Be useful. Bring signal, not noise.',
    'Be honest, not harsh.',
    'What’s shared here stays here.',
    'One strike policy.',
];

const roles = [
    { label: 'Founder', color: '#EAB308' },
    { label: 'Core Team', color: '#d4d4d4' },
    { label: 'Moderator', color: '#22C55E' },
    { label: 'Reverb Alumni', color: '#A855F7' },
    { label: 'Edition Attendee', color: '#3B82F6' },
    { label: 'Investor', color: '#14B8A6' },
    { label: 'Builder', color: '#6B7280' },
];
---

<Layout
    title="Community | Sandbox Réseau"
    description="Join the Sandbox Réseau Discord. Connect with builders, founders, and engineers in Accra and the diaspora. High-signal, no fluff."
    image="/assets/img/community-hero.jpg"
    imageAlt="Members of the Sandbox Réseau community in Accra"
>
    <main class="community-page">
        <section class="community-hero" data-dark-hero aria-labelledby="community-title">
            <div class="community-hero-frame">
                <img src="/assets/img/community-hero.webp" alt="" fetchpriority="high" decoding="async" />
                <div class="community-hero-copy">
                    <span class="community-hero-pill"><span aria-hidden="true"></span>High-signal, no fluff</span>
                    <h1 id="community-title">The room is open.</h1>
                    <p>Sandbox Réseau is where Accra’s builders connect, build in public, and hold each other accountable. Our community lives on Discord.</p>
                    <div class="community-hero-actions">
                        <a class="community-white" href={discordInvite} target="_blank" rel="noreferrer">Join the Discord</a>
                        <a class="community-glass" href="#inside">See what’s inside</a>
                    </div>
                </div>
            </div>
        </section>

        <div class="community-wrap">
            <section class="community-split" aria-labelledby="community-who">
                <div class="community-card community-card-grey">
                    <h2 id="community-who">Built for builders, wherever you are.</h2>
                    <ul class="community-audience">
                        {audience.map((item) => (
                            <li>
                                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" /></svg>
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
                <div class="community-card community-card-dark">
                    <h2>The code.</h2>
                    <p class="community-card-lede">How we operate and interact, online and in the room.</p>
                    <ol class="community-values">
                        {values.map((value, index) => (
                            <li><span>{String(index + 1).padStart(2, '0')}</span>{value}</li>
                        ))}
                    </ol>
                </div>
            </section>

            <section class="community-section" id="inside" aria-labelledby="community-inside">
                <h2 id="community-inside">Inside the server.</h2>
                <p class="community-lede">Our channels are set up for work and feedback.</p>
                <div class="community-channels">
                    {channels.map((channel) => (
                        <article>
                            <h3><span aria-hidden="true">#</span>{channel.name}</h3>
                            <p>{channel.desc}</p>
                        </article>
                    ))}
                    <a class="community-channels-cta" href={discordInvite} target="_blank" rel="noreferrer">
                        <span>Join the conversation</span>
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
                    </a>
                </div>
            </section>

            <section class="community-section" aria-labelledby="community-pillars">
                <h2 id="community-pillars">More than a server.</h2>
                <p class="community-lede">How the community shows up offline and on air.</p>
                <div class="community-pillars">
                    {pillars.map((pillar, index) => (
                        <a href={pillar.href}>
                            <span class="community-number">{String(index + 1).padStart(2, '0')}</span>
                            <h3>{pillar.title}</h3>
                            <p>{pillar.desc}</p>
                            <span class="community-link">{pillar.cta} →</span>
                        </a>
                    ))}
                </div>
            </section>

            <section class="community-section" aria-labelledby="community-roles">
                <div class="community-roles">
                    <div>
                        <h2 id="community-roles">Server roles.</h2>
                        <p class="community-lede">Everyone joins as a Builder. Roles are earned through showing up, shipping, and contributing.</p>
                    </div>
                    <ul>
                        {roles.map((role) => (
                            <li><span style={`background:${role.color}`} aria-hidden="true"></span>{role.label}</li>
                        ))}
                    </ul>
                </div>
            </section>

            <section class="community-cta cta-doodles" aria-labelledby="community-cta-title">
                <h2 id="community-cta-title">Enter the room.</h2>
                <p>Start building in public and connect with the ecosystem today.</p>
                <a class="community-black" href={discordInvite} target="_blank" rel="noreferrer">
                    Join the Discord
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
                </a>
            </section>
        </div>
    </main>
</Layout>

<style>
    .community-page{font-family:Inter,system-ui,sans-serif;color:#0a0a0a}
    .community-hero{padding:16px 16px 0}
    .community-hero-frame{position:relative;isolation:isolate;display:flex;align-items:flex-end;min-height:min(78vh,720px);max-width:1920px;margin:0 auto;overflow:hidden;border-radius:28px;background:#111;color:#fff}
    .community-hero-frame>img{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover}
    .community-hero-frame::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,.45) 0%,rgba(0,0,0,.2) 40%,rgba(0,0,0,.75) 100%)}
    .community-hero-copy{width:100%;max-width:1040px;margin:0 auto;padding:160px 32px 56px}
    .community-hero-pill{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,.15);color:rgba(255,255,255,.85);font-size:13px;font-weight:500;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
    .community-hero-pill span{width:7px;height:7px;border-radius:50%;background:#d3fa69}
    .community-hero h1{margin:24px 0 0;font-size:clamp(3rem,1.8rem + 5vw,6rem);font-weight:600;line-height:.98;letter-spacing:-.04em}
    .community-hero-copy>p{max-width:48ch;margin:20px 0 0;color:rgba(255,255,255,.8);font-size:17px;font-weight:500;line-height:1.5}
    .community-hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
    .community-white,.community-glass{display:inline-flex;align-items:center;height:44px;padding:0 20px;border-radius:999px;font-size:15px;font-weight:600;text-decoration:none;transition:background-color .2s}
    .community-white{background:#fff;color:#0a0a0a}
    .community-white:hover{background:#d3fa69}
    .community-glass{border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.1);color:#fff;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
    .community-glass:hover{background:rgba(255,255,255,.2)}
    .community-wrap{max-width:1040px;margin:0 auto;padding:0 32px 64px}
    .community-wrap h2{margin:0;font-size:clamp(1.5rem,1.15rem + 1.5vw,2.25rem);font-weight:600;line-height:1.1;letter-spacing:-.015em;text-wrap:balance}
    .community-lede{max-width:48ch;margin:16px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .community-split{display:grid;grid-template-columns:1fr 1fr;gap:16px;padding-top:96px}
    .community-card{padding:56px;border-radius:28px}
    .community-card-grey{background:#f5f5f5}
    .community-card-dark{background:#111;color:#fff}
    .community-card-lede{margin:16px 0 0;color:rgba(255,255,255,.65);font-size:16px;line-height:1.5}
    .community-audience{display:grid;gap:16px;margin:32px 0 0;padding:0;list-style:none}
    .community-audience li{display:flex;gap:12px;color:#6b6b6b;font-size:16px;line-height:1.5}
    .community-audience svg{flex-shrink:0;margin-top:4px;color:#0a0a0a}
    .community-values{display:grid;gap:4px;margin:28px 0 0;padding:0;list-style:none}
    .community-values li{display:flex;align-items:baseline;gap:16px;padding:12px 0;border-top:1px solid rgba(255,255,255,.12);font-size:18px;font-weight:500}
    .community-values li:first-child{border-top:0}
    .community-values span{color:#d3fa69;font-size:13px;font-variant-numeric:tabular-nums}
    .community-section{padding-top:112px}
    .community-channels{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:48px}
    .community-channels article,.community-channels-cta{padding:28px;border:1px solid rgba(10,10,10,.1);border-radius:28px}
    .community-channels h3{margin:0;font-size:18px;font-weight:600}
    .community-channels h3 span{margin-right:4px;color:#a1a1a1}
    .community-channels p{margin:10px 0 0;color:#6b6b6b;font-size:15px;line-height:1.5}
    .community-channels-cta{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-color:#0a0a0a;background:#0a0a0a;color:#fff;font-size:18px;font-weight:600;text-decoration:none;transition:background-color .2s}
    .community-channels-cta:hover{background:#2a2a2a}
    .community-pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:48px}
    .community-pillars a{display:flex;flex-direction:column;padding:28px;border:1px solid rgba(10,10,10,.1);border-radius:28px;color:inherit;text-decoration:none;transition:border-color .3s,background-color .3s}
    .community-pillars a:hover{border-color:rgba(10,10,10,.25);background:#fafafa}
    .community-number{display:inline-flex;align-items:center;justify-content:center;align-self:flex-start;height:28px;padding:0 8px;border:1px solid rgba(10,10,10,.1);border-radius:999px;color:#6b6b6b;font-size:13px;font-weight:600;font-variant-numeric:tabular-nums}
    .community-pillars h3{margin:20px 0 0;font-size:19px;font-weight:600}
    .community-pillars p{flex:1;margin:8px 0 0;color:#6b6b6b;font-size:15px;line-height:1.5}
    .community-link{margin-top:20px;font-size:14px;font-weight:600}
    .community-roles{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:48px;padding:56px;border-radius:28px;background:#f5f5f5}
    .community-roles ul{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}
    .community-roles li{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:#fff;font-size:14px;font-weight:500}
    .community-roles li span{width:9px;height:9px;border-radius:50%}
    .community-cta{display:flex;flex-direction:column;align-items:center;margin-top:112px;padding:72px 32px;border:1px solid rgba(10,10,10,.1);border-radius:28px;text-align:center}
    .community-cta p{max-width:44ch;margin:16px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .community-black{display:inline-flex;align-items:center;gap:10px;height:48px;margin-top:32px;padding:0 28px;border-radius:999px;background:#0a0a0a;color:#fff;font-size:16px;font-weight:600;text-decoration:none;transition:background-color .2s}
    .community-black:hover{background:rgba(10,10,10,.9)}
    @media(max-width:1023px){.community-split,.community-roles{grid-template-columns:1fr}.community-channels,.community-pillars{grid-template-columns:repeat(2,1fr)}.community-roles{gap:28px}}
    @media(max-width:639px){.community-hero{padding:12px 12px 0}.community-hero-frame{min-height:84svh}.community-hero-copy{padding:140px 24px 40px}.community-wrap{padding:0 24px 48px}.community-split{padding-top:64px}.community-card,.community-roles{padding:32px 24px}.community-section{padding-top:80px}.community-channels,.community-pillars{grid-template-columns:1fr}.community-cta{margin-top:80px;padding:56px 24px}}
</style>
