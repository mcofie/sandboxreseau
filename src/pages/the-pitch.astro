---
import Layout from '../layouts/Layout.astro';

const headerSubtitle = "The Competition";

const timeline = [
    { date: "Jun 2026", label: "Applications Open", desc: "Submit your startup for consideration. Open to all builders in the ecosystem." },
    { date: "Jul 2026", label: "Shortlist Announced", desc: "6–8 founders are selected to pitch based on traction, team, and market potential." },
    { date: "Aug 2026", label: "Pitch Prep", desc: "Selected founders get mentorship, rehearsals, and feedback from past founders." },
    { date: "Sep 2026", label: "The Pitch — Live", desc: "One stage. Real judges. A live audience. The founders pitch for real." },
];

const criteria = [
    { title: "Traction", desc: "Show us what you've built and who's using it. Users, revenue, or validated demand." },
    { title: "Team", desc: "Who's building this? We back founders who can ship and iterate." },
    { title: "Market", desc: "Is this a real problem? How big is the opportunity?" },
    { title: "Clarity", desc: "Can you explain what you do in 60 seconds? Signal, not fluff." },
];
---

<Layout 
    title="The Pitch | Sandbox Réseau" 
    description="The Pitch is Sandbox Réseau's pitch competition. 6–8 founders. One stage. Real judges. Coming September 2026."
    headerSubtitle={headerSubtitle}
>
    <!-- Hero Section -->
    <section class="border-b border-[var(--rule)]">
        <div class="mx-auto max-w-[1100px] px-4 py-20 md:py-32 text-center">
            <span
                class="inline-block w-max border-y border-[var(--rule)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-[.2em] text-[var(--muted)] mb-6 animate-enter">
                September 2026 · Accra
            </span>
            <h1 class="font-serif text-5xl sm:text-7xl md:text-8xl leading-[.85] tracking-tighter mb-8 animate-enter">
                The Pitch.
            </h1>
            <p class="mx-auto max-w-2xl text-[var(--muted)] text-base md:text-xl leading-relaxed font-serif animate-enter">
                6–8 founders. One stage. Real judges. A live audience of builders, investors, and operators. No fluff — just what you're building and why it matters.
            </p>
            <div class="mt-10 flex flex-wrap items-center justify-center gap-4 animate-enter">
                <span class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-6 py-3.5 text-sm font-bold uppercase tracking-widest text-[var(--muted)] cursor-default bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)]">
                    <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                    Applications Open June 2026
                </span>
                <a href="#format"
                    class="inline-flex items-center gap-2 rounded border border-[var(--rule)] px-6 py-3.5 text-sm font-bold uppercase tracking-widest hover:bg-[var(--ink)] hover:text-[var(--paper)] transition-all">
                    See the format <span class="text-lg leading-none">↓</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Main: article stream -->
    <main class="mx-auto max-w-[1100px] px-4 py-16 md:py-24">
        <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1fr_320px]">
            <!-- Main Column -->
            <div class="space-y-16">
                <!-- What Is The Pitch -->
                <article class="prose-like animate-enter" id="format">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight tracking-[-.005em]">What is The Pitch?</h3>
                    <p class="text-neutral-600 mb-6">A stage that matches your ambition.</p>
                    <p>The Pitch is Sandbox Réseau's flagship pitch competition — a live event where early-stage founders present their startups to a panel of judges and a room full of builders, operators, and investors.</p>
                    <p>It's not a demo day. It's not a panel. It's a stage. You have 5 minutes to make your case, followed by 3 minutes of real questions from people who've been in the trenches.</p>
                    
                    <div class="mt-8 grid grid-cols-2 gap-4">
                        <div class="p-5 rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)]">
                            <div class="font-serif text-3xl tracking-tight mb-1 text-[var(--ink)]">6–8</div>
                            <div class="text-[10px] font-bold uppercase tracking-widest text-[var(--muted)]">Founders</div>
                        </div>
                        <div class="p-5 rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)]">
                            <div class="font-serif text-3xl tracking-tight mb-1 text-[var(--ink)]">5 min</div>
                            <div class="text-[10px] font-bold uppercase tracking-widest text-[var(--muted)]">Per Pitch</div>
                        </div>
                        <div class="p-5 rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)]">
                            <div class="font-serif text-3xl tracking-tight mb-1 text-[var(--ink)]">3 min</div>
                            <div class="text-[10px] font-bold uppercase tracking-widest text-[var(--muted)]">Q&A</div>
                        </div>
                        <div class="p-5 rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)]">
                            <div class="font-serif text-3xl tracking-tight mb-1 text-[var(--ink)]">1</div>
                            <div class="text-[10px] font-bold uppercase tracking-widest text-[var(--muted)]">Stage</div>
                        </div>
                    </div>
                </article>

                <!-- Selection Criteria -->
                <article class="prose-like animate-enter">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">What We Look For.</h3>
                    <p class="text-neutral-600 mb-6">Our evaluation criteria for the shortlist.</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                        {criteria.map((c, i) => (
                            <div class="rounded border border-[var(--rule)] p-5 bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)] transition-all hover:-translate-y-1 hover:shadow-xl">
                                <div class="flex items-start gap-3">
                                    <span class="text-[11px] font-bold text-[var(--muted)] mt-1 tabular-nums">0{i + 1}</span>
                                    <div>
                                        <strong class="block text-lg font-serif mb-2 text-[var(--ink)]">{c.title}</strong>
                                        <p class="text-[14px] text-neutral-600 leading-relaxed m-0">{c.desc}</p>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </article>

                <!-- FAQ -->
                <article class="prose-like animate-enter" id="faq">
                    <h3 class="mb-1 font-serif text-[28px] leading-tight">FAQ.</h3>
                    <p class="text-neutral-600 mb-4">Answers to common questions about The Pitch.</p>
                    <ul class="ml-5 list-disc font-sans space-y-2">
                        <li><strong>Who can apply?</strong> Any early-stage founder building a product — based in Ghana, West Africa, or the diaspora.</li>
                        <li><strong>What stage?</strong> Pre-seed to seed. You should have a working product or strong prototype with some validation.</li>
                        <li><strong>Pitch deck required?</strong> Not for the application. If selected, you'll pitch live on stage — slides optional.</li>
                        <li><strong>What do winners get?</strong> Details on prizes, mentorship, and exposure announced in June.</li>
                        <li><strong>Is there a fee?</strong> No. The Pitch is free to apply and free to attend.</li>
                    </ul>
                </article>
            </div>

            <!-- Right Rail (Timeline & CTA) -->
            <div class="space-y-8 lg:sticky lg:top-24 lg:self-start">
                <!-- Timeline Widget -->
                <div class="rounded border border-[var(--rule)] bg-[color:color-mix(in_oklab,var(--paper)_95%,var(--ink)_5%)] p-6 animate-enter">
                    <h3 class="font-serif text-xl mb-6 pb-4 border-b border-[var(--rule)]">The Timeline</h3>
                    <div class="space-y-6 relative before:absolute before:inset-0 before:ml-2.5 before:-translate-x-px before:h-full before:w-0.5 before:bg-gradient-to-b before:from-[var(--rule)] before:via-[var(--rule)] before:to-transparent">
                        {timeline.map((step, i) => (
                            <div class="relative flex items-start gap-4">
                                <div class="absolute left-0 mt-1.5 w-5 h-5 rounded-full border-[2px] border-[var(--paper)] bg-[var(--ink)] shadow flex items-center justify-center z-10">
                                    <div class="w-1.5 h-1.5 rounded-full bg-[var(--paper)]"></div>
                                </div>
                                <div class="pl-8">
                                    <div class="text-[10px] font-bold uppercase tracking-widest text-[var(--accent)] mb-1">{step.date}</div>
                                    <div class="font-serif text-[15px] text-[var(--ink)] mb-1">{step.label}</div>
                                    <p class="text-[13px] text-[var(--muted)] leading-relaxed m-0">{step.desc}</p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Right Rail CTA -->
                <div class="rounded border border-[var(--rule)] hatch p-6 relative overflow-hidden group animate-enter bg-[color:color-mix(in_oklab,var(--paper)_90%,var(--ink)_10%)] text-center">
                    <div class="relative z-10">
                        <div class="w-12 h-12 mx-auto rounded-full bg-[#5865F2] flex items-center justify-center text-white mb-4 shadow-lg group-hover:scale-110 transition-transform">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 127.14 96.36" fill="currentColor" class="w-6 h-6">
                                <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.11,77.11,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22c2.36-24.44-2.85-48.47-18.9-72.15ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
                            </svg>
                        </div>
                        <h4 class="font-serif text-xl mb-2 text-[var(--ink)]">Join the Community</h4>
                        <p class="text-[13px] text-neutral-600 mb-5 leading-relaxed">
                            Start building in public and connect with the ecosystem today.
                        </p>
                        <a href="https://discord.gg/RMcBDRrV7x" target="_blank" rel="noreferrer"
                            class="block w-full rounded bg-[var(--ink)] py-3 text-xs font-bold uppercase tracking-widest text-[var(--paper)] hover:opacity-90 transition-opacity">
                            Join Discord
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>

<script is:inline>
    (function() {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, i) => {
                if (entry.isIntersecting) {
                    setTimeout(() => {
                        entry.target.classList.add('visible');
                    }, (i % 6) * 80);
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.animate-enter').forEach(el => observer.observe(el));

        // Smooth scroll for format link
        const formatLink = document.querySelector('a[href="#format"]');
        if (formatLink) {
            formatLink.addEventListener('click', function(e) {
                e.preventDefault();
                document.getElementById('format')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        }
    })();
</script>
