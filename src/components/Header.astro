---
import ThemeControls from './ThemeControls.astro';
import ThemeSwatches from './ThemeSwatches.astro';

interface Props {
	title?: string;
	subtitle?: string;
}

import editions from '../data/editions.json';

const { title = "Sandbox Réseau Gazette", subtitle = "For Builders, Thinkers & Makers" } = Astro.props;
const currentPath = Astro.url.pathname;

const latestEdition = editions[0]; // Assuming newest is first in JSON
const volNo = `VOL · NO ${latestEdition.no}`;

const categories = [
    { name: 'Gazette', href: '/', description: 'Latest dispatches and community news', active: currentPath === '/' },
    { name: 'Podcast', href: '/podcast', description: 'The high-bandwidth audio log', active: currentPath === '/podcast' },
    { name: 'Gallery', href: '/gallery', description: 'Visual archive of past editions', active: currentPath === '/gallery' },
    { name: 'Editions', href: '/editions', description: 'Explore our event history', active: currentPath === '/editions' },
    { name: 'Newsletters', href: '/newsletters', description: 'Curated signals for builders', active: currentPath === '/newsletters' },
    { name: 'Community', href: '/community', description: 'Join the builders on Discord', active: currentPath === '/community' },
    { name: 'Registry', href: '/registry', description: 'Directory of projects and makers', active: currentPath === '/registry' },
    { name: 'The Pitch', href: '/the-pitch', description: 'Our flagship pitch competition', active: currentPath === '/the-pitch' },
    { name: 'Reports', href: '/reports', description: 'Ecosystem research and publications', active: currentPath === '/reports' },
];
---

<header class="border-b-[3px] border-[var(--rule)] border-double bg-[var(--paper)]">
    <div class="mx-auto max-w-[1100px] px-4">
        <!-- Row 1: Utility -->
        <div class="flex flex-wrap items-center justify-between gap-3 py-2 text-[13px]">
            <div class="text-[var(--muted)]">
                <span id="dateline">Monday, March 23, 2026</span> • {volNo} • Accra
            </div>

            <div class="flex items-center gap-2">
                {Astro.url.pathname !== '/' && (
                    <a href="/"
                        class="inline-flex items-center gap-2 mr-4 rounded bg-[var(--ink)] px-3 py-1.5 text-xs font-bold text-[var(--paper)] uppercase tracking-wide hover:opacity-80 transition-opacity">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5"
                            stroke="currentColor" class="h-3.5 w-3.5">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                        </svg>
                        Back to Gazette
                    </a>
                )}
                <ThemeControls />
            </div>
        </div>

        <!-- Row 2: Centered Masthead -->
        <div class="py-3">
            <h1 class="text-center font-serif text-[44px] leading-none tracking-tight sm:text-[56px]">
                {title}
            </h1>
            <div class="mx-auto mt-3 h-px w-24 bg-[var(--rule)]"></div>
            <p class="mt-2 text-center font-serif text-sm text-[var(--muted)]">
                {subtitle}
            </p>
        </div>

        <!-- Row 3: Swatches -->
        <ThemeSwatches />
    </div>
</header>

<!-- Sticky Menu Toggle Bar -->
<div class="sticky top-0 z-50 border-y border-[var(--rule)] bg-[var(--paper)] py-2 transition-shadow duration-300" id="sticky-menu-bar">
    <div class="mx-auto flex max-w-[1100px] items-center justify-between px-4">
        <button id="menu-open-btn" class="flex items-center gap-2 px-3 py-1 text-[11px] font-black uppercase tracking-[0.2em] hover:accent-text transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
            Menu
        </button>
        
        <div class="flex items-center gap-4">
             <span class="hidden sm:inline font-serif text-[12px] text-[var(--muted)]" id="global-status-label">Gazette Dispatch</span>
             <a href="https://luma.com/sandbox-reseau" target="_blank" class="rounded bg-[var(--ink)] px-4 py-1.5 text-[10px] font-bold uppercase tracking-widest text-[var(--paper)] hover:bg-[var(--accent)] transition-colors">
                Register
             </a>
        </div>
    </div>
    <div class="absolute bottom-0 left-0 h-[2px] w-full bg-[var(--rule)]/5">
        <div id="global-scroll-progress" class="h-full bg-[var(--accent)] transition-all duration-150" style="width: 0%"></div>
    </div>
</div>

<div class="h-1 border-b border-[var(--rule)] banner"></div>

<!-- Full Screen Overlay Menu -->
<div id="full-screen-menu" class="fixed inset-0 z-[100] translate-y-full bg-[var(--paper)] transition-transform duration-700 ease-[cubic-bezier(0.85,0,0.15,1)]">
    <div class="grain-overlay opacity-10"></div>
    
    <!-- Menu Header -->
    <div class="flex items-center justify-between border-b border-[var(--rule)] px-6 py-6 md:px-12">
        <div class="font-serif text-xl font-bold tracking-tight">Sandbox Réseau</div>
        <button id="menu-close-btn" class="group flex h-12 w-12 items-center justify-center rounded-full border border-[var(--rule)]/20 transition-all hover:bg-[var(--ink)] hover:text-[var(--paper)]">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:rotate-90"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
    </div>

    <!-- Menu Content -->
    <div class="h-full overflow-y-auto px-6 py-12 md:px-12">
        <div class="mx-auto max-w-[1200px]">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-8 md:gap-y-12">
                {categories.map((cat, i) => (
                    <div class="overflow-hidden group">
                        <a 
                            href={cat.href}
                            target={cat.external ? "_blank" : "_self"}
                            class="menu-link block opacity-0 translate-y-12 transition-all duration-500 ease-out"
                            style={`transition-delay: ${i * 50}ms`}
                        >
                            <div class="flex items-start gap-4">
                                <span class="font-sans text-[10px] font-bold text-[var(--muted)] mt-2">0{i + 1}</span>
                                <div class="flex-1">
                                    <div class="flex items-center gap-3">
                                        <h2 class="font-serif text-4xl sm:text-5xl md:text-6xl tracking-tighter group-hover:accent-text transition-colors leading-none">
                                            {cat.name}
                                        </h2>
                                        {cat.external && <span class="font-sans text-[10px] font-black uppercase tracking-[0.2em] text-[var(--muted)] opacity-50 px-2 py-0.5 border border-[var(--rule)] rounded">EXT</span>}
                                    </div>
                                    <p class="mt-2 font-serif text-sm md:text-base text-[var(--muted)] max-w-xs">
                                        {cat.description}
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                ))}
            </div>

            <!-- Menu Footer -->
            <div id="menu-footer" class="mt-24 border-t border-[var(--rule)] pt-12 grid grid-cols-1 sm:grid-cols-2 gap-8 pb-24">
                <div class="opacity-0 translate-y-8 transition-all duration-500 delay-500">
                    <h4 class="text-[10px] uppercase font-bold tracking-widest text-[var(--muted)] mb-4">Location</h4>
                    <p class="font-serif text-lg">Accra, Ghana</p>
                </div>
                <div class="opacity-0 translate-y-8 transition-all duration-500 delay-600">
                    <h4 class="text-[10px] uppercase font-bold tracking-widest text-[var(--muted)] mb-4">Social</h4>
                    <div class="flex flex-col gap-2">
                        <a href="https://www.linkedin.com/company/sandbox-reseau/" target="_blank" class="font-serif text-lg hover:accent-text transition-colors">LinkedIn</a>
                        <a href="https://www.youtube.com/@SandboxReseau" target="_blank" class="font-serif text-lg hover:accent-text transition-colors">YouTube</a>
                        <a href="https://www.instagram.com/sandboxreseau?igsh=MTg5ZWt5a3lyZ21iMg%3D%3D&utm_source=qr" target="_blank" class="font-serif text-lg hover:accent-text transition-colors">Instagram</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function initMenu() {
        const openBtn = document.getElementById('menu-open-btn');
        const closeBtn = document.getElementById('menu-close-btn');
        const menu = document.getElementById('full-screen-menu');
        const stickyBar = document.getElementById('sticky-menu-bar');
        const progress = document.getElementById('global-scroll-progress');
        const label = document.getElementById('global-status-label');
        const menuLinks = document.querySelectorAll('.menu-link');
        const menuFooter = document.getElementById('menu-footer');

        if (!openBtn || !closeBtn || !menu) return;

        function toggleMenu(isOpen: boolean) {
            if (isOpen) {
                menu.classList.remove('translate-y-full');
                document.body.style.overflow = 'hidden';
                // Animate links
                menuLinks.forEach((link, i) => {
                    setTimeout(() => {
                        link.classList.remove('opacity-0', 'translate-y-12');
                    }, 300 + (i * 60));
                });
                // Animate footer
                const footerChildren = menuFooter?.children;
                if (footerChildren) {
                    Array.from(footerChildren).forEach((child, i) => {
                        setTimeout(() => {
                            child.classList.remove('opacity-0', 'translate-y-8');
                        }, 800 + (i * 100));
                    });
                }
            } else {
                menu.classList.add('translate-y-full');
                document.body.style.overflow = '';
                // Reset state for next time
                menuLinks.forEach(link => {
                    link.classList.add('opacity-0', 'translate-y-12');
                });
                const footerChildren = menuFooter?.children;
                if (footerChildren) {
                    Array.from(footerChildren).forEach((child) => {
                        child.classList.add('opacity-0', 'translate-y-8');
                    });
                }
            }
        }

        openBtn.addEventListener('click', () => toggleMenu(true));
        closeBtn.addEventListener('click', () => toggleMenu(false));
        
        // Close on link click (if internal)
        menuLinks.forEach(link => {
            link.addEventListener('click', () => {
                const target = (link as HTMLAnchorElement).getAttribute('target');
                if (target !== '_blank') toggleMenu(false);
            });
        });

        // Sticky & Progress Logic
        const handleScroll = () => {
            if (window.scrollY > 150) {
                stickyBar?.classList.add('shadow-xl');
            } else {
                stickyBar?.classList.remove('shadow-xl');
            }

            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            if (height > 0) {
                const scrolledPercent = (winScroll / height) * 100;
                if (progress) progress.style.width = scrolledPercent + "%";
            }

            if (window.location.pathname === '/' && label) {
                const articles = document.querySelectorAll('article[id]');
                let cur = "Dispatch";
                articles.forEach(art => {
                    if (window.scrollY >= (art as HTMLElement).offsetTop - 120) {
                        cur = art.getAttribute('id') || "Dispatch";
                    }
                });
                label.textContent = "Journal: " + cur.charAt(0).toUpperCase() + cur.slice(1);
            }
        };

        window.addEventListener('scroll', handleScroll, { passive: true });
        handleScroll(); // Initial check
    }

    initMenu();
    document.addEventListener('astro:after-swap', initMenu);
</script>
