---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import { statSync } from 'node:fs';
import editions from '../data/editions.json';

// Every file here is generated by `npm run brand:kit` (scripts/build-brand-kit.mjs) into public/brand/.
const KIT = '/brand/kit';
const KIT_ZIP = '/brand/sandbox-reseau-brand-kit.zip';
const kitSize = `${(statSync(`public${KIT_ZIP}`).size / 1024 / 1024).toFixed(1)} MB`;
const LINKEDIN = 'https://www.linkedin.com/company/sandbox-reseau/';
const DISCORD = 'https://discord.gg/RMcBDRrV7x';

const pastEditions = editions.filter((edition) => edition.status === 'Past').length;

const logos = [
    { label: 'Wordmark · black', tone: 'light', file: 'logo/sandbox-reseau-wordmark-black', kind: 'wordmark' },
    { label: 'Wordmark · white', tone: 'dark', file: 'logo/sandbox-reseau-wordmark-white', kind: 'wordmark' },
    { label: 'Monogram · dark', tone: 'light', file: 'monogram/sandbox-reseau-monogram-dark', kind: 'monogram' },
    { label: 'Monogram · light', tone: 'dark', file: 'monogram/sandbox-reseau-monogram-light', kind: 'monogram' },
];

const colours = [
    { name: 'Ink', hex: '#0A0A0A', use: 'Text, logo, primary buttons', dark: true },
    { name: 'Paper', hex: '#FFFFFF', use: 'Backgrounds' },
    { name: 'Mist', hex: '#F5F5F5', use: 'Cards and panels' },
    { name: 'Signal', hex: '#D3FA69', use: 'Accent and highlights' },
    { name: 'Grass', hex: '#8FBF24', use: 'Live and status dots', dark: true },
    { name: 'Slate', hex: '#6B6B6B', use: 'Secondary text', dark: true },
];

// The first two are landscape group shots; the rest are portraits (see scripts/build-brand-kit.mjs).
const photos = [1, 2, 3, 4, 5, 6].map((n) => `${KIT}/photos/sandbox-reseau-photo-${n}.jpg`);

const boilerplate = [
    {
        label: 'One line',
        text: 'Sandbox Réseau is a gathering in Accra where Africa’s founders, builders, and curious minds connect, collaborate, and shape the future.',
    },
    {
        label: 'Short',
        text: 'Sandbox Réseau is a community of founders and builders in Accra, Ghana. Each edition brings people together for builder demos, short and honest talks from people a step ahead, and open networking. Between gatherings, the community runs The Reverb podcast, publishes reports on Africa’s startup ecosystem, and stays connected on Discord.',
    },
    {
        label: 'Long',
        text: `Sandbox Réseau is a community of founders, engineers, designers, and operators building in Accra and across Africa. Since its first edition in December 2025, every gathering has taken on one hard question builders face, from distribution and regulation to scaling across borders, through builder demos, short talks, and open networking. ${pastEditions} editions in, the community also runs The Reverb, a fast-paced podcast of real conversations with builders; publishes research such as The State of Accra’s Startup Ecosystem; and hosts The Pitch, a live pitch competition for early-stage founders.`,
    },
];

const dos = [
    'Use the black wordmark on light backgrounds and the white one on dark backgrounds.',
    'Leave clear space around the logo at least the height of its lowercase letters.',
    'Keep the wordmark at least 96px wide on screen (25mm in print).',
    'Use the monogram where space is square or tight: avatars, app icons, favicons.',
];
const donts = [
    'Stretch, squash, rotate, or redraw the logo.',
    'Recolour it outside Ink or Paper, or add shadows, outlines, or gradients.',
    'Place it on busy photos without enough contrast.',
    'Imply an official partnership or endorsement without talking to us first.',
];

const downloadIcon = 'M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13h10';
---

<Layout
    title="Brand kit | Sandbox Réseau"
    description="Logos, colours, typography, photography, and approved copy for press, partners, and anyone featuring Sandbox Réseau."
>
    <main class="brand-page">
        <section class="brand-head" aria-labelledby="brand-title">
            <span class="brand-pill"><span aria-hidden="true"></span>Press &amp; partners</span>
            <h1 id="brand-title">Brand kit.</h1>
            <p>Everything you need to feature, partner with, or write about Sandbox Réseau: logos, colours, type, photography, and words we’re happy to see quoted.</p>
            <div class="brand-head-actions">
                <a class="brand-black" href={KIT_ZIP} download>
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={downloadIcon} /></svg>
                    Download everything <span class="brand-size">ZIP · {kitSize}</span>
                </a>
                <a class="brand-outline" href="#contact">Partner with us</a>
            </div>
        </section>

        <section class="brand-section" aria-labelledby="brand-name-title">
            <div class="brand-section-head">
                <h2 id="brand-name-title">The name.</h2>
                <p>Always <strong>Sandbox Réseau</strong>: two words, a capital S and R, and an accent on the é. If your system can’t type the accent, “Sandbox Reseau” is fine. Please don’t shorten it in public copy.</p>
            </div>
        </section>

        <section class="brand-section" aria-labelledby="brand-logo-title">
            <div class="brand-section-head">
                <h2 id="brand-logo-title">Logo.</h2>
                <p>The wordmark is our primary logo. The monogram is for square spaces like avatars and app icons.</p>
            </div>
            <div class="brand-logo-grid">
                {logos.map((logo) => (
                    <figure class:list={['brand-logo-tile', `is-${logo.tone}`, `is-${logo.kind}`]}>
                        <div class="brand-logo-art">
                            {logo.kind === 'wordmark'
                                ? <Logo aria-hidden="true" />
                                : <img src={`${KIT}/${logo.file}.svg`} alt="" width="96" height="96" />}
                        </div>
                        <figcaption>
                            <span>{logo.label}</span>
                            <span class="brand-chips">
                                <a href={`${KIT}/${logo.file}.svg`} download>SVG</a>
                                <a href={`${KIT}/${logo.file}.png`} download>PNG</a>
                            </span>
                        </figcaption>
                    </figure>
                ))}
            </div>
            <div class="brand-rules">
                <div>
                    <h3><span class="brand-rule-dot is-do" aria-hidden="true"></span>Do</h3>
                    <ul>{dos.map((rule) => <li>{rule}</li>)}</ul>
                </div>
                <div>
                    <h3><span class="brand-rule-dot is-dont" aria-hidden="true"></span>Don’t</h3>
                    <ul>{donts.map((rule) => <li>{rule}</li>)}</ul>
                </div>
            </div>
        </section>

        <section class="brand-section" aria-labelledby="brand-colour-title">
            <div class="brand-section-head">
                <h2 id="brand-colour-title">Colour.</h2>
                <p>Mostly ink on paper, with a single bright accent. Click a swatch to copy its hex code.</p>
            </div>
            <div class="brand-colours">
                {colours.map((colour) => (
                    <button type="button" class="brand-swatch" data-copy={colour.hex} aria-label={`Copy ${colour.name} ${colour.hex}`}>
                        <span class:list={['brand-swatch-chip', colour.dark && 'is-dark']} style={`background:${colour.hex}`}><span class="brand-copied" data-copied>Copied</span></span>
                        <span class="brand-swatch-name">{colour.name}</span>
                        <span class="brand-swatch-hex">{colour.hex}</span>
                        <span class="brand-swatch-use">{colour.use}</span>
                    </button>
                ))}
            </div>
        </section>

        <section class="brand-section" aria-labelledby="brand-type-title">
            <div class="brand-section-head">
                <h2 id="brand-type-title">Typography.</h2>
                <p>Both typefaces are free on Google Fonts.</p>
            </div>
            <div class="brand-type-grid">
                <article class="brand-type is-sans">
                    <span class="brand-type-sample" aria-hidden="true">Aa</span>
                    <h3>Inter</h3>
                    <p>Headlines and body copy. Semibold (600) for headings, Regular (400) for text.</p>
                    <a href="https://fonts.google.com/specimen/Inter" target="_blank" rel="noreferrer">Get Inter ↗</a>
                </article>
                <article class="brand-type is-serif">
                    <span class="brand-type-sample" aria-hidden="true">Aa</span>
                    <h3>Libre Baskerville</h3>
                    <p>Accents only, usually in italic: a name, a pull quote, a single standout line.</p>
                    <a href="https://fonts.google.com/specimen/Libre+Baskerville" target="_blank" rel="noreferrer">Get Libre Baskerville ↗</a>
                </article>
            </div>
        </section>

        <section class="brand-section" aria-labelledby="brand-graphics-title">
            <div class="brand-section-head">
                <h2 id="brand-graphics-title">Graphics.</h2>
                <p>Our hand-drawn doodles sit in the corners of cards and covers. Use them sparingly, one or two per layout.</p>
            </div>
            <div class="brand-graphics">
                <figure class="brand-graphic">
                    <div class="brand-graphic-art"><img src={`${KIT}/graphics/doodle-sweep.svg`} alt="Hand-drawn sweep doodle" loading="lazy" /></div>
                    <figcaption><span>Sweep</span><span class="brand-chips"><a href={`${KIT}/graphics/doodle-sweep.svg`} download>SVG</a></span></figcaption>
                </figure>
                <figure class="brand-graphic">
                    <div class="brand-graphic-art"><img src={`${KIT}/graphics/doodle-spiral.svg`} alt="Hand-drawn spiral doodle" loading="lazy" /></div>
                    <figcaption><span>Spiral</span><span class="brand-chips"><a href={`${KIT}/graphics/doodle-spiral.svg`} download>SVG</a></span></figcaption>
                </figure>
                <figure class="brand-graphic is-wide">
                    <div class="brand-graphic-art is-photo"><img src={`${KIT}/graphics/link-preview-1280x720.jpg`} alt="Sandbox Réseau link preview image" loading="lazy" /></div>
                    <figcaption><span>Link preview · 1280×720</span><span class="brand-chips"><a href={`${KIT}/graphics/link-preview-1280x720.jpg`} download>JPG</a></span></figcaption>
                </figure>
            </div>
        </section>

        <section class="brand-section" aria-labelledby="brand-photo-title">
            <div class="brand-section-head">
                <h2 id="brand-photo-title">Photography.</h2>
                <p>Real people in real rooms. Free to use when you write about us; please credit “Sandbox Réseau”.</p>
            </div>
            <div class="brand-photos">
                {photos.map((src, index) => (
                    <a class="brand-photo" href={src} download aria-label={`Download photo ${index + 1}`}>
                        <img src={src} alt="" loading="lazy" />
                        <span class="brand-photo-dl"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={downloadIcon} /></svg>JPG</span>
                    </a>
                ))}
            </div>
        </section>

        <section class="brand-section" aria-labelledby="brand-copy-title">
            <div class="brand-section-head">
                <h2 id="brand-copy-title">About us, in your words.</h2>
                <p>Approved descriptions for articles, event listings, and partner pages. Use them as-is or trim to fit.</p>
            </div>
            <div class="brand-boilerplate">
                {boilerplate.map((item) => (
                    <article class="brand-copy">
                        <div class="brand-copy-head">
                            <h3>{item.label}</h3>
                            <button type="button" class="brand-copy-btn" data-copy={item.text}><span data-copy-label>Copy</span></button>
                        </div>
                        <p>{item.text}</p>
                    </article>
                ))}
            </div>
        </section>

        <section class="brand-contact cta-doodles" id="contact" aria-labelledby="brand-contact-title">
            <h2 id="brand-contact-title">Want to work together?</h2>
            <p>Sponsoring an edition, co-hosting, featuring us, or need something that isn’t here? Reach out and we’ll get back to you.</p>
            <div class="brand-head-actions">
                <a class="brand-black" href={LINKEDIN} target="_blank" rel="noreferrer">Message us on LinkedIn</a>
                <a class="brand-outline" href={DISCORD} target="_blank" rel="noreferrer">Join the Discord</a>
            </div>
        </section>
    </main>
</Layout>

<script>
    // Delegated once on the document, so it survives view transitions without re-binding.
    document.addEventListener('click', async (event) => {
        const button = (event.target as Element).closest<HTMLElement>('[data-copy]');
        if (!button) return;
        try {
            await navigator.clipboard.writeText(button.dataset.copy || '');
        } catch {
            return;
        }
        const label = button.querySelector<HTMLElement>('[data-copy-label]');
        button.classList.add('is-copied');
        if (label) label.textContent = 'Copied';
        setTimeout(() => {
            button.classList.remove('is-copied');
            if (label) label.textContent = 'Copy';
        }, 1600);
    });
</script>

<style>
    .brand-page{max-width:1040px;margin:0 auto;padding:152px 32px 64px;font-family:Inter,system-ui,sans-serif;color:#0a0a0a}
    .brand-pill{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid rgba(10,10,10,.1);border-radius:999px;color:#6b6b6b;font-size:13px;font-weight:500}
    .brand-pill span{width:7px;height:7px;border-radius:50%;background:#8fbf24}
    .brand-head h1{margin:24px 0 0;font-size:clamp(2.5rem,1.6rem + 3vw,4rem);font-weight:600;line-height:1.02;letter-spacing:-.03em}
    .brand-head>p{max-width:52ch;margin:20px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .brand-head-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}
    .brand-black,.brand-outline{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 24px;border-radius:999px;font-size:16px;font-weight:600;text-decoration:none;transition:background-color .2s,border-color .2s}
    .brand-black{background:#0a0a0a;color:#fff}
    .brand-black:hover{background:rgba(10,10,10,.9)}
    .brand-outline{border:1px solid rgba(10,10,10,.12);color:#0a0a0a}
    .brand-outline:hover{border-color:rgba(10,10,10,.4)}
    .brand-size{margin-left:4px;color:rgba(255,255,255,.55);font-size:13px;font-weight:500}

    .brand-section{margin-top:112px}
    .brand-section-head h2{margin:0;font-size:clamp(1.5rem,1.15rem + 1.5vw,2.25rem);font-weight:600;line-height:1.1;letter-spacing:-.015em}
    .brand-section-head p{max-width:56ch;margin:14px 0 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .brand-section-head strong{color:#0a0a0a;font-weight:600}

    .brand-chips{display:flex;gap:6px}
    .brand-chips a{display:inline-flex;align-items:center;height:28px;padding:0 12px;border:1px solid rgba(10,10,10,.12);border-radius:999px;color:#0a0a0a;font-size:12.5px;font-weight:600;text-decoration:none;transition:border-color .2s,background-color .2s}
    .brand-chips a:hover{border-color:#0a0a0a}

    .brand-logo-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:40px}
    .brand-logo-tile{margin:0;overflow:hidden;border:1px solid rgba(10,10,10,.08);border-radius:28px}
    .brand-logo-art{display:grid;place-items:center;aspect-ratio:16/9;padding:40px}
    .is-light .brand-logo-art{background:#f5f5f5;color:#0a0a0a}
    .is-dark .brand-logo-art{background:#0a0a0a;color:#fff}
    .is-wordmark .brand-logo-art :global(svg){width:min(62%,260px);height:auto}
    .is-monogram .brand-logo-art img{width:96px;height:96px}
    .brand-logo-tile figcaption,.brand-graphic figcaption{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px 14px 20px;background:#fff;color:#6b6b6b;font-size:14px;font-weight:500}

    .brand-rules{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:16px}
    .brand-rules>div{padding:28px;border-radius:28px;background:#f5f5f5}
    .brand-rules h3{display:flex;align-items:center;gap:10px;margin:0;font-size:17px;font-weight:600}
    .brand-rule-dot{width:9px;height:9px;border-radius:50%}
    .brand-rule-dot.is-do{background:#8fbf24}
    .brand-rule-dot.is-dont{background:#e5484d}
    .brand-rules ul{margin:16px 0 0;padding:0;list-style:none}
    .brand-rules li{position:relative;padding-left:18px;color:#4a4a4a;font-size:15px;line-height:1.5}
    .brand-rules li+li{margin-top:10px}
    .brand-rules li::before{content:'';position:absolute;top:.62em;left:2px;width:5px;height:5px;border-radius:50%;background:rgba(10,10,10,.3)}

    .brand-colours{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-top:40px}
    .brand-swatch{display:flex;flex-direction:column;align-items:flex-start;padding:0;border:0;background:none;color:inherit;font:inherit;text-align:left;cursor:pointer}
    .brand-swatch-chip{position:relative;display:grid;place-items:center;width:100%;aspect-ratio:1;border:1px solid rgba(10,10,10,.08);border-radius:20px;transition:transform .2s cubic-bezier(.22,1,.36,1)}
    .brand-swatch:hover .brand-swatch-chip{transform:translateY(-2px)}
    .brand-swatch:focus-visible .brand-swatch-chip{outline:2px solid #0a0a0a;outline-offset:3px}
    .brand-copied{padding:4px 10px;border-radius:999px;background:rgba(10,10,10,.85);color:#fff;font-size:12px;font-weight:600;opacity:0;transition:opacity .2s}
    .is-dark .brand-copied{background:rgba(255,255,255,.9);color:#0a0a0a}
    .brand-swatch.is-copied .brand-copied{opacity:1}
    .brand-swatch-name{margin-top:12px;font-size:15px;font-weight:600}
    .brand-swatch-hex{margin-top:2px;color:#6b6b6b;font-size:13px;font-variant-numeric:tabular-nums;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
    .brand-swatch-use{margin-top:6px;color:#8a8a8a;font-size:12.5px;line-height:1.4}

    .brand-type-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:40px}
    .brand-type{padding:32px;border-radius:28px;background:#f5f5f5}
    .brand-type-sample{display:block;font-size:96px;line-height:1;letter-spacing:-.03em}
    .is-sans .brand-type-sample{font-weight:600}
    .is-serif .brand-type-sample{font:italic 400 96px/1 'Libre Baskerville',Georgia,serif}
    .brand-type h3{margin:28px 0 0;font-size:20px;font-weight:600}
    .is-serif h3{font-family:'Libre Baskerville',Georgia,serif;font-style:italic;font-weight:400}
    .brand-type p{max-width:40ch;margin:8px 0 0;color:#6b6b6b;font-size:15px;line-height:1.5}
    .brand-type a{display:inline-block;margin-top:16px;color:#0a0a0a;font-size:14px;font-weight:600;text-decoration:none;border-bottom:1px solid rgba(10,10,10,.2);padding-bottom:2px}
    .brand-type a:hover{border-color:#0a0a0a}

    .brand-graphics{display:grid;grid-template-columns:1fr 1fr 2fr;gap:16px;margin-top:40px}
    .brand-graphic{margin:0;overflow:hidden;border:1px solid rgba(10,10,10,.08);border-radius:28px}
    .brand-graphic-art{display:grid;place-items:center;height:220px;padding:32px;background:#f5f5f5}
    .brand-graphic-art img{max-width:100%;max-height:100%}
    .brand-graphic-art.is-photo{position:relative;display:block;padding:0}
    .brand-graphic-art.is-photo img{position:absolute;inset:0;width:100%;height:100%;max-width:none;max-height:none;object-fit:cover}

    .brand-photos{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:40px}
    .brand-photo{position:relative;aspect-ratio:2/3;overflow:hidden;border-radius:20px;background:#f5f5f5}
    .brand-photo:nth-child(-n+2){grid-column:span 2;aspect-ratio:3/2}
    .brand-photo img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.22,1,.36,1)}
    .brand-photo:hover img{transform:scale(1.04)}
    .brand-photo-dl{position:absolute;right:12px;bottom:12px;display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:rgba(0,0,0,.45);color:#fff;font-size:12.5px;font-weight:600;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);opacity:.9;transition:background-color .2s}
    .brand-photo:hover .brand-photo-dl{background:rgba(0,0,0,.7)}

    .brand-boilerplate{display:grid;gap:12px;margin-top:40px}
    .brand-copy{padding:24px 28px;border:1px solid rgba(10,10,10,.1);border-radius:24px}
    .brand-copy-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
    .brand-copy h3{margin:0;color:#6b6b6b;font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase}
    .brand-copy p{max-width:72ch;margin:12px 0 0;color:#171816;font-size:16px;line-height:1.6}
    .brand-copy-btn{height:32px;padding:0 14px;border:1px solid rgba(10,10,10,.12);border-radius:999px;background:#fff;color:#0a0a0a;font:inherit;font-size:13px;font-weight:600;cursor:pointer;transition:border-color .2s,background-color .2s,color .2s}
    .brand-copy-btn:hover{border-color:#0a0a0a}
    .brand-copy-btn.is-copied{border-color:#0a0a0a;background:#0a0a0a;color:#fff}

    .brand-contact{margin-top:112px;padding:72px 56px;border-radius:28px;background:#f5f5f5;text-align:center}
    .brand-contact h2{margin:0;font-size:clamp(1.5rem,1.15rem + 1.5vw,2.25rem);font-weight:600;line-height:1.1;letter-spacing:-.015em}
    .brand-contact p{max-width:48ch;margin:14px auto 0;color:#6b6b6b;font-size:17px;line-height:1.5}
    .brand-contact .brand-head-actions{justify-content:center}

    @media(max-width:1023px){
        .brand-colours{grid-template-columns:repeat(3,1fr)}
        .brand-graphics{grid-template-columns:1fr 1fr}
        .brand-graphic.is-wide{grid-column:span 2}
    }
    @media(max-width:639px){
        .brand-page{padding:112px 16px 48px}
        .brand-section,.brand-contact{margin-top:80px}
        .brand-black,.brand-outline{flex:1 1 100%;justify-content:center}
        .brand-logo-grid,.brand-rules,.brand-type-grid{grid-template-columns:1fr}
        .brand-colours{grid-template-columns:repeat(2,1fr)}
        .brand-photos{grid-template-columns:1fr 1fr}
        .brand-type-sample,.is-serif .brand-type-sample{font-size:72px}
        .brand-contact{padding:56px 24px}
    }
</style>
